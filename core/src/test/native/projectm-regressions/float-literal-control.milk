MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fGammaAdj=1
fVideoEchoAlpha=0
fWaveAlpha=0
ob_a=0
ib_a=0
mv_a=0
shapecode_0_enabled=0
shapecode_1_enabled=0
shapecode_2_enabled=0
shapecode_3_enabled=0
wavecode_0_enabled=0
wavecode_1_enabled=0
wavecode_2_enabled=0
wavecode_3_enabled=0
per_frame_1=q1=1;
warp_1=`shader_body {ret=float3((q1*1.00000011920928955078125-1.0)*4194304.0,.375,0);}
comp_1=`shader_body {float3 sample=tex2D(sampler_main,uv).xyz;ret=float3(.25+sample.r*.5,sample.g,0);}
