{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectM TV predictor source feature record v1",
  "description": "Documentation schema for the existing feature JSON envelope; digest and semantic support checks require the reference consumer. Does not describe a render scene graph.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_basis",
    "context",
    "context_sha256",
    "features",
    "uses_rendered_reference",
    "appearance_accuracy_verified",
    "limitations",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_basis": {
      "enum": [
        "strict-source-no-display-frames",
        "source-field-simulation"
      ]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/feature"
      }
    },
    "uses_rendered_reference": {
      "const": false
    },
    "appearance_accuracy_verified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "evidence_kind",
        "status",
        "interval",
        "interval_kind",
        "support",
        "dependencies",
        "unknown_reasons"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/event"
              }
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "unknown"
          ]
        },
        "interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "interval_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "type": "object"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unknown_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "computed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": [
        "input_hashes",
        "provenance",
        "domain",
        "feature_extractor_sha256"
      ],
      "properties": {
        "input_hashes": {
          "type": "object",
          "required": [
            "preset_sha256",
            "parsed_source_sha256",
            "pcm_sha256",
            "audio_sha256",
            "domain_sha256",
            "compatibility_sha256",
            "random_sha256",
            "materials_sha256"
          ],
          "properties": {
            "preset_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parsed_source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pcm_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "audio_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domain_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "compatibility_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "random_sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "materials_sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "required": [
            "engine",
            "engine_archive_sha256",
            "model_sha256",
            "reader_sha256"
          ],
          "properties": {
            "engine": {
              "type": "object",
              "required": [
                "commit",
                "patches_sha256"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "patches_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": true
            },
            "engine_archive_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reader_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "wave_binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        "domain": {
          "type": "object",
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "feature_extractor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "start_time",
        "end_time",
        "dt",
        "signed_mean_luma_delta",
        "brightening",
        "darkening",
        "rgb",
        "coherent_up",
        "coherent_down",
        "motion_crossing_ruled_out"
      ],
      "properties": {
        "start_time": {
          "type": "number"
        },
        "end_time": {
          "type": "number"
        },
        "signed_mean_luma_delta": {
          "type": "number"
        },
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "brightening": {
          "$ref": "#/$defs/region"
        },
        "darkening": {
          "$ref": "#/$defs/region"
        },
        "rgb": {
          "$ref": "#/$defs/region"
        },
        "coherent_up": {
          "type": "boolean"
        },
        "coherent_down": {
          "type": "boolean"
        },
        "motion_crossing_ruled_out": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": [
        "area",
        "mean_amplitude",
        "maximum_amplitude"
      ],
      "properties": {
        "area": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_amplitude": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum_amplitude": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
