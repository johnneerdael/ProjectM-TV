MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1
fGammaAdj=1
fWaveAlpha=0
fVideoEchoAlpha=0
fShader=0
fZoomExponent=1
zoom=1
rot=0
warp=0
cx=0.5
cy=0.5
