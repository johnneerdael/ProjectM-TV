+    } else if(std::strcmp(stage,"geometry")==0) diag::Texture(stage,p.m_framebuffer.GetColorAttachmentTexture(p.m_currentFrameBuffer,0),true);
+    else if(std::strcmp(stage,"state")==0) diag::Texture(stage,p.m_feedbackDetail?p.m_feedbackDetail->Previous():p.m_framebuffer.GetColorAttachmentTexture(p.m_currentFrameBuffer,0));
+}
