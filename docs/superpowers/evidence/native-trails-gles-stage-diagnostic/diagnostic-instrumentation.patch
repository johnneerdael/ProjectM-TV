+class DiagnosticProjectM : public libprojectM::ProjectM {
+public: mutable std::string failure;
+void PresetSwitchFailedEvent(const std::string& file,const std::string& reason) const override { failure=file+": "+reason; }
+};
+int main(int argc,char** argv) {
+    if(argc!=4) return 2;
+    bool standard=std::string(argv[1])=="standard";
+    setenv("PRESET_LAB_SEED","12345",1);
+    auto platform=reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    const EGLint attributes[]={0x3203,0x3489,EGL_NONE}; // ANGLE type Metal
+    EGLDisplay display=platform?platform(0x3202,nullptr,attributes):eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    EGLint major{},minor{};
+    if(!eglInitialize(display,&major,&minor)) {std::cerr<<"eglInitialize: "<<std::hex<<eglGetError();return 3;}
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint configAttrs[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES3_BIT_KHR,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};
+    EGLConfig config{};EGLint count{};eglChooseConfig(display,configAttrs,&config,1,&count);
+    const EGLint surfAttrs[]={EGL_WIDTH,3840,EGL_HEIGHT,2160,EGL_NONE};
+    EGLSurface surface=eglCreatePbufferSurface(display,config,surfAttrs);
+    const EGLint ctxAttrs[]={EGL_CONTEXT_CLIENT_VERSION,3,EGL_NONE};
+    EGLContext context=eglCreateContext(display,config,EGL_NO_CONTEXT,ctxAttrs);
+    if(!eglMakeCurrent(display,surface,surface,context)) {std::cerr<<"eglMakeCurrent: "<<std::hex<<eglGetError();return 4;}
+    std::cerr<<"GL "<<glGetString(GL_VERSION)<<" renderer "<<glGetString(GL_RENDERER)<<"\n";
+    glPixelStorei(GL_PACK_ALIGNMENT,1);
+    GLuint fbo{},tex{};glGenFramebuffers(1,&fbo);glGenTextures(1,&tex);
+    glBindTexture(GL_TEXTURE_2D,tex);glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,3840,2160,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
+    glBindFramebuffer(GL_FRAMEBUFFER,fbo);glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,tex,0);
+    diag::output=argv[3];std::filesystem::create_directories(diag::output);
+    libprojectM::MilkdropPreset::diagnostic_hook=[](void* p,const char* stage){libprojectM::FeedbackDetailTestAccess::Trace(*static_cast<libprojectM::MilkdropPreset::MilkdropPreset*>(p),stage);};
+    libprojectM::MilkdropPreset::diagnostic_shape_hook=[](const void* ptr,size_t size){
+        if(diag::currentFrame<12) diag::Save("shape"+std::to_string(diag::shapeBatch++)+".bin",ptr,size);
+    };
+    {
+        DiagnosticProjectM engine;
+        engine.SetWindowSize(standard?3840:1280,standard?2160:720);
+        engine.SetLineReferenceSize(standard?1280:0,standard?720:0);engine.SetFeedbackDetail(standard?0:-1);
+        engine.SetTargetFramesPerSecond(30);engine.SetMeshSize(48,32);engine.SetPresetLocked(true);engine.SetHardCutEnabled(false);engine.SetEasterEgg(0);
+        engine.LoadPresetFile(argv[2],false);
+        if(!engine.failure.empty()) {std::cerr<<engine.failure;return 5;}
+        std::ifstream audio(std::getenv("DIAG_PCM"),std::ios::binary);std::vector<float> pcm(1470);
+        for(int f=0;f<12;++f) {
+            diag::currentFrame=f;audio.read(reinterpret_cast<char*>(pcm.data()),pcm.size()*sizeof(float));
+            auto audioCount=std::min<size_t>(pcm.size(),libprojectM::Audio::AudioBufferSamples);engine.PCM().Add(pcm.data()+pcm.size()-audioCount,1,audioCount);
+            lab::clock_seconds=f/30.0;engine.RenderFrame(fbo);
+            const auto err=glGetError();if(err!=GL_NO_ERROR) std::cerr<<"GLerror frame "<<f<<": "<<std::hex<<err<<"\n";
+        }
+    }
+    glDeleteFramebuffers(1,&fbo);glDeleteTextures(1,&tex);
+    eglMakeCurrent(display,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(display,context);eglDestroySurface(display,surface);eglTerminate(display);
+}
