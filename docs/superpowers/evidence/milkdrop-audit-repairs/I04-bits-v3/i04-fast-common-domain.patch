+// IEEE representation checks are private to remainder input handling.
+// Supported targets require matching floating/integer byte layout.
+#if PRJM_F_SIZE == 4
+_Static_assert(sizeof(PRJM_EVAL_F) == sizeof(uint32_t) && FLT_RADIX == 2 &&
+               FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128, "requires IEEE binary32");
+typedef uint32_t remainder_bits_t;
+#define REMAINDER_SIGN_BIT UINT32_C(0x80000000)
+#define REMAINDER_INFINITY_BITS UINT32_C(0x7f800000)
+#define REMAINDER_CAST_LIMIT_BITS UINT32_C(0x4f000000) // 2^31
+#define REMAINDER_ORIGINAL_LIMIT_BITS UINT32_C(0x4f000000) // 2^31
+#else
+_Static_assert(sizeof(PRJM_EVAL_F) == sizeof(uint64_t) && FLT_RADIX == 2 &&
+               DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024, "requires IEEE binary64");
+typedef uint64_t remainder_bits_t;
+#define REMAINDER_SIGN_BIT UINT64_C(0x8000000000000000)
+#define REMAINDER_INFINITY_BITS UINT64_C(0x7ff0000000000000)
+#define REMAINDER_CAST_LIMIT_BITS UINT64_C(0x43e0000000000000) // 2^63
+#define REMAINDER_ORIGINAL_LIMIT_BITS UINT64_C(0x41e0000000000000) // 2^31
+#endif
+static remainder_bits_t remainder_value_bits(PRJM_EVAL_F value)
+{
+    remainder_bits_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+// Check finite/cast domains with integer representations before floating casts.
+// Preserve defined wide signed results, and never execute signed minimum/-1.
+static PRJM_EVAL_F bounded_milkdrop_remainder(PRJM_EVAL_F numerator, PRJM_EVAL_F denominator)
+{
+    const remainder_bits_t numeratorBits = remainder_value_bits(numerator);
+    const remainder_bits_t denominatorBits = remainder_value_bits(denominator);
+    const remainder_bits_t numeratorMagnitude = numeratorBits & ~REMAINDER_SIGN_BIT;
+    const remainder_bits_t denominatorMagnitude = denominatorBits & ~REMAINDER_SIGN_BIT;
+    // The original finite 32-bit domain needs no wide-range/minimum checks.
+    // The unsigned OR test is conservative: passing implies both magnitudes
+    // are below 2^31; missed common cases still use the guarded wide path.
+    if ((numeratorMagnitude | denominatorMagnitude) < REMAINDER_ORIGINAL_LIMIT_BITS)
+    {
+        const int32_t dividend32 = (int32_t) numerator;
+        const int32_t divisor32 = (int32_t) denominator;
+        if (divisor32 == 0)
+            return 0.0;
+        const int32_t remainder32 = dividend32 % divisor32;
+        // Strict magnitude admission excludes INT32_MIN and therefore /-1.
+        return (PRJM_EVAL_F) (remainder32 < 0 ? -remainder32 : remainder32);
+    }
+    if (numeratorMagnitude >= REMAINDER_INFINITY_BITS ||
+        denominatorMagnitude >= REMAINDER_INFINITY_BITS)
+        return 0.0;
+    // Positive limit is excluded; the exact negative signed minimum is allowed.
+    if (numeratorMagnitude > REMAINDER_CAST_LIMIT_BITS ||
+        (numeratorMagnitude == REMAINDER_CAST_LIMIT_BITS && !(numeratorBits & REMAINDER_SIGN_BIT)) ||
+        denominatorMagnitude > REMAINDER_CAST_LIMIT_BITS ||
+        (denominatorMagnitude == REMAINDER_CAST_LIMIT_BITS && !(denominatorBits & REMAINDER_SIGN_BIT)))
+        return 0.0;
+    const PRJM_EVAL_I dividend = (PRJM_EVAL_I) numerator;
+    const PRJM_EVAL_I divisor = (PRJM_EVAL_I) denominator;
+#if PRJM_F_SIZE == 4
+    const PRJM_EVAL_I minimum = INT32_MIN;
+#else
+    const PRJM_EVAL_I minimum = INT64_MIN;
+#endif
+    if (divisor == 0 || (dividend == minimum && divisor == -1))
+        return 0.0;
+    const PRJM_EVAL_F remainder = (PRJM_EVAL_F) (dividend % divisor);
+    return numeratorMagnitude < REMAINDER_ORIGINAL_LIMIT_BITS &&
+           denominatorMagnitude < REMAINDER_ORIGINAL_LIMIT_BITS ? fabs(remainder) : remainder;
+}
