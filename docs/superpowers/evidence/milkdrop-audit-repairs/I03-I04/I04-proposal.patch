+// The original x86 fabs/fistp/div path is defined here only below 2^31.
+// Keep defined wider signed results, and never cast invalid floats or divide MIN/-1.
+static PRJM_EVAL_F bounded_milkdrop_remainder(PRJM_EVAL_F numerator, PRJM_EVAL_F denominator)
+{
+#if PRJM_F_SIZE == 4
+    const PRJM_EVAL_F limit = 2147483648.0;
+    const PRJM_EVAL_I minimum = INT32_MIN;
+#else
+    const PRJM_EVAL_F limit = 9223372036854775808.0;
+    const PRJM_EVAL_I minimum = INT64_MIN;
+#endif
+    if (!isfinite(numerator) || !isfinite(denominator) ||
+        numerator < -limit || numerator >= limit ||
+        denominator < -limit || denominator >= limit)
+        return 0.0;
+    const PRJM_EVAL_I dividend = (PRJM_EVAL_I) numerator;
+    const PRJM_EVAL_I divisor = (PRJM_EVAL_I) denominator;
+    if (divisor == 0 || (dividend == minimum && divisor == -1))
+        return 0.0;
+    const PRJM_EVAL_F remainder = (PRJM_EVAL_F) (dividend % divisor);
+    return fabs(numerator) < 2147483648.0 && fabs(denominator) < 2147483648.0
+        ? fabs(remainder) : remainder;
+}
+
