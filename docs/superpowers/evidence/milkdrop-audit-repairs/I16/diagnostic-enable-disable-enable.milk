MILKDROP_PRESET_VERSION=100
[preset00]
fDecay=1
fGammaAdj=1
fVideoEchoAlpha=0
fWaveAlpha=0
ob_size=0
ib_size=0
mv_x=2
mv_y=2
mv_dx=.3
mv_dy=-.3
mv_l=1
mv_a=1
mv_r=0
mv_g=0
mv_b=1
per_frame_1=mv_a=if(equal(frame,2),0,1);dx=if(equal(frame,2),-.1,0);dy=0;zoom=1;zoomexp=1;sx=1;sy=1;rot=0;warp=0;
per_frame_2=mv_r=equal(frame,3);mv_b=1-mv_r;
per_pixel_1=reg00+=1;
