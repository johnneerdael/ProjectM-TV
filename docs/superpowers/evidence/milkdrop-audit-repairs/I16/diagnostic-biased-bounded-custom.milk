MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=0
[preset00]
fDecay=1
fGammaAdj=1
fShader=0
fVideoEchoAlpha=0
fWaveAlpha=0
ob_size=0
ib_size=0
bDarkenCenter=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWarpScale=1
nMotionVectorsX=2
nMotionVectorsY=2
mv_dx=.3
mv_dy=-.3
mv_l=1
mv_a=1
mv_r=0
mv_g=0
mv_b=1
per_frame_init_1=reg00=0;
per_frame_1=dx=-.0625*max(1,min(4,frame));dy=0;zoom=1;zoomexp=1;sx=1;sy=1;rot=0;warp=0;
per_frame_2=mv_a=if(equal(frame,2),0,1);mv_r=equal(frame,3);mv_g=0;mv_b=1-mv_r;
per_pixel_1=reg00+=1;
wavecode_0_enabled=0
shapecode_0_enabled=0
wavecode_1_enabled=0
shapecode_1_enabled=0
wavecode_2_enabled=0
shapecode_2_enabled=0
wavecode_3_enabled=0
shapecode_3_enabled=0
warp_1=`shader_body { ret=GetPixel(uv); }
