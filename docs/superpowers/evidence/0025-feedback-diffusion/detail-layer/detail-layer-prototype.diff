+// PROTOTYPE native detail layer (env PM_DETAIL=alpha). L: authored-canvas feedback state (exactly MilkDrop),
+// H: native state = up(L_w) + alpha * (H_w - up(box(H_w))) + this frame's geometry; L' = L_w + box(H' - H_c).
+struct DetailLayer
+{
+    int W{0}, H{0}, CW{0}, CH{0}, S{0};
+    GLuint lTex[2]{}, lFbo[2]{}, dTex{}, dFbo{}, hcTex{}, hcFbo{}, vao{};
+    GLuint progDown{}, progCombine{}, progInject{};
+    std::shared_ptr<libprojectM::Renderer::Texture> lWrap[2];
+    libprojectM::Renderer::CopyTexture flip;
+    bool valid{false};
+};
+std::unordered_map<const void*, std::unique_ptr<DetailLayer>> detailLayers;
+
+GLuint MakeTexture(int w, int h, GLenum filter)
+{
+    GLuint t; glGenTextures(1, &t); glBindTexture(GL_TEXTURE_2D, t);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    return t;
+}
+GLuint MakeFbo(GLuint tex)
+{
+    GLuint f; glGenFramebuffers(1, &f); glBindFramebuffer(GL_FRAMEBUFFER, f);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    const GLenum b = GL_COLOR_ATTACHMENT0; glDrawBuffers(1, &b);
+    return f;
+}
+GLuint MakeProgram(const char* fragment)
+{
+    static const char* vertex = "#version 330\nvoid main() { vec2 p = vec2(gl_VertexID == 1 ? 3.0 : -1.0, gl_VertexID == 2 ? 3.0 : -1.0); gl_Position = vec4(p, 0.0, 1.0); }\n";
+    auto compile = [](GLenum type, const char* text) {
+#ifdef USE_GLES
+        std::string code = std::string("#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;\n") + (std::strchr(text, '\n') + 1);
+#else
+        std::string code = text;
+#endif
+        const char* src = code.c_str(); GLuint sh = glCreateShader(type); glShaderSource(sh, 1, &src, nullptr); glCompileShader(sh);
+        GLint ok = 0; glGetShaderiv(sh, GL_COMPILE_STATUS, &ok); if (!ok) { char log[2048]; glGetShaderInfoLog(sh, sizeof log, nullptr, log); fprintf(stderr, "detail shader: %s\n", log); } return sh; };
+    GLuint prog = glCreateProgram(); glAttachShader(prog, compile(GL_VERTEX_SHADER, vertex)); glAttachShader(prog, compile(GL_FRAGMENT_SHADER, fragment)); glLinkProgram(prog);
+    return prog;
+}
+const char* DownFragment = R"(#version 330
+uniform sampler2D src; uniform int S; out vec4 o;
+void main() { ivec2 b = ivec2(gl_FragCoord.xy) * S; vec4 acc = vec4(0.0);
+  for (int j = 0; j < S; ++j) for (int i = 0; i < S; ++i) acc += texelFetch(src, b + ivec2(i, j), 0);
+  o = acc / float(S * S); }
+)";
+const char* CombineFragment = R"(#version 330
+uniform sampler2D Lw; uniform sampler2D Hw; uniform sampler2D D; uniform float alpha; uniform vec2 native; out vec4 o;
+vec4 Base(ivec2 p) { return texture(Lw, (vec2(p) + vec2(0.5)) / native); }
+vec4 Band(ivec2 p) { return texelFetch(Hw, p, 0) - texture(D, (vec2(p) + vec2(0.5)) / native); }
+void main() {
+  ivec2 p = ivec2(gl_FragCoord.xy); o = Base(p);
+  if (alpha != 0.0) {
+    int S = int(native.x) / textureSize(Lw, 0).x; ivec2 cell = (p / S) * S;
+    // bilinear_up(box(Hw)) is not a projection: remove the residual's
+    // actual block mean before limiting it. This also removes D's rounding.
+    vec4 mean = vec4(0.0);
+    for (int j = 0; j < S; ++j) for (int i = 0; i < S; ++i)
+      mean += Band(cell + ivec2(i, j));
+    mean /= float(S * S);
+    // One gain per block and channel preserves the centered band's zero
+    // mean. Choose the largest gain <= alpha that fits every pixel's
+    // headroom; independent per-pixel clamps would introduce another bias.
+    vec4 gain = vec4(alpha);
+    for (int j = 0; j < S; ++j) for (int i = 0; i < S; ++i) {
+      ivec2 q = cell + ivec2(i, j); vec4 b = Base(q); vec4 d = Band(q) - mean;
+      vec4 positive = (vec4(1.0) - b) / max(d, vec4(1e-6));
+      vec4 negative = b / max(-d, vec4(1e-6));
+      gain = min(gain, mix(positive, negative, lessThan(d, vec4(0.0))));
+    }
+    o += gain * (Band(p) - mean);
+  }
+}
+)";
+// Geometry enters the authored state as MilkDrop rasterizes it at canvas size: the native pixel at each
+// canvas pixel's centre (a 2-native-px dot always covers exactly one such pixel), not a box average,
+// which would spread a dot over 2-4 canvas pixels at a fraction of its peak.
+const char* InjectFragment = R"(#version 330
+uniform sampler2D Lw; uniform sampler2D Hp; uniform sampler2D Hc; uniform int S; out vec4 o;
+// The native pixels at the canvas pixel's centre: the middle one for an odd scale, the middle 2x2 for an even one.
+vec4 G(ivec2 p) { return texelFetch(Hp, p, 0) - texelFetch(Hc, p, 0); }
+void main() { ivec2 c = ivec2(gl_FragCoord.xy); ivec2 p = c * S + ivec2((S - 1) / 2);
+  vec4 g = (S % 2 == 1) ? G(p) : 0.25 * (G(p) + G(p + ivec2(1, 0)) + G(p + ivec2(0, 1)) + G(p + ivec2(1, 1)));
+  o = texelFetch(Lw, c, 0) + g; }
+)";
+void FullScreen(DetailLayer& d, GLuint prog, GLuint fbo, int w, int h)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo); glViewport(0, 0, w, h); glDisable(GL_BLEND);
+    glUseProgram(prog); glBindVertexArray(d.vao); glDrawArrays(GL_TRIANGLES, 0, 3); glBindVertexArray(0);
+    glUseProgram(0); libprojectM::Renderer::Shader::InvalidateBoundProgram();
+}
+void BindTex(GLuint prog, const char* name, int unit, GLuint tex)
+{
+    glActiveTexture(GL_TEXTURE0 + unit); glBindTexture(GL_TEXTURE_2D, tex); glBindSampler(unit, 0);
+    glUniform1i(glGetUniformLocation(prog, name), unit);
+}
+
+float DetailMean(GLuint tex, int w, int h)
+{
+    static std::vector<unsigned char> px; px.resize(static_cast<size_t>(w) * h * 4);
+    GLuint f; glGenFramebuffers(1, &f); glBindFramebuffer(GL_READ_FRAMEBUFFER, f);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px.data()); glDeleteFramebuffers(1, &f);
+    double sum = 0; for (size_t i = 0; i < px.size(); i += 4) sum += px[i] + px[i + 1] + px[i + 2];
+    return static_cast<float>(sum / (px.size() / 4 * 3 * 255.0));
+}
