--- /dev/null
+++ b/tests/libprojectM/EvaluatorLoneDotTest.cpp
@@ -0,0 +1,38 @@
+#include <projectm-eval.h>
+#include <gtest/gtest.h>
+#include <string>
+
+// MilkDrop's NS-EEL lexer reads a lone '.' as the number 0, e.g. "zoom+.10*sin(rad+.+15.15)".
+class EvaluatorLoneDot : public ::testing::Test {
+protected:
+    void SetUp() override { context = projectm_eval_context_create(nullptr, nullptr); }
+    void TearDown() override { projectm_eval_context_destroy(context); }
+    auto Compiles(const std::string& code) -> bool {
+        auto* handle = projectm_eval_code_compile(context, code.c_str());
+        if (handle == nullptr) return false;
+        projectm_eval_code_execute(handle);
+        projectm_eval_code_destroy(handle);
+        return true;
+    }
+    auto Value(const char* name) -> double { return *projectm_eval_context_register_variable(context, name); }
+    projectm_eval_context* context{};
+};
+
+TEST_F(EvaluatorLoneDot, LoneDotIsZero) {
+    ASSERT_TRUE(Compiles("a=.+15.15; b=if(1,.-.4,2); c=.;"));
+    EXPECT_DOUBLE_EQ(Value("a"), 15.15);
+    EXPECT_DOUBLE_EQ(Value("b"), -0.4);
+    EXPECT_DOUBLE_EQ(Value("c"), 0.0);
+}
+TEST_F(EvaluatorLoneDot, OtherNumbersAreUnchanged) {
+    ASSERT_TRUE(Compiles("a=.5; b=5.; c=1.5e2; d=.25e1;"));
+    EXPECT_DOUBLE_EQ(Value("a"), 0.5);
+    EXPECT_DOUBLE_EQ(Value("b"), 5.0);
+    EXPECT_DOUBLE_EQ(Value("c"), 150.0);
+    EXPECT_DOUBLE_EQ(Value("d"), 2.5);
+}
+TEST_F(EvaluatorLoneDot, InvalidCodeStaysInvalid) {
+    EXPECT_FALSE(Compiles("a=x.;"));
+    EXPECT_FALSE(Compiles("a=. .;"));
+    EXPECT_FALSE(Compiles("a=@;"));
+}
