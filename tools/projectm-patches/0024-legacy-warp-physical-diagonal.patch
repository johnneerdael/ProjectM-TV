From: ProjectM TV maintainers
Subject: [PATCH] Select the original physical diagonal in legacy warp

I11: the original fixed-function projection reverses physical Y relative
 to the current grid. Connect legacy cells across AD instead of BC.
Select offsets once for the actual compiled/default path; preserve custom
warp, failed-custom fallback, triangle winding/quadrant order and replay.
Keep one existing index buffer, identical vertex/index/triangle/draw counts,
and invalidate cached topology if the compiled path changes at fixed size.

Complete the existing static mesh cache key (viewport, aspect, mesh and
compiled path), and record its viewport fields so unchanged geometry is
not rebuilt per frame. Dynamic equations and attribute uploads still run.

diff --git a/src/libprojectM/MilkdropPreset/PerPixelMesh.hpp b/src/libprojectM/MilkdropPreset/PerPixelMesh.hpp
--- a/src/libprojectM/MilkdropPreset/PerPixelMesh.hpp
+++ b/src/libprojectM/MilkdropPreset/PerPixelMesh.hpp
@@ -143,6 +143,8 @@
-
+
     int m_gridSizeX{}; //!< Warp mesh X resolution.
     int m_gridSizeY{}; //!< Warp mesh Y resolution.
+    float m_meshAspectX{}, m_meshAspectY{}; //!< Static radius/angle cache inputs.
+    bool m_legacyIndices{false}; //!< Diagonal selected for the actual compiled warp path.
-
+
     int m_viewportWidth{};  //!< Last known viewport width.
     int m_viewportHeight{}; //!< Last known viewport height.
diff --git a/src/libprojectM/MilkdropPreset/PerPixelMesh.cpp b/src/libprojectM/MilkdropPreset/PerPixelMesh.cpp
--- a/src/libprojectM/MilkdropPreset/PerPixelMesh.cpp
+++ b/src/libprojectM/MilkdropPreset/PerPixelMesh.cpp
@@ -1,4 +1,6 @@
 #include "PerPixelMesh.hpp"
+
+#include <array>
-
+
 #include "MilkdropShader.hpp"
 #include "MilkdropStaticShaders.hpp"
@@ -149,7 +151,10 @@
         m_warpMesh.Indices().Resize(m_gridSizeX * m_gridSizeY * 6);
     }
     else if (m_viewportWidth == presetState.renderContext.viewportSizeX &&
-             m_viewportHeight == presetState.renderContext.viewportSizeY)
+             m_viewportHeight == presetState.renderContext.viewportSizeY &&
+             m_meshAspectX == presetState.renderContext.aspectX &&
+             m_meshAspectY == presetState.renderContext.aspectY &&
+             m_legacyIndices == !m_warpShader)
     {
         // Nothing changed, just go on to the dynamic calculation.
         return;
@@ -157,6 +162,10 @@
-
+
     const float aspectX = presetState.renderContext.aspectX;
     const float aspectY = presetState.renderContext.aspectY;
+    m_viewportWidth = presetState.renderContext.viewportSizeX;
+    m_viewportHeight = presetState.renderContext.viewportSizeY;
+    m_meshAspectX = aspectX;
+    m_meshAspectY = aspectY;
-
+
     // Either viewport size or mesh size changed, reinitialize the vertices.
     auto& vertices = m_warpMesh.Vertices();
@@ -183,6 +192,15 @@
             vertexIndex++;
         }
     }
+
+    // The legacy projection flips physical Y relative to the original mesh.
+    // Select its opposite diagonal once, retaining triangle order and winding.
+    // A failed custom program uses this same legacy path.
+    m_legacyIndices = !m_warpShader;
+    const uint32_t stride = m_gridSizeX + 1;
+    const std::array<uint32_t, 6> offsets = m_legacyIndices
+        ? std::array<uint32_t, 6>{0, 1, stride + 1, 0, stride, stride + 1}
+        : std::array<uint32_t, 6>{0, 1, stride, 1, stride, stride + 1};
-
+
     // Generate triangle lists for drawing the main warp mesh
     int vertexListIndex{0};
@@ -206,15 +224,12 @@
-
+
                 int const vertex = xReference + yReference * (m_gridSizeX + 1);
-
+
-                // 0 - 1      3
-                //   /      /
-                // 2      4 - 5
-                m_warpMesh.Indices()[vertexListIndex++] = vertex;
-                m_warpMesh.Indices()[vertexListIndex++] = vertex + 1;
-                m_warpMesh.Indices()[vertexListIndex++] = vertex + m_gridSizeX + 1;
-                m_warpMesh.Indices()[vertexListIndex++] = vertex + 1;
-                m_warpMesh.Indices()[vertexListIndex++] = vertex + m_gridSizeX + 1;
-                m_warpMesh.Indices()[vertexListIndex++] = vertex + m_gridSizeX + 2;
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[0];
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[1];
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[2];
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[3];
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[4];
+                m_warpMesh.Indices()[vertexListIndex++] = vertex + offsets[5];
             }
         }
     }
