diff --git a/src/libprojectM/MilkdropPreset/PerFrameContext.cpp b/src/libprojectM/MilkdropPreset/PerFrameContext.cpp
index d2e937f..fcfd3bb 100644
--- a/src/libprojectM/MilkdropPreset/PerFrameContext.cpp
+++ b/src/libprojectM/MilkdropPreset/PerFrameContext.cpp
@@ -244,6 +244,40 @@ void PerFrameContext::CompilePerFrameCode(const std::string& perFrameCode)
 
     perFrameCodeHandle = projectm_eval_code_compile(perFrameCodeContext, perFrameCode.c_str());
     if (perFrameCodeHandle == nullptr)
+    {
+        // MilkDrop removes record separators and line comments before compiling EEL.
+        // Retry that legacy form only after rejection, preserving accepted programs.
+        std::string legacyCode;
+        legacyCode.reserve(perFrameCode.size());
+        bool inLineComment{false};
+        for (size_t index = 0; index < perFrameCode.size(); ++index)
+        {
+            const auto character = perFrameCode[index];
+            if (character == '\n')
+            {
+                inLineComment = false;
+                continue;
+            }
+            if (inLineComment)
+            {
+                continue;
+            }
+            if (index + 1 < perFrameCode.size() &&
+                ((character == '/' && perFrameCode[index + 1] == '/') ||
+                 (character == '\\' && perFrameCode[index + 1] == '\\')))
+            {
+                inLineComment = true;
+                ++index;
+                continue;
+            }
+            legacyCode.push_back(character);
+        }
+        if (legacyCode != perFrameCode)
+        {
+            perFrameCodeHandle = projectm_eval_code_compile(perFrameCodeContext, legacyCode.c_str());
+        }
+    }
+    if (perFrameCodeHandle == nullptr)
     {
