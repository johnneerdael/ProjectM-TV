diff --git a/tests/libprojectM/PerFrameRecordCompatibilityTest.cpp b/tests/libprojectM/PerFrameRecordCompatibilityTest.cpp
new file mode 100644
index 0000000..d35e3d2
--- /dev/null
+++ b/tests/libprojectM/PerFrameRecordCompatibilityTest.cpp
@@ -0,0 +1,47 @@
+#include <MilkdropPreset/PerFrameContext.hpp>
+#include <MilkdropPreset/MilkdropPresetExceptions.hpp>
+#include <gtest/gtest.h>
+
+using libprojectM::MilkdropPreset::PerFrameContext;
+using libprojectM::MilkdropPreset::MilkdropCompileException;
+
+TEST(PerFrameRecordCompatibility, JoinsIdentifierSplitAcrossRecords) {
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerFrameCode("is_beat=2;\nk1=is_\nbeat;\nzoom=k1;\n"));
+    context.ExecutePerFrameCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 2.0);
+}
+
+TEST(PerFrameRecordCompatibility, RemovesLineCommentsBeforeJoiningRecords) {
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerFrameCode("is_beat=3;\nk1=is_// split token\nbeat;\nzoom=k1;\n"));
+    context.ExecutePerFrameCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 3.0);
+}
+
+TEST(PerFrameRecordCompatibility, SupportsLegacyBackslashComments) {
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerFrameCode("is_beat=4;\nk1=is_\\\\ split token\nbeat;\nzoom=k1;\n"));
+    context.ExecutePerFrameCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 4.0);
+}
+
+TEST(PerFrameRecordCompatibility, KeepsAcceptedBlockCommentsOnOriginalPath) {
+    // Legacy line-comment stripping would remove the closing block comment here.
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerFrameCode("zoom=1; /* // marker */\nrot=.25;\n"));
+    context.ExecutePerFrameCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 1.0);
+    EXPECT_DOUBLE_EQ(*context.rot, .25);
+}
+
+TEST(PerFrameRecordCompatibility, InvalidExpressionStillReportsFailure) {
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    EXPECT_THROW(context.CompilePerFrameCode("zoom=(;\n"), MilkdropCompileException);
+    EXPECT_EQ(context.perFrameCodeHandle, nullptr);
+}
