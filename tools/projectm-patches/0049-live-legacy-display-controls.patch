 }
 
-void Filters::Draw()
+void Filters::Draw(const PerFrameContext& perFrameContext)
 {
+    // Filters can become active only through equations. Keep allocation separate
+    // from activation, and leave GL state untouched on inactive frames.
+    if (!*perFrameContext.brighten && !*perFrameContext.darken &&
+        !*perFrameContext.solarize && !*perFrameContext.invert)
+    {
+        return;
+    }
     UpdateMesh();
 
     if (m_viewportWidth == 0 || m_viewportHeight == 0)
@@ -36,19 +44,19 @@ void Filters::Draw()
     glBindVertexArray(m_vaoID);
     glVertexAttrib4f(1, 1.0, 1.0, 1.0, 1.0);
 
-    if (m_presetState.brighten)
+    if (*perFrameContext.brighten != 0)
     {
         Brighten();
     }
-    if (m_presetState.darken)
+    if (*perFrameContext.darken != 0)
     {
         Darken();
     }
-    if (m_presetState.solarize)
+    if (*perFrameContext.solarize != 0)
     {
         Solarize();
     }
-    if (m_presetState.invert)
+    if (*perFrameContext.invert != 0)
     {
         Invert();
     }
