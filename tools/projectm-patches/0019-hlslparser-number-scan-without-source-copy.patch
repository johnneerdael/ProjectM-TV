From f5eedc73f95027fea87c1f7ceed6f51a565688b8 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Fri, 25 Sep 2026 08:20:07 +0200
Subject: [PATCH] hlslparser: Don't copy the remaining shader source for every
 token

HLSLTokenizer::ScanNumber() is called for every token and uses
String_ToDouble(), which constructed a std::istringstream from the
whole remaining input and a new std::locale("C") on each call. This
makes HLSL translation quadratic in the shader length and stalls
rendering for a noticeable time when switching to presets with large
shaders, especially on slower devices.

Only pass the characters that can form a number to the stream and use
the classic locale.

(cherry picked from upstream commit a4e86cd82, PR #1030, onto patch 0003, which already
switched this function to std::locale::classic(); the regression test is not included.)
---
 vendor/hlslparser/src/Engine.cpp | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/vendor/hlslparser/src/Engine.cpp b/vendor/hlslparser/src/Engine.cpp
index a0c1113cf..734713559 100644
--- a/vendor/hlslparser/src/Engine.cpp
+++ b/vendor/hlslparser/src/Engine.cpp
@@ -1,5 +1,6 @@
 
 #include "Engine.h"
+#include <cctype>
 
 #include <stdio.h>  // vsnprintf
 #include <string.h> // strcmp, strcasecmp
@@ -66,8 +67,20 @@ bool String_EqualNoCase(const char * a, const char * b) {
 
 static inline double iss_strtod(const char * in, char ** end) {
     char * in_var = const_cast<char *>(in);
+
+    // The tokenizer calls this for every token, so only the characters that can form a number
+    // are passed to the stream.
+    const char * numEnd = in;
+    while (isdigit(*numEnd) || *numEnd == '.' || *numEnd == 'e' || *numEnd == 'E' ||
+           ((*numEnd == '+' || *numEnd == '-') && numEnd > in && (numEnd[-1] == 'e' || numEnd[-1] == 'E')))
+        ++numEnd;
+    if (numEnd == in) {
+        *end = in_var;
+        return 0.0;
+    }
+
     double df;
-    std::istringstream iss(in);
+    std::istringstream iss(std::string(in, numEnd));
     iss.imbue(std::locale::classic());
     iss >> df;
     if(iss.fail()) {
@@ -75,7 +88,7 @@ static inline double iss_strtod(const char * in, char ** end) {
         return 0.0;
     }
     if(iss.eof()) {
-        *end = in_var + strlen(in);
+        *end = in_var + (numEnd - in);
         return df;
     }
 
