diff --git a/src/libprojectM/MilkdropPreset/LineGeometry.cpp b/src/libprojectM/MilkdropPreset/LineGeometry.cpp
new file mode 100644
index 000000000..6ef37e4c8
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LineGeometry.cpp
@@ -0,0 +1,179 @@
+#include "LineGeometry.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+namespace {
+
+constexpr float ThinHalfWidth = 0.5f; //!< MilkDrop's lines are 1 px wide.
+
+// MilkDrop draws a thick line as the thin one four times, offset by (0, 0), (x, 0), (x, y), (0, y):
+// a pixel for the main wave, about half a pixel for custom waves and shape outlines. The quads do the
+// same (LineStyle::passOffsetX/Y), so every pixel is hit exactly as often as with the GL lines. A
+// wider line drawn fewer times cannot match both the lit pixels and the hits per pixel (0.75 px drawn
+// 3 times was 4.5 hits per column instead of 4, which feedback presets amplified to +10-30 %).
+// Checked on feedback-free synthetic presets (circle, straight and 45 degree lines) against the GL lines.
+// (Shape outlines on desktop GL also enable GL_LINE_SMOOTH, which GLES lacks; that is not emulated.)
+constexpr int ThickPasses = 4;
+
+} // namespace
+
+auto LineScale(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> float
+{
+    if (viewportWidth <= 0 || viewportHeight <= 0 || referenceWidth <= 0 || referenceHeight <= 0)
+    {
+        return 0.0f;
+    }
+    // In double, so a render size of the reference's aspect ratio gets exactly the float the height
+    // ratio gives (16:9 frames are unchanged from the height-based scale).
+    const double area = static_cast<double>(viewportWidth) * static_cast<double>(viewportHeight);
+    const double referenceArea = static_cast<double>(referenceWidth) * static_cast<double>(referenceHeight);
+    // Below the reference area lines are drawn as at it, MilkDrop's 1 px lines at full brightness:
+    // thinner lines faded by their width made presets that feed their image back go dark in testing.
+    return std::max(1.0f, static_cast<float>(std::sqrt(area / referenceArea)));
+}
+
+auto SampleDecisionWidth(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int
+{
+    const float scale = LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight);
+    if (scale <= 0.0f)
+    {
+        return viewportWidth;
+    }
+    return static_cast<int>(std::lround(static_cast<float>(viewportWidth) / scale));
+}
+
+auto MaximizeColorsTextureSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int
+{
+    if (LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight) > 1.0f)
+    {
+        return std::max(referenceWidth, referenceHeight);
+    }
+    return std::max(viewportWidth, viewportHeight);
+}
+
+auto BlurSourceFor(int sourceWidth, int sourceHeight, float referenceScale) -> BlurSource
+{
+    if (referenceScale <= 1.0f || sourceWidth <= 0 || sourceHeight <= 0)
+    {
+        return {sourceWidth, sourceHeight, 0.0f};
+    }
+    BlurSource source;
+    source.width = std::max(1, static_cast<int>(std::lround(static_cast<float>(sourceWidth) / referenceScale)));
+    source.height = std::max(1, static_cast<int>(std::lround(static_cast<float>(sourceHeight) / referenceScale)));
+    source.lod = std::log2(static_cast<float>(sourceWidth) / static_cast<float>(source.width));
+    return source;
+}
+
+auto ShaderCanvasSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> CanvasSize
+{
+    const auto source = BlurSourceFor(viewportWidth, viewportHeight,
+                                      LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight));
+    return {source.width, source.height};
+}
+
+auto LineStyleFor(LineKind kind, bool thick, float scale, int viewportWidth, int viewportHeight) -> LineStyle
+{
+    // MilkDrop's thick-line offsets in the strip's own -1...1 coordinates, before vertex_transformation:
+    // 2 / viewport size (a pixel) for the main wave, 1 / viewport size (half a pixel) for custom waves
+    // and shape outlines. The custom waves' vertical offset uses the width too, as in CustomWaveform's
+    // GL-line path.
+    const float incrementX = viewportWidth > 0 ? 1.0f / static_cast<float>(viewportWidth) : 0.0f;
+    const float incrementY = viewportHeight > 0 ? 1.0f / static_cast<float>(viewportHeight) : 0.0f;
+
+    float offsetX = 0.0f;
+    float offsetY = 0.0f;
+    switch (kind)
+    {
+        case LineKind::MainWave:
+            offsetX = 2.0f * incrementX;
+            offsetY = 2.0f * incrementY;
+            break;
+        case LineKind::CustomWave:
+            offsetX = incrementX;
+            offsetY = incrementX;
+            break;
+        case LineKind::ShapeBorder:
+            offsetX = incrementX;
+            offsetY = incrementY;
+            break;
+        case LineKind::MotionVector:
+            thick = false;
+            break;
+    }
+
+    LineStyle style;
+    style.halfWidth = ThinHalfWidth * scale;
+    style.passes = thick ? ThickPasses : 1;
+    // The offsets keep their share of the picture: a pixel or half a pixel at the reference size.
+    style.passOffsetX = thick ? offsetX * scale : 0.0f;
+    style.passOffsetY = thick ? offsetY * scale : 0.0f;
+    return style;
+}
+
+auto PassOffsetFor(const LineStyle& style, int pass) -> PassOffset
+{
+    // MilkDrop's iterations: as is, x += increment, y += increment, x -= increment.
+    const int step = pass % 4;
+    PassOffset offset;
+    offset.x = (step == 1 || step == 2) ? style.passOffsetX : 0.0f;
+    offset.y = (step == 2 || step == 3) ? style.passOffsetY : 0.0f;
+    return offset;
+}
+
+auto DotStyleFor(LineKind kind, bool thick, float scale) -> DotStyle
+{
+    // MilkDrop's main wave always draws its dots as 2x2 pixel blocks, custom waves only when thick.
+    const float base = (kind == LineKind::MainWave || thick) ? 2.0f : 1.0f;
+    const float size = base * scale;
+
+    DotStyle style;
+    // Points rasterise to whole pixels: draw the next whole size and fade by the area difference,
+    // so a dot keeps its share of the picture at every render size.
+    style.size = std::max(1.0f, std::ceil(size - 0.0001f));
+    style.alphaScale = (size * size) / (style.size * style.size);
+    return style;
+}
+
+void LineBatch::Clear()
+{
+    m_points.clear();
+}
+
+auto LineBatch::Append(const ColoredPoint* points, size_t count, bool loop) -> Strip
+{
+    Strip strip;
+    strip.firstPoint = static_cast<int>(m_points.size());
+    if (points == nullptr || count < 2)
+    {
+        return strip;
+    }
+
+    if (loop)
+    {
+        m_points.push_back(points[count - 1]);
+        m_points.insert(m_points.end(), points, points + count);
+        m_points.push_back(points[0]);
+        m_points.push_back(points[1]);
+        strip.segments = static_cast<int>(count);
+    }
+    else
+    {
+        m_points.push_back(points[0]);
+        m_points.insert(m_points.end(), points, points + count);
+        m_points.push_back(points[count - 1]);
+        strip.segments = static_cast<int>(count - 1);
+    }
+    return strip;
+}
+
+auto LineBatch::Points() const -> const std::vector<ColoredPoint>&
+{
+    return m_points;
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/LineGeometry.hpp b/src/libprojectM/MilkdropPreset/LineGeometry.hpp
new file mode 100644
index 000000000..fa854b1e9
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LineGeometry.hpp
@@ -0,0 +1,193 @@
+#pragma once
+
+#include <Renderer/RenderItem.hpp>
+
+#include <cstddef>
+#include <vector>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+/**
+ * @brief The kinds of lines a preset draws. Each emulates MilkDrop's "thick" lines differently.
+ */
+enum class LineKind
+{
+    MainWave,
+    CustomWave,
+    ShapeBorder,
+    MotionVector
+};
+
+/**
+ * @brief Width and pass count of a quad line.
+ */
+struct LineStyle
+{
+    float halfWidth{0.0f}; //!< Half the line width in render pixels.
+    int passes{1};         //!< How often the line is drawn (MilkDrop draws thick lines four times).
+    /**
+     * Offset of passes 1-3 in the strip's own coordinates (the -1...1 space of the points, before
+     * vertex_transformation), where MilkDrop adds its thick-line increments: passes 0-3 are moved by
+     * (0, 0), (passOffsetX, 0), (passOffsetX, passOffsetY), (0, passOffsetY), see PassOffsetFor().
+     * Thick lines use it; 0 otherwise.
+     */
+    float passOffsetX{0.0f};
+    float passOffsetY{0.0f}; //!< See passOffsetX.
+};
+
+/**
+ * @brief Translation of one pass of a line, in the strip's own coordinates.
+ */
+struct PassOffset
+{
+    float x{0.0f};
+    float y{0.0f};
+};
+
+/**
+ * @brief Size of a dot drawn as a GL point.
+ */
+struct DotStyle
+{
+    float size{1.0f};       //!< gl_PointSize: a whole number of render pixels, at least 1.
+    float alphaScale{1.0f}; //!< Alpha factor: wanted dot area divided by drawn area.
+};
+
+/**
+ * @brief Line width factor: the square root of the render area over the reference area, but at least 1.
+ *
+ * A line keeps its share of the picture at any render size and aspect ratio; at the reference's
+ * aspect ratio this is the render height over the reference height. At or below the reference area
+ * lines are drawn as at it (MilkDrop's 1 px lines at full brightness), above it they widen.
+ * @return 0 when quad lines are off (no reference size) or the viewport is empty.
+ */
+auto LineScale(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> float;
+
+/**
+ * @brief Render width for MilkDrop's waveform sample rule: a third of the samples when there are more
+ *        than a third of this width (480 samples: under 1440 px).
+ *
+ * MilkDrop's rule makes the sample count depend on the render size: at its 1024x768 a line waveform
+ * draws 160 dots or segments, at 1080p 480. With a line reference size the lines and dots are sized as
+ * at the reference, so the sample count must follow the reference too, or a large render draws three
+ * times the dots and feedback presets wash out. The rule then uses the reference-equivalent width,
+ * render width / LineScale() (never above the render width).
+ * @return The render width when quad lines are off (no reference size), as in MilkDrop.
+ */
+auto SampleDecisionWidth(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int;
+
+/**
+ * @brief Texture size for MilkDrop's spiro and hash wave fade (Waveform::MaximizeColors()).
+ *
+ * MilkDrop fades the CenteredSpiro, ExplosiveHash and CenteredSpiroVolume modes by its texture size,
+ * max(width, height): a bigger texture spreads the dense wave over more pixels. Quad lines keep the
+ * wave's share of the picture as at the line reference size, so above it the fade is the reference's,
+ * max(referenceWidth, referenceHeight); otherwise (no reference size, or at or below its area) the
+ * render's, as in MilkDrop.
+ */
+auto MaximizeColorsTextureSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int;
+
+/**
+ * @brief Size and mipmap level of the source the blur levels are made from.
+ */
+struct BlurSource
+{
+    int width{0};    //!< Width the blur chain treats its source as having.
+    int height{0};   //!< Height the blur chain treats its source as having.
+    float lod{0.0f}; //!< Mipmap level the first blur pass reads the source at (0: the source itself).
+};
+
+/**
+ * @brief The source the blur levels are made from: the source itself, or above the line reference
+ *        area a source of the reference's area (the source size divided by the line scale), read from
+ *        the source's mipmaps at log2 of the actual ratio.
+ *
+ * MilkDrop's blur levels are fixed fractions of its texture, blurred by a few of their texels, so their
+ * radius is a share of the picture only at one render size. With the reference's size they keep the
+ * share they had at the reference, like the lines.
+ * @param referenceScale LineScale(); 0 or 1 keep the source (MilkDrop).
+ */
+auto BlurSourceFor(int sourceWidth, int sourceHeight, float referenceScale) -> BlurSource;
+
+/**
+ * @brief Canvas size in pixels as told to preset code: texsize, texsize_main, mip_x/y/avg and
+ *        pixelsx/pixelsy.
+ */
+struct CanvasSize
+{
+    int width{0};
+    int height{0};
+};
+
+/**
+ * @brief The canvas size preset shaders and equations see: above the line reference area the
+ *        reference's area at the render's aspect ratio (the render size divided by LineScale(), the
+ *        size BlurSourceFor() makes the blur levels from), otherwise the render size.
+ *
+ * In MilkDrop texsize is the internal canvas, and presets step by texsize.zw texels and turn uv into
+ * pixels with texsize.xy, tuned on a canvas of about the reference size. The textures stay at the
+ * render size and are sampled as before; only the reported size follows the reference, so the steps
+ * and frequencies keep their share of the picture, like the lines.
+ * @return The render size when quad lines are off (no reference size), or at or below the reference
+ *         area, as in MilkDrop.
+ */
+auto ShaderCanvasSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> CanvasSize;
+
+/**
+ * @brief Quad line style matching MilkDrop's thin (1 px) or thick line of this kind, at this scale.
+ * @param viewportWidth Render width in pixels; MilkDrop's thick-line offsets depend on it.
+ * @param viewportHeight Render height in pixels; MilkDrop's thick-line offsets depend on it.
+ */
+auto LineStyleFor(LineKind kind, bool thick, float scale, int viewportWidth, int viewportHeight) -> LineStyle;
+
+/**
+ * @brief The translation of one pass: (0, 0), (x, 0), (x, y), (0, y) for passes 0-3 (repeating), in
+ *        the order of MilkDrop's four thick-line iterations, with x, y = passOffsetX, passOffsetY.
+ */
+auto PassOffsetFor(const LineStyle& style, int pass) -> PassOffset;
+
+/**
+ * @brief Point size matching MilkDrop's dots of this kind, at this scale.
+ */
+auto DotStyleFor(LineKind kind, bool thick, float scale) -> DotStyle;
+
+/**
+ * @brief Collects line strips for one upload, padded for instanced drawing.
+ *
+ * Every segment is one instance that reads four consecutive stored points: the point before the
+ * segment, its two ends, and the point after it. A strip's first and last point are repeated (an
+ * open strip ends flat there), a loop's are wrapped around.
+ */
+class LineBatch
+{
+public:
+    using ColoredPoint = Renderer::RenderItem::ColoredPoint;
+
+    /**
+     * @brief Where a strip's points start in the batch and how many segments it has.
+     */
+    struct Strip
+    {
+        int firstPoint{0}; //!< Index of the strip's leading pad point.
+        int segments{0};   //!< Number of segments (instances); 0 draws nothing.
+    };
+
+    void Clear();
+
+    /**
+     * @brief Adds a strip of points.
+     * @param points The strip's points; may be null if count is 0.
+     * @param count Number of points. Fewer than two draw nothing.
+     * @param loop True to connect the last point back to the first.
+     */
+    auto Append(const ColoredPoint* points, size_t count, bool loop) -> Strip;
+
+    auto Points() const -> const std::vector<ColoredPoint>&;
+
+private:
+    std::vector<ColoredPoint> m_points; //!< All strips, padded, in append order.
+};
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/LineRenderer.cpp b/src/libprojectM/MilkdropPreset/LineRenderer.cpp
new file mode 100644
index 000000000..6a1e4aedd
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LineRenderer.cpp
@@ -0,0 +1,194 @@
+#include "LineRenderer.hpp"
+
+#include "MilkdropStaticShaders.hpp"
+
+#include <glm/gtc/type_ptr.hpp>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+using ColoredPoint = LineBatch::ColoredPoint;
+
+auto LineTieBias() -> glm::vec2
+{
+#ifdef USE_GLES
+    // GL line tie-breaking is implementation-defined; this matches Mali-G52's GL lines. Desktop GL
+    // needs none (its GL lines and the quads already agree).
+    return {0.0f, 1.0f / 64.0f};
+#else
+    return {0.0f, 0.0f};
+#endif
+}
+
+LineRenderer::LineRenderer()
+{
+    auto staticShaders = MilkdropStaticShaders::Get();
+    try
+    {
+        m_shader.CompileProgram(staticShaders->GetLineVertexShader(), staticShaders->GetLineFragmentShader());
+        m_usable = true;
+    }
+    catch (const Renderer::ShaderException&)
+    {
+        // A driver that rejects the program: the preset still loads and draws its lines as GL lines.
+        m_usable = false;
+        return;
+    }
+
+    m_transformationLocation = m_shader.UniformLocation("vertex_transformation");
+    m_viewportSizeLocation = m_shader.UniformLocation("viewport_size");
+    m_antialiasLocation = m_shader.UniformLocation("antialias");
+    m_halfWidthLocation = m_shader.UniformLocation("half_width");
+    m_passOffsetLocation = m_shader.UniformLocation("pass_offset");
+    m_tieBiasLocation = m_shader.UniformLocation("tie_bias");
+}
+
+LineRenderer::~LineRenderer()
+{
+    if (m_vboId != 0)
+    {
+        glDeleteBuffers(1, &m_vboId);
+    }
+    if (m_vaoId != 0)
+    {
+        glDeleteVertexArrays(1, &m_vaoId);
+    }
+}
+
+auto LineRenderer::Usable() const -> bool
+{
+    return m_usable;
+}
+
+void LineRenderer::Upload(const LineBatch& batch)
+{
+    const auto& points = batch.Points();
+    if (!m_usable || points.empty())
+    {
+        return;
+    }
+
+    if (m_vaoId == 0)
+    {
+        glGenVertexArrays(1, &m_vaoId);
+        glGenBuffers(1, &m_vboId);
+        glBindVertexArray(m_vaoId);
+        glBindBuffer(GL_ARRAY_BUFFER, m_vboId);
+        for (GLuint location = 0; location < 6; location++)
+        {
+            glEnableVertexAttribArray(location);
+            glVertexAttribDivisor(location, 1);
+        }
+        glBindVertexArray(0);
+    }
+
+    // Orphan the buffer so the GPU can keep reading the previous upload.
+    glBindBuffer(GL_ARRAY_BUFFER, m_vboId);
+    glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(sizeof(ColoredPoint) * points.size()), points.data(), GL_STREAM_DRAW);
+}
+
+void LineRenderer::Begin(const glm::mat4& transformation, const Renderer::RenderContext& context)
+{
+    m_ready = m_usable && m_vaoId != 0 && context.viewportSizeX > 0 && context.viewportSizeY > 0;
+    if (!m_ready)
+    {
+        return;
+    }
+    m_shader.Bind();
+    glUniformMatrix4fv(m_transformationLocation, 1, GL_FALSE, glm::value_ptr(transformation));
+    glUniform2f(m_viewportSizeLocation, static_cast<float>(context.viewportSizeX), static_cast<float>(context.viewportSizeY));
+    glUniform1f(m_antialiasLocation, context.lineAntialiasing ? 1.0f : 0.0f);
+    const glm::vec2 tieBias = LineTieBias();
+    glUniform2f(m_tieBiasLocation, tieBias.x, tieBias.y);
+
+    m_halfWidthSet = false;
+    m_passOffsetSet = false;
+}
+
+void LineRenderer::SetFloat(GLint location, float value, float& lastValue, bool& lastValid)
+{
+    if (lastValid && lastValue == value)
+    {
+        return;
+    }
+    glUniform1f(location, value);
+    lastValue = value;
+    lastValid = true;
+}
+
+void LineRenderer::Draw(const LineBatch::Strip& strip, const LineStyle& style)
+{
+    if (!m_ready || strip.segments <= 0 || style.passes <= 0)
+    {
+        return;
+    }
+
+    m_shader.Bind();
+    glBindVertexArray(m_vaoId);
+    glBindBuffer(GL_ARRAY_BUFFER, m_vboId);
+
+    // Instance i reads the strip's points i (previous), i + 1 (A), i + 2 (B) and i + 3 (next).
+    const auto stride = static_cast<GLsizei>(sizeof(ColoredPoint));
+    const auto pointer = [&](int point, size_t member) {
+        return reinterpret_cast<const void*>(static_cast<uintptr_t>(strip.firstPoint + point) * sizeof(ColoredPoint) + member);
+    };
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, stride, pointer(0, offsetof(ColoredPoint, x)));
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, stride, pointer(1, offsetof(ColoredPoint, x)));
+    glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride, pointer(2, offsetof(ColoredPoint, x)));
+    glVertexAttribPointer(3, 2, GL_FLOAT, GL_FALSE, stride, pointer(3, offsetof(ColoredPoint, x)));
+    glVertexAttribPointer(4, 4, GL_FLOAT, GL_FALSE, stride, pointer(1, offsetof(ColoredPoint, r)));
+    glVertexAttribPointer(5, 4, GL_FLOAT, GL_FALSE, stride, pointer(2, offsetof(ColoredPoint, r)));
+
+    SetFloat(m_halfWidthLocation, style.halfWidth, m_lastHalfWidth, m_halfWidthSet);
+    for (int pass = 0; pass < style.passes; pass++)
+    {
+        // Every pass states its offset, so nothing leaks into the next style's draws; the value only
+        // reaches GL when it changes (a thin outline after another sets nothing).
+        const auto offset = PassOffsetFor(style, pass);
+        const glm::vec2 passOffset(offset.x, offset.y);
+        if (!m_passOffsetSet || passOffset != m_lastPassOffset)
+        {
+            glUniform2f(m_passOffsetLocation, passOffset.x, passOffset.y);
+            m_lastPassOffset = passOffset;
+            m_passOffsetSet = true;
+        }
+        glDrawArraysInstanced(GL_TRIANGLE_STRIP, 0, 4, strip.segments);
+    }
+}
+
+void LineRenderer::End()
+{
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+    Renderer::Shader::Unbind();
+    m_ready = false;
+}
+
+ScopedProgramPointSize::ScopedProgramPointSize(bool enable)
+{
+#ifndef USE_GLES
+    if (enable && glIsEnabled(GL_PROGRAM_POINT_SIZE) == GL_FALSE)
+    {
+        glEnable(GL_PROGRAM_POINT_SIZE);
+        m_enabled = true;
+    }
+#else
+    static_cast<void>(enable);
+#endif
+}
+
+ScopedProgramPointSize::~ScopedProgramPointSize()
+{
+#ifndef USE_GLES
+    if (m_enabled)
+    {
+        glDisable(GL_PROGRAM_POINT_SIZE);
+    }
+#endif
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
