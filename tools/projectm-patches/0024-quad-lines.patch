+#pragma once
+
+#include "LineGeometry.hpp"
+
+#include <Renderer/RenderContext.hpp>
+#include <Renderer/Shader.hpp>
+
+#include <projectM-opengl.h>
+
+#include <glm/mat4x4.hpp>
+#include <glm/vec2.hpp>
+
+#include <cstddef>
+
+namespace libprojectM {
+namespace MilkdropPreset {
