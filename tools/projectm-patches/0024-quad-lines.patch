+TEST(LineGeometry, PassOffsetsFollowMilkDropsOrder)
+{
+    // (0, 0), (+x, 0), (+x, +y), (0, +y), as MilkDrop's four thick-line iterations.
+    const auto style = LineStyleFor(LineKind::ShapeBorder, true, 1.0f, Width, Height);
