Subject: [PATCH] hlslparser: round-trip finite float32 shader literals

The inherited default stream precision emits only six significant digits, changing
parsed coefficients before GLSL compilation. Use max_digits10 with the existing
classic locale and retain floating spelling for integral values and signed zero.
Reject nonfinite AST literals through the existing generator error path: nan/inf
are not GLSL constants and can accidentally bind authored identifiers. Never
substitute zero. Leave integer/bool emission unchanged and update the array test's
expected finite float spelling. ProjectM TV fix against upstream 4.1.7 plus 0001-0043.

diff --git a/tests/libprojectM/PresetShaderTranslationTest.cpp b/tests/libprojectM/PresetShaderTranslationTest.cpp
index 2aec93a00..630b9108c 100644
--- a/tests/libprojectM/PresetShaderTranslationTest.cpp
+++ b/tests/libprojectM/PresetShaderTranslationTest.cpp
@@ -237,8 +237,8 @@ TEST_F(ArrayInitializerTest, GlobalArrayIsAssignedWholeInMain)
     ASSERT_FALSE(glsl.empty());
     EXPECT_NE(glsl.find("\nvec4 samples[2];"), std::string::npos) << glsl;
     const auto main = glsl.substr(glsl.find("void main() {"));
-    EXPECT_NE(main.find("    samples = vec4[]( vec4(float(0), float(0), 0, (float(11) / float(3))), "
-                        "vec4(float(0), float(1), 0, ((-float(2)) / float(3))) );"),
+    EXPECT_NE(main.find("    samples = vec4[]( vec4(float(0.0), float(0.0), 0, (float(11.0) / float(3.0))), "
+                        "vec4(float(0.0), float(1.0), 0, ((-float(2.0)) / float(3.0))) );"),
               std::string::npos) << glsl;
 }
 
diff --git a/vendor/hlslparser/src/Engine.cpp b/vendor/hlslparser/src/Engine.cpp
index 734713559..1c3b68dd6 100644
--- a/vendor/hlslparser/src/Engine.cpp
+++ b/vendor/hlslparser/src/Engine.cpp
@@ -1,6 +1,8 @@
 
 #include "Engine.h"
 #include <cctype>
+#include <cmath>
+#include <limits>
 
 #include <stdio.h>  // vsnprintf
 #include <string.h> // strcmp, strcasecmp
@@ -44,9 +46,16 @@ int String_Printf(char * buffer, int size, const char * format, ...) {
 int String_FormatFloat(char * buffer, int size, float value) {
     std::ostringstream oss;
     oss.imbue(std::locale::classic()); // the prebuilt "C" locale: std::locale("C") builds one per call
+    // Preserve the parsed float32 value when the shader compiler reparses the text.
+    oss.precision(std::numeric_limits<float>::max_digits10);
     oss << value;
+    std::string literal = oss.str();
+    // Integer conversion loses the sign of -0 and can overflow for large integral floats.
+    if (std::isfinite(value) && literal.find_first_of(".eE") == std::string::npos)
+        literal += ".0";
 
-    return String_Printf(buffer, size, "float(%s)", oss.str().c_str());
+    // Retain nonfinite text for diagnostics; GLSLGenerator rejects it before shader emission.
+    return String_Printf(buffer, size, "float(%s)", literal.c_str());
 }
 
 bool String_Equal(const char * a, const char * b) {
diff --git a/vendor/hlslparser/src/GLSLGenerator.cpp b/vendor/hlslparser/src/GLSLGenerator.cpp
index 6319f45d4..10085c543 100644
--- a/vendor/hlslparser/src/GLSLGenerator.cpp
+++ b/vendor/hlslparser/src/GLSLGenerator.cpp
@@ -19,6 +19,7 @@
 #include <string.h>
 #include <vector>
 #include <algorithm>
+#include <cmath>
 #include <string>
 
 namespace M4
@@ -653,6 +654,11 @@ void GLSLGenerator::OutputExpression(HLSLExpression* expression, const HLSLType*
         {
         case HLSLBaseType_Float:
             {
+                if (!std::isfinite(literalExpression->fValue))
+                {
+                    Error("Nonfinite float literal at line %d", literalExpression->line);
+                    return;
+                }
                 // Don't use printf directly so that we don't use the system locale.
                 char buffer[64];
                 String_FormatFloat(buffer, sizeof(buffer), literalExpression->fValue);
