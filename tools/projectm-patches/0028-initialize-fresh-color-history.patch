Subject: [PATCH] Initialize fresh color history with a context-safe clear

Fresh color storage has undefined contents. Initialize it to the same transparent
black as pooled history before a first warp may sample it. Use a local scratch
framebuffer for each allocation-time clear so a recreated context cannot reuse
a cached framebuffer name that now belongs to another attachment. Preserve the
read/draw bindings, clear color, write mask and scissor state.

Real-driver tests prove initialization with legal nonzero allocation contents,
outer-display clear insufficiency, pooled compatibility and a recreated-context
name collision that previously detached a foreign framebuffer attachment.

--- a/src/libprojectM/Renderer/TextureAttachment.cpp
+++ b/src/libprojectM/Renderer/TextureAttachment.cpp
@@ -122,6 +122,11 @@
         glGenTextures(1, &textureId);
         glBindTexture(GL_TEXTURE_2D, textureId);
         glTexImage2D(GL_TEXTURE_2D, 0, internalFormat, width, height, 0, textureFormat, pixelFormat, nullptr);
+        if (m_attachmentType == AttachmentType::Color)
+        {
+            // Fresh storage is undefined; feedback must start with the same black as pooled storage.
+            ClearPooledTexture(textureId);
+        }
     }
 
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
@@ -140,14 +145,11 @@
 
 void TextureAttachment::ClearPooledTexture(GLuint textureId)
 {
-    // One scratch framebuffer per thread (context) to clear reused textures with.
-    thread_local GLuint clearFramebuffer = 0;
+    // A local framebuffer cannot collide with a cached name from a lost context.
+    GLuint clearFramebuffer = 0;
     GLint previousDrawFramebuffer = 0;
     glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previousDrawFramebuffer);
-    if (clearFramebuffer == 0 || !glIsFramebuffer(clearFramebuffer))
-    {
-        glGenFramebuffers(1, &clearFramebuffer);
-    }
+    glGenFramebuffers(1, &clearFramebuffer);
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, clearFramebuffer);
     glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textureId, 0);
     GLfloat clearColor[4];
@@ -167,6 +169,7 @@
     }
     glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(previousDrawFramebuffer));
+    glDeleteFramebuffers(1, &clearFramebuffer);
 }
 
 } // namespace Renderer
