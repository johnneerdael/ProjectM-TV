 }
 
+// HLSL fills an array from its initializer list component by component, so
+// "float4 a[2] = {1, 2, 3, 4, 5, 6, 7, 8}" holds two float4s. A GLSL array constructor takes one
+// argument per element: group such a list into element constructors, here
+// "vec4[]( vec4(1, 2, 3, 4), vec4(5, 6, 7, 8) )". A list whose component count does not fill the
+// declared size, or whose vector would span two elements, is reported instead of guessed.
+void GLSLGenerator::OutputArrayInitializer(HLSLDeclaration* declaration)
+{
+    HLSLType elementType = declaration->type;
+    elementType.array = false;
+    elementType.arraySize = NULL;
+    const BaseTypeDescription& element = baseTypeDescriptions[elementType.baseType];
+    const bool elementIsScalarOrVector = IsScalarType(elementType) || IsVectorType(elementType);
+
+    int arraySize = -1;
+    if (declaration->type.arraySize != NULL && !m_tree->GetExpressionValue(declaration->type.arraySize, arraySize))
+    {
+        arraySize = -1;
+    }
+
+    // An element per item: "{float2(1, 2), float2(3, 4)}" or the scalars of a scalar array.
+    int numItems = 0;
+    int numComponents = 0;
+    bool onePerElement = true;
+    bool flattenable = elementIsScalarOrVector;
+    for (HLSLExpression* item = declaration->assignment; item != NULL; item = item->nextExpression)
+    {
+        const HLSLType& itemType = item->expressionType;
+        const BaseTypeDescription& itemDescription = baseTypeDescriptions[itemType.baseType];
+        ++numItems;
+        if (itemType.array || itemDescription.numComponents != element.numComponents ||
+            itemDescription.numDimensions != element.numDimensions || itemDescription.height != element.height)
+        {
+            onePerElement = false;
+        }
+        if (itemType.array || !(IsScalarType(itemType) || IsVectorType(itemType)))
+        {
+            flattenable = false;
+        }
+        numComponents += itemDescription.numComponents;
+    }
+
+    if (onePerElement)
+    {
+        if (arraySize >= 0 && numItems != arraySize)
+        {
+            Error("Array '%s' has %d elements but %d initializers", declaration->name, arraySize, numItems);
+            return;
+        }
+        // Converts each item to the element type, e.g. the int literals of a float array, which GLSL ES
+        // array constructors do not convert.
+        m_writer.Write("%s[]( ", GetTypeName(elementType));
+        int index = 0;
+        for (HLSLExpression* item = declaration->assignment; item != NULL; item = item->nextExpression)
+        {
+            m_writer.Write(index++ > 0 ? ", " : "");
+            OutputExpression(item, &elementType);
+        }
+        m_writer.Write(" )");
+        return;
+    }
+
+    if (!flattenable)
+    {
+        Error("Array '%s' initializer list does not match its element type", declaration->name);
+        return;
+    }
+    if (arraySize >= 0 ? numComponents != arraySize * element.numComponents
+                       : numComponents % element.numComponents != 0)
+    {
+        Error("Array '%s' initializer list has %d components for %d elements of %d", declaration->name,
+              numComponents, arraySize, element.numComponents);
+        return;
+    }
+
+    m_writer.Write("%s[]( ", GetTypeName(elementType));
+    HLSLExpression* item = declaration->assignment;
+    for (int index = 0; item != NULL; ++index)
+    {
+        m_writer.Write(index > 0 ? ", %s(" : "%s(", GetTypeName(elementType));
+        int filled = 0;
+        while (filled < element.numComponents)
+        {
+            const int components = baseTypeDescriptions[item->expressionType.baseType].numComponents;
+            if (filled + components > element.numComponents)
+            {
+                Error("Array '%s' initializer has a vector spanning two elements", declaration->name);
+                return;
+            }
+            m_writer.Write(filled > 0 ? ", " : "");
+            OutputExpression(item, NULL);
+            filled += components;
+            item = item->nextExpression;
+        }
+        m_writer.Write(")");
+    }
+    m_writer.Write(" )");
+}
+
 void GLSLGenerator::OutputDeclaration(const HLSLType& type, const char* name)
 {
 	OutputDeclarationType( type );
