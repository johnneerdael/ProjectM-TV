Subject: [PATCH] Group flat array initializer lists into element constructors

HLSL fills an array from its initializer list component by component, so
"const float4 samples[5] = {...20 values...}" holds five float4s. The GLSL
generator copied the list into one array constructor, "vec4[](1, 2, ...)",
which the GLSL compilers reject, so presets using this layout (56 bundled
presets declare such a samples array) fell back to the default shader.

Lists whose items are not one per element are now grouped into element
constructors, "vec4[]( vec4(1, 2, 3, 4), ... )", including vectors mixed
with scalars. A list whose component count does not fill the declared size,
or with a vector spanning two elements, is reported as a translation error
instead of being guessed. One-per-element lists are converted to the
element type, so "float a[3] = {1, 2, 3}" no longer passes int literals to
a float array constructor, which GLSL ES rejects. Global array initializers,
assigned at the start of main(), now assign the whole array ("g = ...")
instead of writing past its end ("g[2] = ...").

---
diff --git a/tests/libprojectM/PresetShaderTranslationTest.cpp b/tests/libprojectM/PresetShaderTranslationTest.cpp
index 9b57cdaff..f6ac584bd 100644
--- a/tests/libprojectM/PresetShaderTranslationTest.cpp
+++ b/tests/libprojectM/PresetShaderTranslationTest.cpp
@@ -175,6 +175,85 @@ TEST_F(UniformReplacementTest, ShaderWithoutUniformWritesIsUnchanged)
     EXPECT_EQ(glsl.find("new_"), std::string::npos) << glsl;
 }
 
+// HLSL fills an array from its initializer list component by component; GLSL takes one constructor
+// argument per array element.
+class ArrayInitializerTest : public testing::Test
+{
+protected:
+    M4::Allocator allocator;
+    M4::HLSLTree tree{&allocator};
+    M4::HLSLParser parser{&allocator, &tree};
+
+    // The GLSL for a shader with these globals and entry point body, or "" if translation fails.
+    std::string Generate(const char* globals, const char* body)
+    {
+        std::string source = globals;
+        source += "\nvoid PS(out float4 r : COLOR0)\n{\n";
+        source += body;
+        source += "\n}\n";
+        if (!parser.Parse("arrays.hlsl", source.c_str(), source.size()))
+            return {};
+        M4::GLSLGenerator generator;
+        if (!generator.Generate(&tree, M4::GLSLGenerator::Target_FragmentShader,
+                                M4::GLSLGenerator::Version_300_ES, "PS"))
+            return {};
+        return generator.GetResult();
+    }
+};
+
+TEST_F(ArrayInitializerTest, FlatScalarsAreGroupedIntoVectors)
+{
+    const auto glsl = Generate("", "float2 a[2] = {1, 2, 3, 4}; r = a[1].xyxy;");
+    EXPECT_NE(glsl.find("vec2 a[2] = vec2[]( vec2(1, 2), vec2(3, 4) );"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, GroupedVectorsKeepTheirLayout)
+{
+    const auto glsl = Generate("", "float2 a[2] = {float2(1, 2), float2(3, 4)}; r = a[1].xyxy;");
+    EXPECT_NE(glsl.find("vec2 a[2] = vec2[]( vec2(1, 2), vec2(3, 4) );"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, VectorsAndScalarsFillElementsInOrder)
+{
+    const auto glsl = Generate("", "float4 a[2] = {float2(1, 2), 3, 4, float3(5, 6, 7), 8}; r = a[1];");
+    EXPECT_NE(glsl.find("vec4[]( vec4(vec2(1, 2), 3, 4), vec4(vec3(5, 6, 7), 8) )"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ScalarArrayConvertsIntegerLiterals)
+{
+    // GLSL ES array constructors do not convert int arguments to float.
+    const auto glsl = Generate("", "float a[3] = {1, 2, 3}; r = a[2];");
+    EXPECT_NE(glsl.find("float[]( float (1), float (2), float (3) )"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, GlobalArrayIsAssignedWholeInMain)
+{
+    // The layout of "const float4 samples[5] = {...20 values...}" in 56 bundled presets.
+    const auto glsl = Generate("const float4 samples[2] = {\n"
+                               "    0.0, 0.0, 0, 11.0/3.0,\n"
+                               "    0.0, 1.0, 0, -2.0/3.0\n"
+                               "};",
+                               "r = samples[1];");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("\nvec4 samples[2];"), std::string::npos) << glsl;
+    const auto main = glsl.substr(glsl.find("void main() {"));
+    EXPECT_NE(main.find("    samples = vec4[]( vec4(float(0), float(0), 0, (float(11) / float(3))), "
+                        "vec4(float(0), float(1), 0, ((-float(2)) / float(3))) );"),
+              std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ListsThatDoNotFillTheArrayAreRejected)
+{
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, 4, 5}; r = a[1];"), "");
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, 4, 5, 6, 7, 8, 9}; r = a[1];"), "");
+    EXPECT_EQ(Generate("", "float2 a[3] = {float2(1, 2), float2(3, 4)}; r = a[1].xyxy;"), "");
+}
+
+TEST_F(ArrayInitializerTest, VectorSpanningTwoElementsIsRejected)
+{
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, float2(4, 5), 6, 7, 8}; r = a[1];"), "");
+}
+
 class FailureRecordingProjectM : public libprojectM::ProjectM
 {
 public:
@@ -320,4 +399,20 @@ TEST_F(PresetShaderRenderTest, CompoundAssignmentToAUniformStartsFromItsValue)
     EXPECT_NEAR(RenderRed("shader_body { q19 *= 1.5; ret = q19; }"), 191, 2);
 }
 
+TEST_F(PresetShaderRenderTest, FlatGlobalArrayInitializerKeepsTheAuthoredShader)
+{
+    EXPECT_NEAR(RenderRed("const float4 samples[2] = {\n"
+                          "    0, 0, 0, 0,\n"
+                          "    0.25, 0.5, 0.75, 1\n"
+                          "};\n"
+                          "shader_body { ret = samples[1].xyz; }"),
+                64, 2);
+}
+
+TEST_F(PresetShaderRenderTest, FlatLocalArrayInitializerKeepsTheAuthoredShader)
+{
+    EXPECT_NEAR(RenderRed("shader_body { float2 a[2] = {1, 0.5, 0.25, 0}; ret = a[1].x; }"), 64, 2);
+}
+
+
 } // namespace
