+TEST(FeedbackDiffusion, OnePassWritesExactFlippedCopyAndFilteredCopy)
+{
+    CGLPixelFormatAttribute attrs[] = {kCGLPFAOpenGLProfile,
+        static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+        static_cast<CGLPixelFormatAttribute>(0)};
+    CGLPixelFormatObj format{};
+    GLint count{};
+    ASSERT_EQ(CGLChoosePixelFormat(attrs, &format, &count), kCGLNoError);
+    CGLContextObj context{};
+    ASSERT_EQ(CGLCreateContext(format, nullptr, &context), kCGLNoError);
+    CGLDestroyPixelFormat(format);
+    ASSERT_EQ(CGLSetCurrentContext(context), kCGLNoError);
+    ASSERT_TRUE(libprojectM::Renderer::Platform::GLResolver::Instance().Initialize(nullptr, nullptr))
+        << "could not initialize the GL resolver for the current context";
+    ASSERT_TRUE(libprojectM::Renderer::Platform::GladLoader::Instance().Initialize())
+        << "could not load OpenGL entry points for the available context";
+    {
+        using libprojectM::Renderer::Texture;
+        constexpr int width = 24;
+        constexpr int height = 10;
+        Texture::SetPoolLimit(0);
+        auto source = std::make_shared<Texture>("pattern", GL_TEXTURE_2D, width, height, 0, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, false);
+        std::vector<unsigned char> input(width * height * 4);
+        for (size_t i = 0; i < input.size(); ++i)
+        {
+            // Distinct, high-frequency texels; alpha opaque like the preset canvases.
+            input[i] = i % 4 == 3 ? 255 : static_cast<unsigned char>((i * 97 + i / 7 * 31) % 256);
+        }
+        source->Bind(0);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, input.data());
+        glViewport(0, 0, width, height);
+        glDisable(GL_DITHER);
+
+        for (float scale : {2.0f, 4.0f})
+        {
+            SCOPED_TRACE(scale);
+            libprojectM::MilkdropPreset::FeedbackDiffusion diffusion;
+            diffusion.SetScale(scale);
+            ASSERT_TRUE(diffusion.Active());
+            for (bool flip : {false, true})
+            {
+                SCOPED_TRACE(flip);
+                diffusion.Draw(source, flip);
+                ASSERT_EQ(glGetError(), GL_NO_ERROR);
+                const auto raw = ReadTexture(*diffusion.RawTexture());
+                size_t different{};
+                for (int y = 0; y < height; ++y)
+                {
+                    const int sourceRow = flip ? height - 1 - y : y;
+                    for (int x = 0; x < width * 4; ++x)
+                    {
+                        different += raw[static_cast<size_t>(y * width * 4 + x)] !=
+                                     input[static_cast<size_t>(sourceRow * width * 4 + x)];
+                    }
+                }
+                EXPECT_EQ(different, 0u) << "raw output is not an exact copy";
+                EXPECT_NE(ReadTexture(*diffusion.Texture()), raw) << "filtered output must differ for this pattern";
+            }
+            // A filtered-only pass (no point-sampled reads need the exact copy) writes the same
+            // filtered image and leaves the exact copy as it was.
+            diffusion.Draw(source, true);
+            const auto raw = ReadTexture(*diffusion.RawTexture());
+            const auto filtered = ReadTexture(*diffusion.Texture());
+            auto flippedSource = std::make_shared<Texture>("pattern-flip", GL_TEXTURE_2D, width, height, 0, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, false);
+            std::vector<unsigned char> zeros(input.size(), 0);
+            flippedSource->Bind(0);
+            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, zeros.data());
+            diffusion.Draw(flippedSource, true, false);
+            EXPECT_EQ(ReadTexture(*diffusion.RawTexture()), raw) << "filtered-only pass wrote the exact copy";
+            EXPECT_NE(ReadTexture(*diffusion.Texture()), filtered) << "filtered-only pass did not write the filtered copy";
+            diffusion.Draw(source, true, false);
+            EXPECT_EQ(ReadTexture(*diffusion.Texture()), filtered);
+        }
+    }
+    CGLSetCurrentContext(nullptr);
+    CGLDestroyContext(context);
+}
