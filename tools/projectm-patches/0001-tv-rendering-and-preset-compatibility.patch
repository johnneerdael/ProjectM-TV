diff --git a/src/libprojectM/MilkdropPreset/GeometryTargets.hpp b/src/libprojectM/MilkdropPreset/GeometryTargets.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..28f2178dc9119cd7353adc5f9ff97fe7cfc2511b
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/GeometryTargets.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "PresetState.hpp"
+#include <Renderer/Framebuffer.hpp>
+
+namespace libprojectM { namespace MilkdropPreset {
+// Two destinations share one evaluated geometry stream. The authored target owns
+// recurrence; native rasterization contributes only to presentation/detail.
+class GeometryTargets {
+public:
+    GeometryTargets(PresetState& state, Renderer::Framebuffer& canvas, int canvasIndex,
+                    int width, int height, const std::shared_ptr<Renderer::Texture>& authoredMain,
+                    Renderer::Framebuffer& native, int nativeIndex)
+        : m_state(state), m_context(state.renderContext), m_main(state.mainTexture),
+          m_canvas(canvas), m_canvasIndex(canvasIndex), m_width(width), m_height(height),
+          m_authoredMain(authoredMain), m_native(native), m_nativeIndex(nativeIndex) {}
+    void Authored() const {
+        m_state.renderContext=m_context;
+        m_state.renderContext.viewportSizeX=m_width;
+        m_state.renderContext.viewportSizeY=m_height;
+        m_state.renderContext.lineReferenceWidth=0;
+        m_state.renderContext.lineReferenceHeight=0;
+        m_state.mainTexture=m_authoredMain;
+        m_canvas.Bind(m_canvasIndex);
+        glViewport(0,0,m_width,m_height);
+    }
+    void Native() const {
+        m_state.renderContext=m_context;
+        m_state.mainTexture=m_main;
+        m_native.Bind(m_nativeIndex);
+        glViewport(0,0,m_context.viewportSizeX,m_context.viewportSizeY);
+    }
+private:
+    PresetState& m_state;
+    Renderer::RenderContext m_context;
+    std::weak_ptr<Renderer::Texture> m_main;
+    Renderer::Framebuffer& m_canvas;
+    int m_canvasIndex, m_width, m_height;
+    std::shared_ptr<Renderer::Texture> m_authoredMain;
+    Renderer::Framebuffer& m_native;
+    int m_nativeIndex;
+};
+} }
diff --git a/src/libprojectM/MilkdropPreset/LegacyEquationCode.cpp b/src/libprojectM/MilkdropPreset/LegacyEquationCode.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..61cd684c4bab3e13088a2ff7ad600962e2d0ef34
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LegacyEquationCode.cpp
@@ -0,0 +1,154 @@
+#include "LegacyEquationCode.hpp"
+
+#include <cctype>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+namespace {
+
+auto IsRecordSeparator(char character) -> bool
+{
+    return character == '\n' || character == '\r';
+}
+
+auto StartsLineComment(const std::string& code, size_t index) -> bool
+{
+    return index + 1 < code.size() &&
+           ((code[index] == '/' && code[index + 1] == '/') ||
+            (code[index] == '\\' && code[index + 1] == '\\'));
+}
+
+auto StartsBlockComment(const std::string& code, size_t index) -> bool
+{
+    return index + 1 < code.size() && code[index] == '/' && code[index + 1] == '*';
+}
+
+// Index just past the block comment starting at index (or the end of the code if it is not closed).
+auto SkipBlockComment(const std::string& code, size_t index) -> size_t
+{
+    const auto end = code.find("*/", index + 2);
+    return end == std::string::npos ? code.size() : end + 2;
+}
+
+// CState::StripLinefeedCharsAndComments: drop record separators and // or \\ line comments.
+auto StripRecordSeparatorsAndComments(const std::string& code) -> std::string
+{
+    std::string stripped;
+    stripped.reserve(code.size());
+    bool inLineComment{false};
+    for (size_t index = 0; index < code.size(); ++index)
+    {
+        const auto character = code[index];
+        if (IsRecordSeparator(character))
+        {
+            inLineComment = false;
+            continue;
+        }
+        if (inLineComment)
+        {
+            continue;
+        }
+        if (StartsLineComment(code, index))
+        {
+            inLineComment = true;
+            ++index;
+            continue;
+        }
+        stripped.push_back(character);
+    }
+    return stripped;
+}
+
+// NS-EEL preprocessCode: inside parentheses, a ';' not followed by an operand is a space.
+auto ReplaceStraySemicolonsInParentheses(const std::string& code) -> std::string
+{
+    std::string result;
+    result.reserve(code.size());
+    int depth{0};
+    for (size_t index = 0; index < code.size(); ++index)
+    {
+        if (StartsBlockComment(code, index))
+        {
+            const auto end = SkipBlockComment(code, index);
+            result.append(code, index, end - index);
+            index = end - 1;
+            continue;
+        }
+
+        const auto character = code[index];
+        if (character == '(')
+        {
+            ++depth;
+        }
+        else if (character == ')')
+        {
+            depth = depth > 0 ? depth - 1 : 0;
+        }
+        else if (character == ';' && depth > 0)
+        {
+            auto next = index + 1;
+            while (next < code.size())
+            {
+                if (StartsBlockComment(code, next))
+                {
+                    next = SkipBlockComment(code, next);
+                }
+                else if (std::isspace(static_cast<unsigned char>(code[next])))
+                {
+                    ++next;
+                }
+                else
+                {
+                    break;
+                }
+            }
+            const auto nextCharacter = next < code.size() ? code[next] : '\0';
+            const bool operandFollows = std::isalnum(static_cast<unsigned char>(nextCharacter)) ||
+                                        nextCharacter == '(' || nextCharacter == '_' ||
+                                        nextCharacter == '!' || nextCharacter == '$';
+            result.push_back(operandFollows ? ';' : ' ');
+            continue;
+        }
+        result.push_back(character);
+    }
+    return result;
+}
+
+} // namespace
+
+auto AssembleLegacyEquationCode(const std::string& code) -> std::string
+{
+    return ReplaceStraySemicolonsInParentheses(StripRecordSeparatorsAndComments(code));
+}
+
+auto CompileEquationCode(projectm_eval_context* context, const std::string& code, std::string& error) -> projectm_eval_code*
+{
+    error.clear();
+    auto* handle = projectm_eval_code_compile(context, code.c_str());
+    if (handle != nullptr)
+    {
+        return handle;
+    }
+
+    // Report the original code's error: its line is the number of the record that failed.
+    int line{};
+    int column{};
+    const auto* message = projectm_eval_get_error(context, &line, &column);
+    error = std::string(message != nullptr ? message : "unknown error") +
+            " (line " + std::to_string(line) + ", column " + std::to_string(column) + ")";
+
+    const auto legacyCode = AssembleLegacyEquationCode(code);
+    if (legacyCode != code)
+    {
+        handle = projectm_eval_code_compile(context, legacyCode.c_str());
+        if (handle != nullptr)
+        {
+            error.clear();
+        }
+    }
+    return handle;
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/LegacyEquationCode.hpp b/src/libprojectM/MilkdropPreset/LegacyEquationCode.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..f17d63446a675b15592742fe8a89729e2db8ad3f
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LegacyEquationCode.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <projectm-eval.h>
+
+#include <string>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+/**
+ * @brief Returns preset equation code in the form MilkDrop compiles.
+ *
+ * MilkDrop's CState::StripLinefeedCharsAndComments removes the separators between numbered records and
+ * line comments starting with // or a double backslash, so an identifier or number split across records
+ * is joined. NS-EEL's preprocessCode then turns a ';' inside parentheses into a space unless an operand
+ * (a letter, digit, '(', '_', '!' or '$') follows it. Returns the code unchanged if neither applies.
+ * @param code Equation records joined by line feeds, as returned by PresetFileParser::GetCode().
+ * @return The legacy form of the code.
+ */
+auto AssembleLegacyEquationCode(const std::string& code) -> std::string;
+
+/**
+ * @brief Compiles preset equation code, retrying its legacy MilkDrop form if the evaluator rejects it.
+ *
+ * Code the evaluator accepts is compiled as it is. Only rejected code is assembled again with
+ * AssembleLegacyEquationCode() and compiled once more.
+ * @param context The evaluator context to compile the code in.
+ * @param code Equation records joined by line feeds.
+ * @param error Receives the evaluator's message for the original code with its line (the record number)
+ *              and column if both attempts fail.
+ * @return The compiled code, or nullptr if neither form compiles.
+ */
+auto CompileEquationCode(projectm_eval_context* context, const std::string& code, std::string& error) -> projectm_eval_code*;
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/LineGeometry.cpp b/src/libprojectM/MilkdropPreset/LineGeometry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6ef37e4c80dbb4ad831a175dcc0e4961838bc759
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/LineGeometry.cpp
@@ -0,0 +1,179 @@
+#include "LineGeometry.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+namespace {
+
+constexpr float ThinHalfWidth = 0.5f; //!< MilkDrop's lines are 1 px wide.
+
+// MilkDrop draws a thick line as the thin one four times, offset by (0, 0), (x, 0), (x, y), (0, y):
+// a pixel for the main wave, about half a pixel for custom waves and shape outlines. The quads do the
+// same (LineStyle::passOffsetX/Y), so every pixel is hit exactly as often as with the GL lines. A
+// wider line drawn fewer times cannot match both the lit pixels and the hits per pixel (0.75 px drawn
+// 3 times was 4.5 hits per column instead of 4, which feedback presets amplified to +10-30 %).
+// Checked on feedback-free synthetic presets (circle, straight and 45 degree lines) against the GL lines.
+// (Shape outlines on desktop GL also enable GL_LINE_SMOOTH, which GLES lacks; that is not emulated.)
+constexpr int ThickPasses = 4;
+
+} // namespace
+
+auto LineScale(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> float
+{
+    if (viewportWidth <= 0 || viewportHeight <= 0 || referenceWidth <= 0 || referenceHeight <= 0)
+    {
+        return 0.0f;
+    }
+    // In double, so a render size of the reference's aspect ratio gets exactly the float the height
+    // ratio gives (16:9 frames are unchanged from the height-based scale).
+    const double area = static_cast<double>(viewportWidth) * static_cast<double>(viewportHeight);
+    const double referenceArea = static_cast<double>(referenceWidth) * static_cast<double>(referenceHeight);
+    // Below the reference area lines are drawn as at it, MilkDrop's 1 px lines at full brightness:
+    // thinner lines faded by their width made presets that feed their image back go dark in testing.
+    return std::max(1.0f, static_cast<float>(std::sqrt(area / referenceArea)));
+}
+
+auto SampleDecisionWidth(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int
+{
+    const float scale = LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight);
+    if (scale <= 0.0f)
+    {
+        return viewportWidth;
+    }
+    return static_cast<int>(std::lround(static_cast<float>(viewportWidth) / scale));
+}
+
+auto MaximizeColorsTextureSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> int
+{
+    if (LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight) > 1.0f)
+    {
+        return std::max(referenceWidth, referenceHeight);
+    }
+    return std::max(viewportWidth, viewportHeight);
+}
+
+auto BlurSourceFor(int sourceWidth, int sourceHeight, float referenceScale) -> BlurSource
+{
+    if (referenceScale <= 1.0f || sourceWidth <= 0 || sourceHeight <= 0)
+    {
+        return {sourceWidth, sourceHeight, 0.0f};
+    }
+    BlurSource source;
+    source.width = std::max(1, static_cast<int>(std::lround(static_cast<float>(sourceWidth) / referenceScale)));
+    source.height = std::max(1, static_cast<int>(std::lround(static_cast<float>(sourceHeight) / referenceScale)));
+    source.lod = std::log2(static_cast<float>(sourceWidth) / static_cast<float>(source.width));
+    return source;
+}
+
+auto ShaderCanvasSize(int viewportWidth, int viewportHeight, int referenceWidth, int referenceHeight) -> CanvasSize
+{
+    const auto source = BlurSourceFor(viewportWidth, viewportHeight,
+                                      LineScale(viewportWidth, viewportHeight, referenceWidth, referenceHeight));
+    return {source.width, source.height};
+}
+
+auto LineStyleFor(LineKind kind, bool thick, float scale, int viewportWidth, int viewportHeight) -> LineStyle
+{
+    // MilkDrop's thick-line offsets in the strip's own -1...1 coordinates, before vertex_transformation:
+    // 2 / viewport size (a pixel) for the main wave, 1 / viewport size (half a pixel) for custom waves
+    // and shape outlines. The custom waves' vertical offset uses the width too, as in CustomWaveform's
+    // GL-line path.
+    const float incrementX = viewportWidth > 0 ? 1.0f / static_cast<float>(viewportWidth) : 0.0f;
+    const float incrementY = viewportHeight > 0 ? 1.0f / static_cast<float>(viewportHeight) : 0.0f;
+
+    float offsetX = 0.0f;
+    float offsetY = 0.0f;
+    switch (kind)
+    {
+        case LineKind::MainWave:
+            offsetX = 2.0f * incrementX;
+            offsetY = 2.0f * incrementY;
+            break;
+        case LineKind::CustomWave:
+            offsetX = incrementX;
+            offsetY = incrementX;
+            break;
+        case LineKind::ShapeBorder:
+            offsetX = incrementX;
+            offsetY = incrementY;
+            break;
+        case LineKind::MotionVector:
+            thick = false;
+            break;
+    }
+
+    LineStyle style;
+    style.halfWidth = ThinHalfWidth * scale;
+    style.passes = thick ? ThickPasses : 1;
+    // The offsets keep their share of the picture: a pixel or half a pixel at the reference size.
+    style.passOffsetX = thick ? offsetX * scale : 0.0f;
+    style.passOffsetY = thick ? offsetY * scale : 0.0f;
+    return style;
+}
+
+auto PassOffsetFor(const LineStyle& style, int pass) -> PassOffset
+{
+    // MilkDrop's iterations: as is, x += increment, y += increment, x -= increment.
+    const int step = pass % 4;
+    PassOffset offset;
+    offset.x = (step == 1 || step == 2) ? style.passOffsetX : 0.0f;
+    offset.y = (step == 2 || step == 3) ? style.passOffsetY : 0.0f;
+    return offset;
+}
+
+auto DotStyleFor(LineKind kind, bool thick, float scale) -> DotStyle
+{
+    // MilkDrop's main wave always draws its dots as 2x2 pixel blocks, custom waves only when thick.
+    const float base = (kind == LineKind::MainWave || thick) ? 2.0f : 1.0f;
+    const float size = base * scale;
+
+    DotStyle style;
+    // Points rasterise to whole pixels: draw the next whole size and fade by the area difference,
+    // so a dot keeps its share of the picture at every render size.
+    style.size = std::max(1.0f, std::ceil(size - 0.0001f));
+    style.alphaScale = (size * size) / (style.size * style.size);
+    return style;
+}
+
+void LineBatch::Clear()
+{
+    m_points.clear();
+}
+
+auto LineBatch::Append(const ColoredPoint* points, size_t count, bool loop) -> Strip
+{
+    Strip strip;
+    strip.firstPoint = static_cast<int>(m_points.size());
+    if (points == nullptr || count < 2)
+    {
+        return strip;
+    }
+
+    if (loop)
+    {
+        m_points.push_back(points[count - 1]);
+        m_points.insert(m_points.end(), points, points + count);
+        m_points.push_back(points[0]);
+        m_points.push_back(points[1]);
+        strip.segments = static_cast<int>(count);
+    }
+    else
+    {
+        m_points.push_back(points[0]);
+        m_points.insert(m_points.end(), points, points + count);
+        m_points.push_back(points[count - 1]);
+        strip.segments = static_cast<int>(count - 1);
+    }
+    return strip;
+}
+
+auto LineBatch::Points() const -> const std::vector<ColoredPoint>&
+{
+    return m_points;
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
