diff --git a/tests/libprojectM/TextureHistoryTest.cpp b/tests/libprojectM/TextureHistoryTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1f6484a660091541d6399bc85c2cdd0958503d54
--- /dev/null
+++ b/tests/libprojectM/TextureHistoryTest.cpp
@@ -0,0 +1,277 @@
+#include <Renderer/Platform/GLResolver.hpp>
+#include <Renderer/Platform/GladLoader.hpp>
+#include <projectM-4/projectM.h>
+#include <Renderer/Texture.hpp>
+#include <Renderer/OpenGL.h>
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <array>
+#include <vector>
+
+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+namespace {
+
+GLuint lastClearFramebuffer{};
+
+void ObserveClearFramebuffer(GLsizei count, GLuint* names)
+{
+    glGenFramebuffers(count, names);
+    if (count > 0) lastClearFramebuffer = names[count - 1];
+}
+
+// nullptr allocation has undefined contents. Supply a permitted nonzero starting value
+// deterministically so the production initializer cannot pass by relying on allocator zeroes.
+void AllocatePoisonedStorage(GLenum target, GLint level, GLint internalFormat, GLsizei width,
+                             GLsizei height, GLint border, GLenum format, GLenum type, const void* pixels)
+{
+    if (!pixels && format == GL_RGBA && type == GL_UNSIGNED_BYTE)
+    {
+        std::vector<unsigned char> poison(static_cast<size_t>(width) * height * 4, 0x7b);
+        glTexImage2D(target, level, internalFormat, width, height, border, format, type, poison.data());
+    }
+    else
+    {
+        glTexImage2D(target, level, internalFormat, width, height, border, format, type, pixels);
+    }
+}
+
+} // namespace
+
+// Exercise the production renderer initializer on a real driver. Only the dependency's
+// unspecified initial bytes are controlled; all framebuffer clears and reads are real GL calls.
+#define TextureAttachment TextureAttachmentUnderTest
+#undef glTexImage2D
+#define glTexImage2D AllocatePoisonedStorage
+#undef glGenFramebuffers
+#define glGenFramebuffers ObserveClearFramebuffer
+#include "Renderer/TextureAttachment.cpp"
+#undef glGenFramebuffers
+#define glGenFramebuffers glad_glGenFramebuffers
+#undef glTexImage2D
+#define glTexImage2D glad_glTexImage2D
+#undef TextureAttachment
+
+using Attachment = libprojectM::Renderer::TextureAttachmentUnderTest;
+using Texture = libprojectM::Renderer::Texture;
+
+class TextureHistoryTest : public ::testing::Test
+{
+protected:
+    void SetUp() override
+    {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attributes[] = {kCGLPFAOpenGLProfile,
+            static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+            static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj format{};
+        GLint count{};
+        if (CGLChoosePixelFormat(attributes, &format, &count) != kCGLNoError || !format)
+        {
+            GTEST_SKIP() << "no CGL OpenGL context";
+        }
+        CGLCreateContext(format, nullptr, &m_context);
+        CGLDestroyPixelFormat(format);
+        if (!m_context) GTEST_SKIP() << "no CGL OpenGL context";
+        ASSERT_EQ(CGLSetCurrentContext(m_context), kCGLNoError);
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GLResolver::Instance().Initialize(nullptr, nullptr))
+            << "could not initialize the GL resolver for the current context";
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GladLoader::Instance().Initialize())
+            << "could not load OpenGL entry points for the available context";
+        m_glReady = true;
+        Texture::SetPoolLimit(0);
+        glGenFramebuffers(1, &m_read);
+        glGenFramebuffers(1, &m_draw);
+#else
+        GTEST_SKIP() << "needs CGL context for this isolated renderer diagnostic";
+#endif
+    }
+
+    void TearDown() override
+    {
+#ifdef __APPLE__
+        if (m_context)
+        {
+            if (m_glReady)
+            {
+                Texture::SetPoolLimit(0);
+                glDeleteFramebuffers(1, &m_read);
+                glDeleteFramebuffers(1, &m_draw);
+            }
+            CGLSetCurrentContext(nullptr);
+            CGLDestroyContext(m_context);
+        }
+#endif
+    }
+
+    auto Read(const Attachment& attachment) -> std::vector<unsigned char>
+    {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, m_read);
+        glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                               attachment.Texture()->TextureID(), 0);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        std::vector<unsigned char> pixels(16 * 16 * 4);
+        glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(glGetError(), GL_NO_ERROR);
+        return pixels;
+    }
+
+#ifdef __APPLE__
+    CGLContextObj m_context{};
+#endif
+    bool m_glReady{false};
+    GLuint m_read{}, m_draw{};
+};
+
+TEST_F(TextureHistoryTest, FreshColorHistoryIsTransparentBlackBeforeFirstRender)
+{
+    Attachment history(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    const auto pixels = Read(history);
+    EXPECT_EQ(std::count_if(pixels.begin(), pixels.end(), [](unsigned char v) { return v != 0; }), 0)
+        << "fresh history still contains the permitted allocator poison";
+}
+
+TEST_F(TextureHistoryTest, FreshClearPreservesFramebufferAndRasterState)
+{
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, m_read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_draw);
+    glClearColor(.2f, .3f, .4f, .5f);
+    glColorMask(GL_FALSE, GL_TRUE, GL_FALSE, GL_TRUE);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(2, 3, 1, 1);
+    Attachment history(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    GLint read{}, draw{};
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    EXPECT_EQ(read, static_cast<GLint>(m_read));
+    EXPECT_EQ(draw, static_cast<GLint>(m_draw));
+    std::array<GLfloat, 4> clear{};
+    std::array<GLboolean, 4> mask{};
+    std::array<GLint, 4> scissor{};
+    glGetFloatv(GL_COLOR_CLEAR_VALUE, clear.data());
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask.data());
+    glGetIntegerv(GL_SCISSOR_BOX, scissor.data());
+    EXPECT_EQ(clear, (std::array<GLfloat, 4>{.2f, .3f, .4f, .5f}));
+    EXPECT_EQ(mask, (std::array<GLboolean, 4>{GL_FALSE, GL_TRUE, GL_FALSE, GL_TRUE}));
+    EXPECT_EQ(scissor, (std::array<GLint, 4>{2, 3, 1, 1}));
+    EXPECT_EQ(glIsEnabled(GL_SCISSOR_TEST), GL_TRUE);
+    const auto pixels = Read(history);
+    EXPECT_EQ(std::count_if(pixels.begin(), pixels.end(), [](unsigned char v) { return v != 0; }), 0)
+        << "scissor/mask must not prevent initialization of the full color history";
+}
+
+TEST_F(TextureHistoryTest, ClearingDisplayDoesNotReplaceInternalHistoryInitialization)
+{
+    GLuint display{};
+    glGenTextures(1, &display);
+    glBindTexture(GL_TEXTURE_2D, display);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 16, 16, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_draw);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, display, 0);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    // Same ordering as the core harness: clear the display, then initialize preset history.
+    Attachment history(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    const auto pixels = Read(history);
+    EXPECT_EQ(std::count_if(pixels.begin(), pixels.end(), [](unsigned char v) { return v != 0; }), 0);
+    glDeleteTextures(1, &display);
+}
+
+TEST_F(TextureHistoryTest, PooledHistoryRetainsExistingTransparentBlackContract)
+{
+    Texture::SetPoolLimit(4096);
+    {
+        Attachment previous(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+        const std::vector<unsigned char> paint(16 * 16 * 4, 0x45);
+        glBindTexture(GL_TEXTURE_2D, previous.Texture()->TextureID());
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, paint.data());
+    }
+    ASSERT_EQ(Texture::PoolBytes(), 1024u);
+    Attachment history(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    EXPECT_EQ(Texture::PoolBytes(), 0u);
+    const auto pixels = Read(history);
+    EXPECT_EQ(std::count_if(pixels.begin(), pixels.end(), [](unsigned char v) { return v != 0; }), 0);
+}
+
+TEST_F(TextureHistoryTest, RecreatedContextDoesNotClearForeignFramebufferWithReusedName)
+{
+#ifdef __APPLE__
+    // Force the clear helper to allocate its framebuffer in the first context, including on RED.
+    Texture::SetPoolLimit(4096);
+    {
+        Attachment previous(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    }
+    {
+        Attachment pooled(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    }
+    const GLuint oldClearName = lastClearFramebuffer;
+    ASSERT_NE(oldClearName, 0u);
+    Texture::SetPoolLimit(0);
+    glDeleteFramebuffers(1, &m_read);
+    glDeleteFramebuffers(1, &m_draw);
+    m_read = m_draw = 0;
+    CGLSetCurrentContext(nullptr);
+    CGLDestroyContext(m_context);
+    m_context = nullptr;
+
+    CGLPixelFormatAttribute attributes[] = {kCGLPFAOpenGLProfile,
+        static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+        static_cast<CGLPixelFormatAttribute>(0)};
+    CGLPixelFormatObj format{};
+    GLint formats{};
+    ASSERT_EQ(CGLChoosePixelFormat(attributes, &format, &formats), kCGLNoError);
+    ASSERT_EQ(CGLCreateContext(format, nullptr, &m_context), kCGLNoError);
+    CGLDestroyPixelFormat(format);
+    ASSERT_EQ(CGLSetCurrentContext(m_context), kCGLNoError);
+    ASSERT_TRUE(libprojectM::Renderer::Platform::GLResolver::Instance().Initialize(nullptr, nullptr))
+        << "could not initialize the GL resolver for the current context";
+    ASSERT_TRUE(libprojectM::Renderer::Platform::GladLoader::Instance().Initialize())
+        << "could not load OpenGL entry points for the available context";
+
+    // GL names are local to a context. Make the formerly cached integer a foreign live FBO.
+    std::vector<GLuint> foreignNames;
+    GLuint foreign{};
+    for (int i = 0; i < 1024 && foreign != oldClearName; ++i)
+    {
+        glGenFramebuffers(1, &foreign);
+        foreignNames.push_back(foreign);
+        glBindFramebuffer(GL_FRAMEBUFFER, foreign);
+    }
+    ASSERT_EQ(foreign, oldClearName) << "could not recreate the targeted GL name collision";
+    GLuint sentinel{};
+    glGenTextures(1, &sentinel);
+    glBindTexture(GL_TEXTURE_2D, sentinel);
+    const std::vector<unsigned char> paint(16 * 16 * 4, 0x45);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 16, 16, 0, GL_RGBA, GL_UNSIGNED_BYTE, paint.data());
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sentinel, 0);
+    ASSERT_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+
+    // Force both the fresh and pooled clear paths while the foreign FBO is bound for read/draw.
+    Texture::SetPoolLimit(4096);
+    {
+        Attachment fresh(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    }
+    {
+        Attachment pooled(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, 16, 16);
+    }
+    GLint attachment{}, read{}, draw{};
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    EXPECT_EQ(read, static_cast<GLint>(foreign));
+    EXPECT_EQ(draw, static_cast<GLint>(foreign));
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                          GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &attachment);
+    EXPECT_EQ(attachment, static_cast<GLint>(sentinel)) << "clear helper detached a foreign attachment";
+    // Reattach only to inspect preserved storage even when RED broke the framebuffer attachment.
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sentinel, 0);
+    std::vector<unsigned char> pixels(16 * 16 * 4);
+    glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+    EXPECT_EQ(pixels, paint) << "clear helper modified foreign framebuffer content";
+    EXPECT_EQ(glGetError(), GL_NO_ERROR);
+    Texture::SetPoolLimit(0);
+    glDeleteTextures(1, &sentinel);
+    glDeleteFramebuffers(static_cast<GLsizei>(foreignNames.size()), foreignNames.data());
+#endif
+}
diff --git a/tests/libprojectM/TexturePoolTest.cpp b/tests/libprojectM/TexturePoolTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8886bd2a028aa49158d9f20181535cce2aecc193
--- /dev/null
+++ b/tests/libprojectM/TexturePoolTest.cpp
@@ -0,0 +1,163 @@
+#include <Renderer/Platform/GLResolver.hpp>
+#include <Renderer/Platform/GladLoader.hpp>
+#include <Renderer/Texture.hpp>
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+
+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+using libprojectM::Renderer::Texture;
+
+TEST(TextureStorageBytes, LevelZeroWithoutMipmaps)
+{
+    EXPECT_EQ(Texture::StorageBytes(4, 4, GL_RGBA8, false), 64u);
+    EXPECT_EQ(Texture::StorageBytes(4, 4, GL_RGBA16F, false), 128u);
+    EXPECT_EQ(Texture::StorageBytes(1920, 1080, GL_RGBA8, false), 1920u * 1080u * 4u);
+}
+
+TEST(TextureStorageBytes, MipChainDownToOnePixel)
+{
+    EXPECT_EQ(Texture::StorageBytes(4, 4, GL_RGBA8, true), (16u + 4u + 1u) * 4u);
+    EXPECT_EQ(Texture::StorageBytes(5, 3, GL_RGBA8, true), (15u + 2u + 1u) * 4u); // 5x3, 2x1, 1x1
+    EXPECT_EQ(Texture::StorageBytes(1, 1, GL_RGBA8, true), 4u);
+
+    size_t levels{};
+    for (int width = 3840, height = 2160;; width = std::max(1, width / 2), height = std::max(1, height / 2))
+    {
+        levels += static_cast<size_t>(width) * static_cast<size_t>(height) * 4u;
+        if (width == 1 && height == 1)
+        {
+            break;
+        }
+    }
+    EXPECT_EQ(Texture::StorageBytes(3840, 2160, GL_RGBA8, true), levels);
+}
+
+// The pool deletes evicted textures, so these tests need a GL context: an offscreen CGL context on macOS.
+class TexturePoolTest : public ::testing::Test
+{
+protected:
+    void SetUp() override
+    {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attributes[] = {kCGLPFAOpenGLProfile,
+                                                static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+                                                static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj pixelFormat{};
+        GLint formats{};
+        if (CGLChoosePixelFormat(attributes, &pixelFormat, &formats) != kCGLNoError || pixelFormat == nullptr)
+        {
+            GTEST_SKIP() << "no OpenGL context";
+        }
+        CGLCreateContext(pixelFormat, nullptr, &m_context);
+        CGLDestroyPixelFormat(pixelFormat);
+        if (m_context == nullptr)
+        {
+            GTEST_SKIP() << "no OpenGL context";
+        }
+        ASSERT_EQ(CGLSetCurrentContext(m_context), kCGLNoError);
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GLResolver::Instance().Initialize(nullptr, nullptr))
+            << "could not initialize the GL resolver for the current context";
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GladLoader::Instance().Initialize())
+            << "could not load OpenGL entry points for the available context";
+        m_glReady = true;
+#else
+        GTEST_SKIP() << "needs an OpenGL context (macOS CGL)";
+#endif
+    }
+
+    void TearDown() override
+    {
+#ifdef __APPLE__
+        if (m_context != nullptr)
+        {
+            if (m_glReady)
+            {
+                Texture::SetPoolLimit(0);
+            }
+            CGLSetCurrentContext(nullptr);
+            CGLDestroyContext(m_context);
+        }
+#endif
+    }
+
+    // A framebuffer-attachment texture, released into the pool (or deleted) when it goes out of scope.
+    static void Release(GLuint id, int width, int height, bool mipmaps, bool generate)
+    {
+        Texture texture("", id, GL_TEXTURE_2D, width, height, false);
+        texture.SetPoolable(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, mipmaps);
+        if (generate)
+        {
+            texture.GenerateMipmaps();
+        }
+    }
+
+    static auto NewTexture(int width, int height) -> GLuint
+    {
+        GLuint id{};
+        glGenTextures(1, &id);
+        glBindTexture(GL_TEXTURE_2D, id);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glBindTexture(GL_TEXTURE_2D, 0);
+        return id;
+    }
+
+    static auto Take(int width, int height, bool& mipmaps) -> GLuint
+    {
+        return Texture::TakePooled(width, height, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, mipmaps);
+    }
+
+#ifdef __APPLE__
+    CGLContextObj m_context{};
+#endif
+    bool m_glReady{false};
+};
+
+TEST_F(TexturePoolTest, CountsGeneratedMipLevels)
+{
+    const size_t plain = Texture::StorageBytes(64, 32, GL_RGBA8, false);
+    const size_t mipmapped = Texture::StorageBytes(64, 32, GL_RGBA8, true);
+    Texture::SetPoolLimit(1 << 20);
+
+    Release(NewTexture(64, 32), 64, 32, false, false);
+    EXPECT_EQ(Texture::PoolBytes(), plain);
+    Release(NewTexture(64, 32), 64, 32, false, true);
+    EXPECT_EQ(Texture::PoolBytes(), plain + mipmapped);
+
+    // Taken in pool order; a taken texture reports its mip levels, and keeps counting them when it comes back.
+    bool mipmaps{true};
+    GLuint first = Take(64, 32, mipmaps);
+    EXPECT_NE(first, 0u);
+    EXPECT_FALSE(mipmaps);
+    EXPECT_EQ(Texture::PoolBytes(), mipmapped);
+    GLuint second = Take(64, 32, mipmaps);
+    EXPECT_NE(second, 0u);
+    EXPECT_TRUE(mipmaps);
+    EXPECT_EQ(Texture::PoolBytes(), 0u);
+
+    Release(second, 64, 32, mipmaps, false);
+    EXPECT_EQ(Texture::PoolBytes(), mipmapped);
+    glDeleteTextures(1, &first);
+}
+
+TEST_F(TexturePoolTest, LimitIncludesMipLevels)
+{
+    const size_t plain = Texture::StorageBytes(64, 32, GL_RGBA8, false);
+    const size_t mipmapped = Texture::StorageBytes(64, 32, GL_RGBA8, true);
+
+    // Too large for the limit with its mip levels: deleted, not pooled.
+    Texture::SetPoolLimit(mipmapped - 1);
+    Release(NewTexture(64, 32), 64, 32, false, true);
+    EXPECT_EQ(Texture::PoolBytes(), 0u);
+
+    // Room for one mipmapped texture: adding it evicts the older plain one.
+    Texture::SetPoolLimit(mipmapped);
+    Release(NewTexture(64, 32), 64, 32, false, false);
+    EXPECT_EQ(Texture::PoolBytes(), plain);
+    Release(NewTexture(64, 32), 64, 32, false, true);
+    EXPECT_EQ(Texture::PoolBytes(), mipmapped);
+}
