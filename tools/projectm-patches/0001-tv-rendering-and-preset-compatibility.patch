@@ -0,0 +1,26 @@
+precision mediump float;
+
+in vec4 fragment_color;
+in highp float edge_distance;
+
+uniform highp float half_width;
+uniform highp float antialias; // 1: one-pixel anti-aliased edge; 0: hard edge like MilkDrop's GL lines
+
+out vec4 color;
+
+void main()
+{
+    float coverage;
+    if (antialias > 0.5)
