+        for(auto& shape : Active(engine).m_customShapes) {
+            for(auto* array : {&shape->m_untexturedArray, &shape->m_texturedArray}) {
+                array->Bind();
+                for(GLuint location=0;location<3;++location) glVertexAttribDivisor(location,1);
+            }
+        }
