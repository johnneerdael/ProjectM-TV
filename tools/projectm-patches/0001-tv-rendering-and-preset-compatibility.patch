+        FAIL() << "invalid code compiled";
+    } catch (const MilkdropCompileException& error) {
+        const std::string message = error.what();
+        EXPECT_EQ(message.rfind("Could not compile per-pixel code: ", 0), 0u) << message;
+        EXPECT_NE(message.find("(line 2, column"), std::string::npos) << message;
+    }
+}
+
+// Loads through the production path: the preset compiles every phase, including disabled waves and shapes.
+class EquationPhaseLoad : public ::testing::Test {
+protected:
+    class Engine : public libprojectM::ProjectM {
+    public:
+        mutable std::string failure;
+        mutable int failures{};
+        void PresetSwitchFailedEvent(const std::string&, const std::string& reason) const override {
+            failure = reason; ++failures;
+        }
+    };
+    static void SetUpTestSuite() {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attrs[] = {kCGLPFAOpenGLProfile,
+            static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core), static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj format{}; GLint count{};
+        if (CGLChoosePixelFormat(attrs, &format, &count) != kCGLNoError || !format) return;
+        CGLCreateContext(format, nullptr, &context); CGLDestroyPixelFormat(format);
+#endif
+    }
+    static void TearDownTestSuite() {
+#ifdef __APPLE__
+        if (context) { CGLSetCurrentContext(nullptr); CGLDestroyContext(context); context = nullptr; }
+#endif
+    }
+    void SetUp() override {
+#ifdef __APPLE__
+        if (!context) GTEST_SKIP() << "no macOS CGL OpenGL context";
+        ASSERT_EQ(CGLSetCurrentContext(context), kCGLNoError);
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GLResolver::Instance().Initialize(nullptr, nullptr))
+            << "could not initialize the GL resolver for the current context";
+        ASSERT_TRUE(libprojectM::Renderer::Platform::GladLoader::Instance().Initialize())
+            << "could not load OpenGL entry points for the available context";
+#else
+        GTEST_SKIP() << "preset load test needs a macOS CGL OpenGL context";
+#endif
+    }
+    auto Load(const std::string& records) -> std::string {
+        Engine engine;
+        engine.SetWindowSize(128, 96);
+        std::istringstream data("[preset00]\nfDecay=0.98\n" + records);
+        engine.LoadPresetData(data, false);
+        return engine.failures == 0 ? "" : engine.failure;
+    }
+#ifdef __APPLE__
+    static CGLContextObj context;
+#endif
+};
+#ifdef __APPLE__
+CGLContextObj EquationPhaseLoad::context{};
+#endif
+
+TEST_F(EquationPhaseLoad, SplitRecordsLoadInEveryPhase) {
+    EXPECT_EQ(Load("per_frame_init_1=q1=is_\nper_frame_init_2=beat;\n"), "");
+    EXPECT_EQ(Load("per_frame_1=zoom=is_\nper_frame_2=beat*0+1;\n"), "");
+    EXPECT_EQ(Load("per_pixel_1=zoom=zo\nper_pixel_2=om*1.01;\n"), "");
+    EXPECT_EQ(Load("wavecode_0_enabled=1\nwave_0_init1=t1=1\nwave_0_init2=.5;\n"), "");
+    EXPECT_EQ(Load("wavecode_0_enabled=1\nwave_0_per_frame1=r=t\nwave_0_per_frame2=1;\n"), "");
+    EXPECT_EQ(Load("wavecode_0_enabled=1\nwave_0_per_point1=x=sam\nwave_0_per_point2=ple;\n"), "");
+    EXPECT_EQ(Load("shapecode_0_enabled=1\nshape_0_init1=t1=2\nshape_0_init2=.5;\n"), "");
+    EXPECT_EQ(Load("shapecode_0_enabled=1\nshape_0_per_frame1=rad=0\nshape_0_per_frame2=.3;\n"), "");
+}
+TEST_F(EquationPhaseLoad, DisabledComponentsAreCompiledToo) {
+    EXPECT_EQ(Load("wavecode_1_enabled=0\nwave_1_per_frame1=r=t\nwave_1_per_frame2=1;\n"), "");
+    EXPECT_EQ(Load("shapecode_1_enabled=0\nshape_1_per_frame1=rad=0\nshape_1_per_frame2=.3;\n"), "");
+}
