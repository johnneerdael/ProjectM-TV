diff --git a/src/libprojectM/MilkdropPreset/FeedbackDetail.cpp b/src/libprojectM/MilkdropPreset/FeedbackDetail.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f7d001d5800f0db48bf6f93e432b71a0f0ee8ae8
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/FeedbackDetail.cpp
@@ -0,0 +1,83 @@
+#include "FeedbackDetail.hpp"
+#include "MilkdropStaticShaders.hpp"
+#include <stdexcept>
+
+namespace libprojectM { namespace MilkdropPreset {
+FeedbackDetail::FeedbackDetail(int width, int height, DetailCanvas canvas, bool retainDetail)
+    : m_width(width), m_height(height), m_size(canvas), m_retainsDetail(retainDetail)
+{
+    auto shaders = MilkdropStaticShaders::Get();
+    const auto vertex = shaders->GetFeedbackDetailVertexShader();
+    m_down.CompileProgram(vertex, shaders->GetFeedbackDetailDownFragmentShader());
+    m_combine.CompileProgram(vertex, shaders->GetFeedbackDetailCombineFragmentShader());
+    // Allocate before generating the VAO: constructor failure must not leave raw handles alive.
+    for (int i = 0; i < (retainDetail ? 3 : 2); ++i) m_canvas.CreateColorAttachment(i, 0);
+    m_canvas.SetSize(canvas.width, canvas.height);
+    for (int i = 0; i < (retainDetail ? 3 : 2); ++i) {
+        m_canvas.Bind(i);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+            throw std::runtime_error("incomplete authored feedback framebuffer");
+    }
+    if (retainDetail) {
+        m_combined = std::make_unique<Renderer::Framebuffer>();
+        m_combined->CreateColorAttachment(0, 0);
+        m_combined->SetSize(width, height);
+        m_combined->Bind(0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+            throw std::runtime_error("incomplete native detail framebuffer");
+    }
+    glGenVertexArrays(1, &m_vao);
+}
+FeedbackDetail::~FeedbackDetail() { glDeleteVertexArrays(1, &m_vao); }
+void FeedbackDetail::BindTexture(const Renderer::Shader& shader, const char* uniform, int unit,
+                                 const std::shared_ptr<Renderer::Texture>& texture)
+{
+    texture->Bind(unit);
+    m_sampler.Bind(unit);
+    shader.SetUniformInt(uniform, unit);
+}
+void FeedbackDetail::Draw(int width, int height)
+{
+    glViewport(0, 0, width, height);
+    glDisable(GL_BLEND);
+    glBindVertexArray(m_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindVertexArray(0);
+    for (int unit = 0; unit < 3; ++unit) Renderer::Sampler::Unbind(unit);
+    glActiveTexture(GL_TEXTURE0);
+    Renderer::Shader::Unbind();
+}
+void FeedbackDetail::Down(const std::shared_ptr<Renderer::Texture>& texture, int index)
+{
+    m_canvas.Bind(index);
+    m_down.Bind();
+    BindTexture(m_down, "src", 0, texture);
+    m_down.SetUniformInt("S", m_size.scale);
+    Draw(m_size.width, m_size.height);
+}
+void FeedbackDetail::Initialize(const std::shared_ptr<Renderer::Texture>& previous) { Down(previous, m_previous); }
+void FeedbackDetail::Combine(const std::shared_ptr<Renderer::Texture>& nativeWarp, float alpha,
+                             Renderer::Framebuffer& output, int outputIndex)
+{
+    if (m_retainsDetail) Down(nativeWarp, 2);
+    if (m_retainsDetail) m_combined->Bind(0); else output.Bind(outputIndex);
+    m_combine.Bind();
+    BindTexture(m_combine, "Lw", 0, Warped());
+    // Standard never binds/samples the native warp or allocates its intermediate textures.
+    if (m_retainsDetail) {
+        BindTexture(m_combine, "Hw", 1, nativeWarp);
+        BindTexture(m_combine, "D", 2, m_canvas.GetColorAttachmentTexture(2, 0));
+    } else {
+        // Samplers of the same type may alias; keep them valid on stricter drivers.
+        m_combine.SetUniformInt("Hw", 0); m_combine.SetUniformInt("D", 0);
+    }
+    m_combine.SetUniformFloat("alpha", alpha);
+    m_combine.SetUniformFloat2("native", {m_width, m_height});
+    Draw(m_width, m_height);
+    if (m_retainsDetail) {
+        m_combined->BindRead(0); output.BindDraw(outputIndex);
+        glBlitFramebuffer(0, 0, m_width, m_height, 0, 0, m_width, m_height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    }
+    output.Bind(outputIndex);
+}
+} }
diff --git a/src/libprojectM/MilkdropPreset/FeedbackDetail.hpp b/src/libprojectM/MilkdropPreset/FeedbackDetail.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..77a6c820aebcb89bce44762f9babe2ce089889fc
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/FeedbackDetail.hpp
@@ -0,0 +1,57 @@
+#pragma once
+#include <Renderer/CopyTexture.hpp>
+#include <Renderer/Framebuffer.hpp>
+#include <Renderer/Sampler.hpp>
+#include <Renderer/Shader.hpp>
+#include <cmath>
+#include <memory>
+
+namespace libprojectM { namespace MilkdropPreset {
+struct DetailCanvas { int width{}; int height{}; int scale{}; };
+inline auto FeedbackDetailCanvas(int width, int height, int referenceWidth, int referenceHeight) -> DetailCanvas
+{
+    if (width <= 0 || height <= 0 || referenceWidth <= 0 || referenceHeight <= 0) return {};
+    const int scale = static_cast<int>(std::lround(std::sqrt(
+        (static_cast<double>(width) * height) / (static_cast<double>(referenceWidth) * referenceHeight))));
+    if (scale < 2 || width % scale != 0 || height % scale != 0) return {};
+    return {width / scale, height / scale, scale};
+}
+
+/** Per-preset authored feedback and optional native detail. All resources belong to this instance. */
+class FeedbackDetail
+{
+public:
+    FeedbackDetail(int width, int height, DetailCanvas canvas, bool retainDetail);
+    ~FeedbackDetail();
+    FeedbackDetail(const FeedbackDetail&) = delete;
+    auto operator=(const FeedbackDetail&) -> FeedbackDetail& = delete;
+    void Initialize(const std::shared_ptr<Renderer::Texture>& previous);
+    void Combine(const std::shared_ptr<Renderer::Texture>& nativeWarp, float alpha,
+                 Renderer::Framebuffer& output, int outputIndex);
+    auto PreviousIndex() const -> int { return m_previous; }
+    auto WarpedIndex() const -> int { return m_warped; }
+    void FinishGeometry() { std::swap(m_previous,m_warped); }
+    auto Previous() const -> std::shared_ptr<Renderer::Texture> { return m_canvas.GetColorAttachmentTexture(m_previous, 0); }
+    auto Warped() const -> std::shared_ptr<Renderer::Texture> { return m_canvas.GetColorAttachmentTexture(m_warped, 0); }
+    auto CanvasFramebuffer() -> Renderer::Framebuffer& { return m_canvas; }
+    auto Canvas() const -> DetailCanvas { return m_size; }
+    auto Width() const -> int { return m_width; }
+    auto Height() const -> int { return m_height; }
+    auto RetainsDetail() const -> bool { return m_retainsDetail; }
+    Renderer::CopyTexture flip;
+private:
+    void Draw(int width, int height);
+    void BindTexture(const Renderer::Shader& shader, const char* uniform, int unit,
+                     const std::shared_ptr<Renderer::Texture>& texture);
+    void Down(const std::shared_ptr<Renderer::Texture>& texture, int index);
+    int m_previous{0}, m_warped{1};
+    int m_width, m_height;
+    DetailCanvas m_size;
+    bool m_retainsDetail;
+    Renderer::Framebuffer m_canvas{3};
+    std::unique_ptr<Renderer::Framebuffer> m_combined;
+    Renderer::Shader m_down, m_combine;
+    Renderer::Sampler m_sampler{GL_CLAMP_TO_EDGE, GL_LINEAR};
+    GLuint m_vao{};
+};
+} }
