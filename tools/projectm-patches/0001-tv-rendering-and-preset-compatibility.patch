+TEST(FeedbackDetail, IntegerNativeCanvasAndFallback) {
+    auto fourK = FeedbackDetailCanvas(3840, 2160, 1280, 720);
+    EXPECT_EQ(fourK.scale, 3); EXPECT_EQ(fourK.width, 1280); EXPECT_EQ(fourK.height, 720);
+    EXPECT_EQ(FeedbackDetailCanvas(2560, 1440, 1280, 720).scale, 2);
+    EXPECT_EQ(FeedbackDetailCanvas(1920, 1080, 1280, 720).scale, 2);
+    EXPECT_EQ(FeedbackDetailCanvas(3841, 2160, 1280, 720).scale, 0);
+    EXPECT_EQ(FeedbackDetailCanvas(1280, 720, 1280, 720).scale, 0);
+    EXPECT_EQ(FeedbackDetailCanvas(3840, 2160, 0, 0).scale, 0);
+}
