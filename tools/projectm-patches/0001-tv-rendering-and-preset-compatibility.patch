+TEST_F(FeedbackDiffusionRenderTest, FramesWithMotionVectorsKeepPointReadsAndCompositeExact)
+{
+    // Motion vectors are drawn onto the previous frame every frame, so the warp inputs are
+    // recomputed before each warp and the end-of-frame flip feeds only the composite. At alpha
+    // 0.001 blending changes no 8-bit value: the frames take that path while compensation's own
+    // scaled minimum vector length cannot change the canvas.
+    const std::string vectors = "nMotionVectorsX=12\nnMotionVectorsY=9\nmv_a=0.001\nmv_r=1\nmv_g=1\nmv_b=1\nmv_l=1\n";
+    for (const char* read : {"tex2D(sampler_pc_main, uv).rgb", "GetPixel(uv).rgb"})
+    {
+        SCOPED_TRACE(read);
+        // Frame 0 draws inverted stripes, frame 1 the stripes frame 2 reads: an exact copy left over
+        // from before the vector frames would show frame 0's image.
+        const std::string seed = std::string("if (frame < 1) ret = 1.0 - ") + Seed + "; else if (frame < 2) ret = " + Seed + "; else ret = ";
+        auto active = Preset(seed + read + " + GetPixel(uv).rgb*0.0;");
+        auto off = Preset(seed + read + Ineligible + ";");
+        active.insert(active.find("warp_1="), vectors);
+        off.insert(off.find("warp_1="), vectors);
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            const auto activeImage = Render(active, reference.first, reference.second);
+            const auto offImage = Render(off, reference.first, reference.second);
+            if (std::string(read).find("pc_main") != std::string::npos)
+            {
+                EXPECT_EQ(DifferentBytes(activeImage, offImage), 0u);
+            }
+            else
+            {
+                EXPECT_GT(DifferentBytes(activeImage, offImage), 0u) << "bilinear reads must still be filtered";
+            }
+        }
+    }
+}
