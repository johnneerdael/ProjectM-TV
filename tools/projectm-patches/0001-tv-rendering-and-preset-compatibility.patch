+    auto operator=(const LineRenderer&) -> LineRenderer& = delete;
+
+    /**
+     * @brief False if the line program did not compile or link; then nothing is drawn.
+     */
+    auto Usable() const -> bool;
+
+    void Upload(const LineBatch& batch);
+    void Begin(const glm::mat4& transformation, const Renderer::RenderContext& context);
+    void Draw(const LineBatch::Strip& strip, const LineStyle& style);
+    void End();
+
+private:
+    friend class ::libprojectM::FeedbackDetailTestAccess;
+    /**
+     * @brief Sets a float uniform unless it already has this value (or the location is -1).
+     */
+    static void SetFloat(GLint location, float value, float& lastValue, bool& lastValid);
+
+    Renderer::Shader m_shader;  //!< Line program, compiled with the preset (off the render thread when prewarmed).
+    bool m_usable{false};       //!< m_shader compiled and linked.
+    GLuint m_vaoId{0};          //!< Vertex array with six per-instance attributes.
+    GLuint m_vboId{0};          //!< Padded strip points.
+    bool m_ready{false};        //!< Begin() found a usable program, a vertex array (created by the first Upload()) and a non-empty viewport.
