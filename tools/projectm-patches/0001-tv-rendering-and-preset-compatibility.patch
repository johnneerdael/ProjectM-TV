+/**
+ * @brief Statistics of the process-wide cache of linked shader programs.
+ *
+ * Programs are cached by their source code and shared by all instances: a program another instance
+ * (e.g. on another thread with its own context) already linked loads in milliseconds.
+ *
+ * @param hits Receives the number of programs loaded from the cache.
+ * @param misses Receives the number of programs that were compiled.
+ */
+PROJECTM_EXPORT void projectm_opengl_program_cache_stats(uint32_t* hits, uint32_t* misses);
+
+/**
+ * @brief During a soft-cut transition, renders the outgoing preset only every n-th frame.
+ *
+ * The outgoing preset fades out and its last frame is blended in between, so a divisor of 2 halves
+ * its cost with little visible difference. 1 (the default) renders it every frame.
+ *
+ * @param instance The projectM instance handle.
+ * @param divisor Render the outgoing preset every divisor-th frame, at least 1.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_outgoing_preset_frame_divisor(projectm_handle instance, uint32_t divisor);
+
+/**
+ * @brief Lets the preset draw its final image straight into the target framebuffer.
+ *
+ * Saves storing the image in the preset's own texture and copying it to the target. projectM
+ * still uses the texture during transitions and in frames that request a preset switch. The
+ * caller must render one frame with this disabled before it switches presets itself, as the new
+ * preset starts from the previous preset's texture.
+ *
+ * @param instance The projectM instance handle.
+ * @param enabled True to allow drawing straight into the target. Off by default.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_direct_output(projectm_handle instance, bool enabled);
+
+/** Authored-canvas feedback with native detail gain 0..1; negative/nonfinite disables it (default).
+ * Call on the rendering thread. The existing line reference controls the integer canvas.
+ * Unsupported canvases or shader failures retain the feedback diffusion fallback.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_feedback_detail(projectm_handle instance, float alpha);
+
+/** Actual last-rendered preset state: -1 off, -2 canvas fallback, -3 shader/resource failure,
+ * or active integer canvas scale >=2. */
+PROJECTM_EXPORT int projectm_opengl_get_feedback_detail_status(projectm_handle instance);
+
+/**
+ * @brief Draws waveforms, custom waves, shape outlines and motion vectors as quads, and waveform dots
+ *        with a matching point size, so they keep their share of the picture at large render sizes.
+ *
+ * Lines are 1 px wide at and below the given render size's area and widen by the square root of the
+ * area ratio above it, so a line covers the same share of the picture at any size and aspect ratio
+ * (at the reference's aspect ratio this is the render height over the reference height). Thick ones
+ * are drawn like MilkDrop's: the thin line four times with small offsets that scale the same way.
+ * Below the reference area lines are drawn as at it, because thinner, faded lines made presets that
+ * feed their image back go dark. Edges are hard, like MilkDrop's GL lines, unless
+ * projectm_opengl_set_line_antialiasing() is enabled. Dots remain GL points whose size scales the
+ * same way (on desktop OpenGL, GL_PROGRAM_POINT_SIZE is enabled while they are drawn). 0 in either
+ * dimension, the default, keeps MilkDrop's 1 px GL lines and points. If the driver rejects the line
+ * shaders, lines fall back to GL lines.
+ *
+ * @param instance The projectM instance handle.
+ * @param width Width of the reference render size in pixels, or 0.
+ * @param height Height of the reference render size in pixels, or 0.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_line_reference_size(projectm_handle instance, uint32_t width, uint32_t height);
+
+/**
+ * @brief Gives quad lines (see projectm_opengl_set_line_reference_size()) a one-pixel anti-aliased edge.
+ *
+ * Off by default: quad lines have hard edges like MilkDrop's GL lines, which presets that feed their
+ * image back are tuned for (a soft edge made such a preset 14 % darker in testing). Has no effect
+ * while no line reference size is set, and none on dots.
+ *
+ * @param instance The projectM instance handle.
+ * @param enabled True for anti-aliased edges.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_line_antialiasing(projectm_handle instance, bool enabled);
+
+/**
+ * @brief Sets the size of the calling thread's pool of framebuffer textures.
+ *
+ * When a preset is discarded, its framebuffer textures are kept for the next preset of the same
+ * size instead of being deleted, which saves allocating them at the next preset switch. The pool
+ * belongs to the thread's current OpenGL context. 0 (the default) disables it and deletes the
+ * pooled textures; the context must be current.
+ *
+ * @param max_bytes The most memory the pooled textures may take.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_texture_pool_limit(size_t max_bytes);
+
+/**
+ * @brief Drops the calling thread's pooled textures without deleting them, after their context was lost.
+ */
+PROJECTM_EXPORT void projectm_opengl_forget_texture_pool();
+
+/**
+ * @brief Memory held by the calling thread's texture pool, in bytes.
+ */
+PROJECTM_EXPORT size_t projectm_opengl_texture_pool_bytes();
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
