+    // referenceWidth/Height 0 turn compensation off; 64x48 gives scale 2 (three taps),
+    // 32x24 scale 4 (four taps, capped variance).
+    auto Render(const std::string& preset, int referenceWidth, int referenceHeight) -> Image
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        TestProjectM engine;
+        engine.SetWindowSize(Width, Height);
+        engine.SetMeshSize(48, 32);
+        engine.SetPresetLocked(true);
+        engine.SetHardCutEnabled(false);
+        engine.SetEasterEgg(0);
+        engine.SetLineReferenceSize(referenceWidth, referenceHeight);
+        std::istringstream data(preset);
+        engine.LoadPresetData(data, false);
+        EXPECT_TRUE(engine.failure.empty()) << engine.failure;
+        for (int frame = 0; frame < 3; ++frame)
+        {
+            engine.RenderFrame(m_framebuffer);
+        }
+        Image pixels(Width * Height * 3);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glReadPixels(0, 0, Width, Height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(glGetError(), GL_NO_ERROR);
+        EXPECT_GT(*std::max_element(pixels.begin(), pixels.end()), 200) << "fixture did not render";
+        return pixels;
+    }
+
+#ifdef __APPLE__
+    static CGLContextObj s_context;
+#elif defined(PROJECTM_TEST_EGL)
+    static EGLDisplay s_display;
+    static EGLContext s_context;
+    static EGLSurface s_surface;
+#endif
+    bool m_glReady{false};
+    GLuint m_framebuffer{};
+    GLuint m_texture{};
+};
