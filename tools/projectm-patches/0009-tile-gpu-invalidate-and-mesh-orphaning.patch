+namespace {
+// A copy covers the whole target. Without blending its old contents are never read, so
+// tile-based GPUs can skip loading them from memory. With blending on, keep them.
+void InvalidateCopyTarget()
+{
+    if (glIsEnabled(GL_BLEND))
+    {
+        return;
+    }
+    const GLenum attachment = GL_COLOR_ATTACHMENT0;
+    glInvalidateFramebuffer(GL_DRAW_FRAMEBUFFER, 1, &attachment);
+}
