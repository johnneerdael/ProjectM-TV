+++ b/src/libprojectM/ProjectMCWrapper.cpp
@@ -357,6 +357,11 @@ void projectm_opengl_program_cache_stats(uint32_t* hits, uint32_t* misses)
     }
 }
 
+void projectm_opengl_set_program_cache_enabled(bool enabled)
+{
+    libprojectM::Renderer::Shader::SetProgramCacheEnabled(enabled);
+}
