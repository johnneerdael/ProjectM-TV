diff --git a/src/libprojectM/Renderer/Shader.cpp b/src/libprojectM/Renderer/Shader.cpp
index e9769c474..4a287da8e 100644
--- a/src/libprojectM/Renderer/Shader.cpp
+++ b/src/libprojectM/Renderer/Shader.cpp
@@ -4,6 +4,7 @@
 #include <glm/gtc/type_ptr.hpp>
 
 #include <atomic>
+#include <condition_variable>
 #include <list>
 #include <mutex>
 #include <vector>
@@ -32,9 +33,91 @@ public:
         return cache;
     }
 
+    /**
+     * Off: programs are always compiled and never exported or loaded as binaries (for drivers
+     * whose program binaries cannot be trusted across contexts). Turning it off drops all entries
+     * and waits for binary calls already under way on other threads, so none runs after it returns.
+     */
+    void SetEnabled(bool enabled)
+    {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_enabled = enabled;
+        if (!enabled)
+        {
+            m_entries.clear();
+            m_bytes = 0;
+            m_idle.wait(lock, [this] { return m_binaryCalls == 0; });
+        }
+    }
+
+    /**
+     * Admits driver binary calls (hint, export or load) while the cache is enabled; disabling
+     * waits until every admitted call has finished.
+     */
+    class BinaryUse
+    {
+    public:
+        explicit BinaryUse(ProgramCache& cache)
+            : m_cache(cache)
+        {
+            std::lock_guard<std::mutex> lock(cache.m_mutex);
+            m_admitted = cache.m_enabled.load();
+            if (m_admitted)
+            {
+                cache.m_binaryCalls++;
+            }
+        }
+
+        ~BinaryUse()
+        {
+            if (!m_admitted)
+            {
+                return;
+            }
+            std::lock_guard<std::mutex> lock(m_cache.m_mutex);
+            if (--m_cache.m_binaryCalls == 0)
+            {
+                m_cache.m_idle.notify_all();
+            }
+        }
+
+        BinaryUse(const BinaryUse&) = delete;
+        auto operator=(const BinaryUse&) -> BinaryUse& = delete;
+
+        explicit operator bool() const
+        {
+            return m_admitted;
+        }
+
+    private:
+        ProgramCache& m_cache;
+        bool m_admitted{};
+    };
+
+    /** Asks the driver to keep the program's binary retrievable, unless the cache is off. */
+    void RequestRetrievableBinary(GLuint program)
+    {
+#ifdef USE_GLES
+        BinaryUse use(*this);
+        if (use)
+        {
+            glProgramParameteri(program, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+        }
+#else
+        (void) program;
+#endif
+    }
+
     auto Load(GLuint program, const std::string& key) -> bool
     {
 #ifdef USE_GLES
+        BinaryUse use(*this);
+        if (!use)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_misses++;
+            return false;
+        }
         GLenum format{};
         std::vector<char> binary;
         {
@@ -75,6 +158,11 @@ public:
     void Store(GLuint program, const std::string& key)
     {
 #ifdef USE_GLES
+        BinaryUse use(*this);
+        if (!use)
+        {
+            return;
+        }
         GLint length{};
         glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
         if (length <= 0 || static_cast<size_t>(length) > maxBytes / 4)
@@ -91,6 +179,10 @@ public:
         entry.binary.resize(static_cast<size_t>(written));
 
         std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_enabled.load())
+        {
+            return; // turned off while this program was being exported
+        }
         auto it = Find(key);
         if (it != m_entries.end())
         {
@@ -138,6 +230,9 @@ private:
     }
 
     std::mutex m_mutex;
+    std::atomic<bool> m_enabled{true};
+    std::condition_variable m_idle;  //!< Signalled when the last admitted binary call finishes.
+    uint32_t m_binaryCalls{};        //!< Binary calls under way (guarded by m_mutex).
     std::list<Entry> m_entries; //!< Most recently used first.
     size_t m_bytes{};
     uint32_t m_hits{};
@@ -151,6 +246,11 @@ void Shader::ProgramCacheStats(uint32_t& hits, uint32_t& misses)
     ProgramCache::Instance().Stats(hits, misses);
 }
 
+void Shader::SetProgramCacheEnabled(bool enabled)
+{
+    ProgramCache::Instance().SetEnabled(enabled);
+}
+
 Shader::Shader()
     : m_shaderProgram(glCreateProgram())
 {
@@ -194,9 +294,7 @@ void Shader::CompileProgram(const std::string& vertexShaderSource,
     glAttachShader(m_shaderProgram, vertexShader);
     glAttachShader(m_shaderProgram, fragmentShader);
 
-#ifdef USE_GLES
-    glProgramParameteri(m_shaderProgram, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
-#endif
+    ProgramCache::Instance().RequestRetrievableBinary(m_shaderProgram);
     glLinkProgram(m_shaderProgram);
 
     // Shader objects are no longer needed after linking, free the memory.
