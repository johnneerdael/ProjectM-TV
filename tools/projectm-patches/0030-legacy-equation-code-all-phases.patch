diff --git a/tests/libprojectM/LegacyEquationCodeTest.cpp b/tests/libprojectM/LegacyEquationCodeTest.cpp
new file mode 100644
index 000000000..d58804640
--- /dev/null
+++ b/tests/libprojectM/LegacyEquationCodeTest.cpp
@@ -0,0 +1,171 @@
+#include <MilkdropPreset/LegacyEquationCode.hpp>
+#include <MilkdropPreset/MilkdropPresetExceptions.hpp>
+#include <MilkdropPreset/PerFrameContext.hpp>
+#include <MilkdropPreset/PerPixelContext.hpp>
+#include <ProjectM.hpp>
+#include <gtest/gtest.h>
+#include <sstream>
+#include <string>
+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+using libprojectM::MilkdropPreset::AssembleLegacyEquationCode;
+using libprojectM::MilkdropPreset::CompileEquationCode;
+using libprojectM::MilkdropPreset::MilkdropCompileException;
+using libprojectM::MilkdropPreset::PerFrameContext;
+using libprojectM::MilkdropPreset::PerPixelContext;
+
+TEST(LegacyEquationCode, JoinsSplitIdentifiersAndNumbers) {
+    EXPECT_EQ(AssembleLegacyEquationCode("q1=is_\nbeat;\n"), "q1=is_beat;");
+    EXPECT_EQ(AssembleLegacyEquationCode("x=1\n.5;\n"), "x=1.5;");
+    EXPECT_EQ(AssembleLegacyEquationCode("x=2.5e\n3;\n"), "x=2.5e3;");
+}
+TEST(LegacyEquationCode, StripsBothLineCommentFormsPerRecord) {
+    EXPECT_EQ(AssembleLegacyEquationCode("a=is_// note\nbeat;\n"), "a=is_beat;");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=is_\\\\ note\nbeat;\n"), "a=is_beat;");
+    EXPECT_EQ(AssembleLegacyEquationCode("// only a comment\na=1;\n"), "a=1;");
+}
+TEST(LegacyEquationCode, TreatsCarriageReturnsAsRecordSeparators) {
+    EXPECT_EQ(AssembleLegacyEquationCode("a=is_\r\nbeat;\r\n"), "a=is_beat;");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=1;// c\rb=2;\r"), "a=1;b=2;");
+}
+TEST(LegacyEquationCode, KeepsEmptyRecordsAndCodeWithoutChangesIntact) {
+    EXPECT_EQ(AssembleLegacyEquationCode("a=1;\n\nb=2;\n"), "a=1;b=2;");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=1;b=2;"), "a=1;b=2;");
+    EXPECT_EQ(AssembleLegacyEquationCode(""), "");
+}
+TEST(LegacyEquationCode, ReplacesSemicolonsInParenthesesWithoutFollowingOperand) {
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b;; * c);"), "a=(b   * c);");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b; );"), "a=(b  );");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b;/* c */-d);"), "a=(b /* c */-d);");
+    // An operand follows: NS-EEL keeps the sequence.
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b; c);"), "a=(b; c);");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b;(c));"), "a=(b;(c));");
+    EXPECT_EQ(AssembleLegacyEquationCode("a=(b;_c;!d;$pi);"), "a=(b;_c;!d;$pi);");
+    // Outside parentheses ';' separates statements and stays.
+    EXPECT_EQ(AssembleLegacyEquationCode("a=1;; b=2;"), "a=1;; b=2;");
+    // Parentheses inside block comments do not count.
+    EXPECT_EQ(AssembleLegacyEquationCode("/* ( */a=1;;"), "/* ( */a=1;;");
+}
