+class EquationContext : public ::testing::Test {
+protected:
+    void SetUp() override { context = projectm_eval_context_create(nullptr, nullptr); }
+    void TearDown() override { projectm_eval_context_destroy(context); }
+    auto Run(const std::string& code, const char* variable) -> double {
+        std::string error;
+        auto* handle = CompileEquationCode(context, code, error);
+        EXPECT_NE(handle, nullptr) << error;
+        if (handle == nullptr) return -999;
+        EXPECT_TRUE(error.empty());
+        projectm_eval_code_execute(handle);
+        projectm_eval_code_destroy(handle);
+        return *projectm_eval_context_register_variable(context, variable);
+    }
+    projectm_eval_context* context{};
+};
+TEST_F(EquationContext, AcceptedProgramsCompileUnchanged) {
+    // NS-EEL would read "(2; -1)" as 2 - 1; the evaluator accepts it as a sequence and that stays.
+    EXPECT_DOUBLE_EQ(Run("y=(2; -1);\n", "y"), -1.0);
+}
+TEST_F(EquationContext, RejectedProgramsUseTheLegacyForm) {
+    EXPECT_DOUBLE_EQ(Run("beat=3;\ny=be\nat*2;\n", "y"), 6.0);
+    EXPECT_DOUBLE_EQ(Run("y=(2;; * 4);\n", "y"), 8.0);
+}
+TEST_F(EquationContext, InvalidProgramsReportTheOriginalLineAndColumn) {
+    std::string error;
+    EXPECT_EQ(CompileEquationCode(context, "a=1;\nb=(;\n", error), nullptr);
+    EXPECT_NE(error.find("syntax error"), std::string::npos) << error;
+    EXPECT_NE(error.find("(line 2, column"), std::string::npos) << error;
+}
+
+TEST(EquationPhases, PerFrameCodeJoinsRecords) {
+    PerFrameContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerFrameCode("zoom=1\n.25;\n"));
+    context.ExecutePerFrameCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 1.25);
+}
+TEST(EquationPhases, PerPixelCodeJoinsRecords) {
+    PerPixelContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    ASSERT_NO_THROW(context.CompilePerPixelCode("zoom=1// first half\n.5;\n"));
+    context.ExecutePerPixelCode();
+    EXPECT_DOUBLE_EQ(*context.zoom, 1.5);
+}
+TEST(EquationPhases, InvalidPerPixelCodeKeepsItsDiagnostic) {
+    PerPixelContext context(nullptr, nullptr);
+    context.RegisterBuiltinVariables();
+    try {
+        context.CompilePerPixelCode("zoom=1;\nrot=rot*sin*2;\n");
+        FAIL() << "invalid code compiled";
+    } catch (const MilkdropCompileException& error) {
+        const std::string message = error.what();
+        EXPECT_EQ(message.rfind("Could not compile per-pixel code: ", 0), 0u) << message;
+        EXPECT_NE(message.find("(line 2, column"), std::string::npos) << message;
+    }
+}
