+        engine.SetFeedbackDetail(detail ? 0 : -1);
+        engine.SetPresetLocked(true); engine.SetHardCutEnabled(false);
+        std::srand(12345);
+        std::istringstream preset(source); engine.LoadPresetData(preset,false);
+        EXPECT_TRUE(engine.failure.empty()) << engine.failure;
+        std::vector<Image> state;
+        std::vector<float> audio(576);
+        for (int frame=0; frame<4; ++frame) {
+            for(size_t i=0;i<audio.size();++i) audio[i]=0.4f*std::sin(float(i)*0.063f+frame*0.2f);
+            engine.PCM().Add(audio.data(),1,audio.size());
+            engine.RenderFrame(m_framebuffer);
+            state.push_back(ReadFeedbackTexture(libprojectM::FeedbackDetailTestAccess::Feedback(engine)));
+        }
+        EXPECT_EQ(glGetError(),GL_NO_ERROR);
+        return state;
+    };
+    const auto authored=render(false),native=render(true);
+    ASSERT_EQ(authored.size(),native.size());
+    ASSERT_GT(*std::max_element(authored.back().begin(),authored.back().end()),0);
+    for(size_t frame=0;frame<authored.size();++frame)
+        EXPECT_EQ(DifferentBytes(authored[frame],native[frame]),0u) << "feedback frame " << frame;
+}
