+TEST_F(FeedbackDiffusionRenderTest, GeometryReplayDoesNotRepeatPersistentEquations) {
+    const auto source=Preset("ret=float3(0,0,0);")+
+        "shapecode_0_enabled=1\nshapecode_0_num_inst=3\n"
+        "shape_0_per_frame1=reg00=reg00+1;x=0.2+0.1*instance;\n"
+        "wavecode_0_enabled=1\nwavecode_0_samples=8\n"
+        "wave_0_per_frame1=reg01=reg01+1;\n"
+        "wave_0_per_point1=reg02=reg02+1;x=sample;y=0.5;\n";
+    for(float alpha : {-1.f,0.f,0.5f,1.f}) {
+        TestProjectM engine;
+        engine.SetWindowSize(126,96);engine.SetLineReferenceSize(42,32);
+        engine.SetFeedbackDetail(alpha);engine.SetPresetLocked(true);engine.SetHardCutEnabled(false);
+        std::istringstream input(source);engine.LoadPresetData(input,false);
+        ASSERT_TRUE(engine.failure.empty())<<engine.failure;
+        for(int frame=1;frame<=4;++frame) {
+            engine.RenderFrame(m_framebuffer);
+            EXPECT_EQ(libprojectM::FeedbackDetailTestAccess::Register(engine,0),3*frame)<<"shape instances, alpha "<<alpha;
+            EXPECT_EQ(libprojectM::FeedbackDetailTestAccess::Register(engine,1),frame)<<"wave frame, alpha "<<alpha;
+            EXPECT_EQ(libprojectM::FeedbackDetailTestAccess::Register(engine,2),8*frame)<<"wave points, alpha "<<alpha;
+        }
+        EXPECT_EQ(glGetError(),GL_NO_ERROR);
+    }
