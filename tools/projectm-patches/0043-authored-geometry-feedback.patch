+TEST_F(FeedbackDiffusionRenderTest, GeometryReplayKeepsNativePresentationSharp) {
+    const auto source=Preset("ret=float3(0,0,0);")+
+        "shapecode_0_enabled=1\nshapecode_0_sides=3\nshapecode_0_x=0.437\n"
+        "shapecode_0_y=0.533\nshapecode_0_rad=0.2713\nshapecode_0_a=1\n"
+        "shapecode_0_r=1\nshapecode_0_g=0.4\nshapecode_0_b=0.2\n"
+        "shapecode_0_r2=1\nshapecode_0_g2=0.4\nshapecode_0_b2=0.2\nshapecode_0_a2=1\n"
+        "shapecode_0_border_a=0\n";
+    const auto render=[&](float alpha) {
+        TestProjectM engine;
+        engine.SetWindowSize(126,96);engine.SetLineReferenceSize(42,32);
+        engine.SetFeedbackDetail(alpha);engine.SetPresetLocked(true);engine.SetHardCutEnabled(false);
+        std::istringstream input(source);engine.LoadPresetData(input,false);
+        EXPECT_TRUE(engine.failure.empty())<<engine.failure;
+        engine.RenderFrame(m_framebuffer);
+        const auto pixels=ReadFeedbackTexture(libprojectM::FeedbackDetailTestAccess::NativeFeedback(engine));
+        EXPECT_EQ(glGetError(),GL_NO_ERROR);
+        return pixels;
+    };
+    const auto native=render(-1);
+    ASSERT_GT(*std::max_element(native.begin(),native.end()),0);
+    for(float alpha : {0.f,0.5f,1.f})
+        EXPECT_EQ(render(alpha),native)<<"Native geometry must not be an enlarged authored image";
+}
