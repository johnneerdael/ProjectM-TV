+auto PackedFeedbackPreset(const std::string& sampler, bool wrap) -> std::string
+{
+    auto preset = Preset("GetPixel(uv)", wrap, false);
+    preset.erase(preset.find("warp_1="));
+    // Green/blue encode independent discrete state, rather than display colour. A point recurrence
+    // must retain these bits even while a live bilinear red-channel read enables compensation.
+    preset += "warp_1=`shader_body { if (frame < 2) ret = float3(1, "
+              "frac(floor(uv.x*32)*0.5)*2, frac(floor(uv.y*24)*0.5)*2); "
+              "else { float2 packed = tex2D(sampler_" + sampler +
+              ", uv_orig + float2(0.199, 0.004)).gb; "
+              "ret = float3(GetPixel(uv).r, round(packed*32)/32); } }\n";
+    return preset;
+}
+
+} // namespace
+
+TEST_F(WarpSamplerTest, PackedPointStateSurvivesMixedFeedbackAboveReference)
+{
+    for (bool wrap : {false, true})
+    {
+        SCOPED_TRACE(wrap);
+        // Both supported ordering conventions must route by the actual sampler's filter mode.
+        for (const char* name : {"pc_main", "cp_main", "pw_main", "wp_main"})
+        {
+            SCOPED_TRACE(name);
+            const auto preset = PackedFeedbackPreset(name, wrap);
+            ExpectSame(Render(preset, 0, 0, 8), Render(preset, Width/2, Height/2, 8));
+        }
+    }
+}
+
+TEST_F(WarpSamplerTest, MixedFeedbackKeepsPointStateAndFiltersBilinearRead)
+{
+    auto preset = Preset("GetPixel(uv)", false, false);
+    preset.erase(preset.find("warp_1="));
+    preset += "warp_1=`shader_body { if (frame < 2) "
+              "ret = float3(1, frac(floor(uv.x*32)*0.5)*2, 1); "
+              "else ret = float3(GetPixel(uv).g, tex2D(sampler_pc_main, uv_orig).g, 1); }\n";
+    const auto ordinary = Render(preset);
+    const auto compensated = Render(preset, Width/2, Height/2);
+    size_t filteredPixels{};
+    size_t changedPointPixels{};
+    for (size_t pixel = 0; pixel < ordinary.size(); pixel += 3)
+    {
+        changedPointPixels += compensated[pixel+1] != ordinary[pixel+1];
+        filteredPixels += compensated[pixel] != compensated[pixel+1];
+    }
+    EXPECT_EQ(changedPointPixels, 0u) << "point state changed";
+    EXPECT_GT(filteredPixels, 100u) << "bilinear branch must still receive diffusion";
+}
+
+TEST_F(WarpSamplerTest, MixedPointFeedbackIsUnchangedAtReferenceOrWithoutReference)
+{
+    for (const char* name : {"pc_main", "cp_main", "pw_main", "wp_main"})
+    {
+        SCOPED_TRACE(name);
+        const auto preset = PackedFeedbackPreset(name, true);
+        ExpectSame(Render(preset, 0, 0, 8), Render(preset, Width, Height, 8));
+        ExpectSame(Render(preset, 0, 0, 8), Render(preset, Width*2, Height*2, 8));
+    }
