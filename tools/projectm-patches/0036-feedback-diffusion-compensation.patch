index 000000000..b47cbf966
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/FeedbackDiffusion.cpp
@@ -0,0 +1,326 @@
+#include "FeedbackDiffusion.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cctype>
+#include <cstdio>
+#include <string>
+#include <initializer_list>
+#include <vector>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+namespace {
+
+#ifdef USE_GLES
+constexpr char ShaderVersion[] = "#version 300 es\n\n";
+#else
+constexpr char ShaderVersion[] = "#version 330\n\n";
+#endif
+
+constexpr char VertexShader[] = R"(
+precision highp float;
+precision highp int;
+
+layout(location = 0) in vec2 position;
+layout(location = 1) in vec2 tex_coord;
+
+out vec2 fragment_tex_coord;
+
+uniform int flip_vertical;
+
+void main() {
+    gl_Position = vec4(position, 0.0, 1.0);
+    fragment_tex_coord = tex_coord;
+    if (flip_vertical > 0)
+    {
+        fragment_tex_coord.t = 1.0 - fragment_tex_coord.t;
+    }
+}
+)";
+
+// One pass, two outputs: the exact y-flipped previous frame for point reads and the composite,
+// and the filtered warp input. Uniform branch: three low-variance taps, four symmetric diagonal
+// taps above that range.
+constexpr char FragmentShader[] = R"(
+precision highp float;
+precision highp int; // flip_vertical is shared with the vertex stage; texel indices exceed 2^10.
+in vec2 fragment_tex_coord;
+uniform sampler2D source;
+uniform int flip_vertical;
+uniform vec2 tap_step;
+uniform vec2 weights; // x: requested/capped variance, y: unused
+layout(location = 0) out vec4 raw;
+layout(location = 1) out vec4 color;
+void main() {
+    // texelFetch copies texels exactly, independent of sampler state and coordinate precision.
+    ivec2 texel = ivec2(gl_FragCoord.xy);
+    if (flip_vertical > 0)
+    {
+        texel.y = textureSize(source, 0).y - 1 - texel.y;
+    }
+    raw = texelFetch(source, texel, 0);
+
+    vec2 uv = fragment_tex_coord;
+    if (weights.x <= 2.0 / 3.0)
+    {
+        color = (texture(source, uv + vec2(0.0, -tap_step.y)) +
+                 texture(source, uv + vec2(tap_step.x, tap_step.y * 0.5)) +
+                 texture(source, uv + vec2(-tap_step.x, tap_step.y * 0.5))) / 3.0;
+    }
+    else
+    {
+        vec2 dx = vec2(tap_step.x, 0.0);
+        vec2 dy = vec2(0.0, tap_step.y);
+        color = (texture(source, uv - dx - dy) + texture(source, uv + dx - dy) +
+                 texture(source, uv - dx + dy) + texture(source, uv + dx + dy)) * 0.25;
+    }
+}
+)";
+
+} // namespace
+
+auto DiffusionVariance(float scale) -> float
+{
+    if (!(scale > 1.0f))
+    {
+        return 0.0f;
+    }
+    // Bilinear re-sampling smooths by 1/6 render px² per frame; at scale s that is 1/(6 s²) reference
+    // px². Adding (s² - 1)/6 render px² makes s²/6 render px² = 1/6 reference px², MilkDrop's amount.
+    return (scale * scale - 1.0f) / 6.0f;
+}
+
+auto DiffusionKernelFor(float scale) -> DiffusionKernel
+{
+    DiffusionKernel kernel;
+    kernel.variance = std::min(DiffusionVariance(scale), MaxDiffusionVariance);
+    if (kernel.variance <= 0.0f) return kernel;
+    if (kernel.variance <= 2.0f / 3.0f)
+    {
+        const float a = 1.5f * kernel.variance;
+        kernel.tapCount = 3;
+        kernel.taps = {{{0.0f, -a}, {a, a * 0.5f}, {-a, a * 0.5f}, {0.0f, 0.0f}}};
+    }
+    else
+    {
+        // Second moment of a bilinear tap between n and n+1: n^2+(2n+1)*fraction.
+        const float near = std::floor(std::sqrt(kernel.variance));
+        const float a = near + (kernel.variance - near * near) / (2.0f * near + 1.0f);
+        kernel.tapCount = 4;
+        kernel.taps = {{{-a, -a}, {a, -a}, {-a, a}, {a, a}}};
+    }
+    return kernel;
+}
+
+auto DiffusionMotionVectorMinimum(float minimumLength, float scale, bool diffusionActive) -> float
+{
+    return diffusionActive ? minimumLength * std::max(1.0f, scale) : minimumLength;
+}
+
+auto DiffusionWarpEligible(const std::string& warpShader) -> bool
+{
+    // Tokenize only at preset load. Comments and identifier substrings must not create a gate.
+    std::vector<std::string> tokens;
+    for (size_t i = 0; i < warpShader.size();)
+    {
+        const auto ch = static_cast<unsigned char>(warpShader[i]);
+        if (std::isspace(ch)) { ++i; continue; }
+        if (warpShader.compare(i, 2, "//") == 0)
+        {
+            const auto end = warpShader.find('\n', i + 2);
+            i = end == std::string::npos ? warpShader.size() : end;
+            continue;
+        }
+        if (warpShader.compare(i, 2, "/*") == 0)
+        {
+            const auto end = warpShader.find("*/", i + 2);
+            i = end == std::string::npos ? warpShader.size() : end + 2;
+            continue;
+        }
+        size_t end = i + 1;
+        if (std::isalnum(ch) || ch == '_')
+        {
+            while (end < warpShader.size() &&
+                   (std::isalnum(static_cast<unsigned char>(warpShader[end])) || warpShader[end] == '_')) ++end;
+        }
+        else if ((ch == '+' || ch == '-') && end < warpShader.size() && warpShader[end] == '=') ++end;
+        std::string token = warpShader.substr(i, end - i);
+        std::transform(token.begin(), token.end(), token.begin(),
+                       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        tokens.push_back(std::move(token));
+        i = end;
+    }
+    const auto contains = [&tokens](std::initializer_list<const char*> pattern) {
+        if (pattern.size() > tokens.size()) return false;
+        for (size_t i = 0; i + pattern.size() <= tokens.size(); ++i)
+        {
+            size_t j = i;
+            bool matched = true;
+            for (const auto* token : pattern)
+            {
+                if (tokens[j++] != token) { matched = false; break; }
+            }
+            if (matched) return true;
+        }
+        return false;
+    };
+    bool pointFeedback = false;
+    for (const auto* sampler : {"sampler_pw_main", "sampler_pc_main"})
+        pointFeedback |= contains({"tex2d", "(", sampler, ","});
+    bool bilinearFeedback = contains({"getpixel", "("}) || contains({"getmain", "("});
+    for (const auto* sampler : {"sampler_main", "sampler_fc_main", "sampler_fw_main"})
+        bilinearFeedback |= contains({"tex2d", "(", sampler, ","});
+    // Point-only feedback loses no bilinear variance. A mixed warp still can: Acid Mandala's
+    // displaced GetPixel path needs compensation despite its point-sampled feedback branches.
+    if (pointFeedback && !bilinearFeedback) return false;
+    // A single source blur cannot preserve the explicitly undisplaced branch of a mixed warp.
+    if (contains({"getpixel", "(", "uv_orig", ")"}) ||
+        contains({"getmain", "(", "uv_orig", ")"})) return false;
+    for (const auto* sampler : {"sampler_main", "sampler_fc_main", "sampler_fw_main"})
+    {
+        if (contains({"tex2d", "(", sampler, ",", "uv_orig", ")"})) return false;
+    }
+    const bool peak = contains({"ret", "=", "max", "(", "ret", ","});
+    bool sharpen = false;
+    for (const auto* blur : {"getblur1", "getblur2", "getblur3"})
+    {
+        sharpen |= contains({"ret", "+=", "(", "ret", "-", blur, "("}) ||
+                   contains({"ret", "=", "ret", "+", "(", "ret", "-", blur, "("});
+    }
+    // max trails plus high-frequency positive feedback amplify any lost peaks (want).
+    return !(peak && sharpen);
+}
+
+FeedbackDiffusion::FeedbackDiffusion()
+{
+    std::string vertexShader(static_cast<const char*>(ShaderVersion));
+    std::string fragmentShader(static_cast<const char*>(ShaderVersion));
+    vertexShader.append(static_cast<const char*>(VertexShader));
+    fragmentShader.append(static_cast<const char*>(FragmentShader));
+
+    try
+    {
+        m_shader.CompileProgram(vertexShader, fragmentShader);
+    }
+    catch (const Renderer::ShaderException& error)
+    {
+        // Optional shader: retain CopyTexture's exact path if the driver rejects it.
+        std::fprintf(stderr, "projectM feedback diffusion disabled: %s\n", error.message().c_str());
+        return;
+    }
+    m_sourceLocation = m_shader.UniformLocation("source");
+    m_flipLocation = m_shader.UniformLocation("flip_vertical");
+    m_stepLocation = m_shader.UniformLocation("tap_step");
+    m_weightsLocation = m_shader.UniformLocation("weights");
+    RenderItem::Init();
+    m_framebuffer.CreateColorAttachment(0, RawAttachment);
+    m_framebuffer.CreateColorAttachment(0, FilteredAttachment);
+    m_usable = true;
+}
+
+void FeedbackDiffusion::InitVertexAttrib()
+{
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, sizeof(TexturedPoint), reinterpret_cast<void*>(offsetof(TexturedPoint, x)));
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, sizeof(TexturedPoint), reinterpret_cast<void*>(offsetof(TexturedPoint, u)));
+
+    // A full-screen quad, as in CopyTexture.
+    std::array<RenderItem::TexturedPoint, 4> points{};
+    constexpr std::array<std::array<float, 4>, 4> corners{{{-1.0f, 1.0f, 0.0f, 1.0f},
+                                                          {1.0f, 1.0f, 1.0f, 1.0f},
+                                                          {-1.0f, -1.0f, 0.0f, 0.0f},
+                                                          {1.0f, -1.0f, 1.0f, 0.0f}}};
+    for (size_t i = 0; i < points.size(); i++)
+    {
+        points[i].x = corners[i][0];
+        points[i].y = corners[i][1];
+        points[i].u = corners[i][2];
+        points[i].v = corners[i][3];
+    }
+
+    glBufferData(GL_ARRAY_BUFFER, sizeof(points), points.data(), GL_STATIC_DRAW);
+}
+
+auto FeedbackDiffusion::SetScale(float scale) -> bool
+{
+    if (scale == m_scale)
+    {
+        return false;
+    }
+    m_scale = scale;
+    m_kernel = DiffusionKernelFor(scale);
+    if (m_usable && !m_warnedScaleCap && DiffusionVariance(scale) > MaxDiffusionVariance)
+    {
+        // Q2: clamp extreme scales rather than add another full-screen pass. Warn once per preset.
+        std::fprintf(stderr, "projectM feedback diffusion: scale %.3f exceeds kernel range; variance capped at %.2f px^2\n",
+                     scale, MaxDiffusionVariance);
+        m_warnedScaleCap = true;
+    }
+    return true;
+}
+
+auto FeedbackDiffusion::Active() const -> bool
+{
+    return m_usable && m_kernel.variance > 0.0f;
+}
+
+void FeedbackDiffusion::Draw(const std::shared_ptr<Renderer::Texture>& source, bool flipVertical)
+{
+    if (!Active() || source == nullptr || source->Empty() || source == Texture() || source == RawTexture())
+    {
+        return;
+    }
+
+    m_framebuffer.SetSize(source->Width(), source->Height());
+    m_framebuffer.Bind(0);
+
+    // Filtering overwrites the target. Inherited alpha blending would multiply RGBA
+    // source colours by alpha a second time and retain unrelated target history.
+    glDisable(GL_BLEND);
+
+    // The pass covers the whole target: without blending its old contents are never read, so
+    // tile-based GPUs can skip loading them (as in CopyTexture).
+    if (!glIsEnabled(GL_BLEND))
+    {
+        const GLenum attachments[] = {GL_COLOR_ATTACHMENT0 + RawAttachment, GL_COLOR_ATTACHMENT0 + FilteredAttachment};
+        glInvalidateFramebuffer(GL_DRAW_FRAMEBUFFER, 2, attachments);
+    }
+
+    source->Bind(0);
+    m_sampler.Bind(0);
+
+    m_shader.Bind();
+    glUniform1i(m_sourceLocation, 0);
+    glUniform1i(m_flipLocation, flipVertical ? 1 : 0);
+    glUniform2f(m_stepLocation, m_kernel.taps[1].x / static_cast<float>(source->Width()),
+                             -m_kernel.taps[0].y / static_cast<float>(source->Height()));
+    glUniform2f(m_weightsLocation, m_kernel.variance, 0.0f);
+
+    glBindVertexArray(m_vaoID);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+
+    glBindTexture(GL_TEXTURE_2D, 0);
+    Renderer::Sampler::Unbind(0);
+    Renderer::Shader::Unbind();
+    Renderer::Framebuffer::Unbind();
+}
+
+auto FeedbackDiffusion::Texture() const -> std::shared_ptr<Renderer::Texture>
+{
+    return m_framebuffer.GetColorAttachmentTexture(0, FilteredAttachment);
+}
+
+auto FeedbackDiffusion::RawTexture() const -> std::shared_ptr<Renderer::Texture>
+{
+    return m_framebuffer.GetColorAttachmentTexture(0, RawAttachment);
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
diff --git a/src/libprojectM/MilkdropPreset/FeedbackDiffusion.hpp b/src/libprojectM/MilkdropPreset/FeedbackDiffusion.hpp
new file mode 100644
index 000000000..79a7e1d66
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/FeedbackDiffusion.hpp
@@ -0,0 +1,138 @@
+/**
+ * @file FeedbackDiffusion.hpp
+ * @brief Restores MilkDrop's per-frame feedback smoothing, in picture units, at render sizes above the reference.
+ *
+ * Every frame the warp re-samples the previous frame bilinearly at displaced coordinates. Bilinear
+ * re-sampling at a sub-texel offset f spreads each texel over its neighbours with a variance of
+ * f * (1 - f) texel² per axis, 1/6 texel² on average over random offsets. Feedback presets are
+ * tuned to that smoothing: it is the diffusion term of the reaction-diffusion-like systems many of
+ * them are (gradient-advection warps with decay near 1 settle into patterns whose size depends on it).
+ *
+ * The smoothing is per *render* texel. At a render size s times the reference's in each direction
+ * (s = sqrt(render area / reference area)), it is s² times smaller in picture units: at 3840x2160
+ * against MilkDrop's 1024x768 that is 10.5x less diffusion, and some presets settle into different
+ * patterns. Adding a blur of variance (s² - 1) / 6 render px² per axis to the feedback image once per
+ * frame makes the total per-frame diffusion s² / 6 render px² = 1/6 reference px², as at the reference.
+ *
+ * Off (no pass, frames unchanged) without a line reference size or at or below the reference area.
+ *
+ * The pass writes two images at once (multiple render targets): the exact y-flipped frame and its
+ * filtered copy. Only bilinear warp reads get the filtered copy. Point-sampled warp reads
+ * (sampler_pw_main, sampler_pc_main and their aliases) and the composite get the exact frame, as
+ * at the reference size, where point sampling and the composite add no smoothing. Encoded state in
+ * colour channels read through point samplers therefore survives unchanged.
+ *
+ * Placement: the pass replaces the required end-of-frame y-flip, and its two images are next
+ * frame's warp inputs. New motion vectors change the raw previous canvas and trigger a
+ * recomputation before the warp. Either way a frame has the same number of full-screen passes as
+ * without compensation, with one extra colour target written per pass.
+ *
+ * Limits: the variance is uniform. MilkDrop's bilinear smoothing is 1/6 texel² only on average; where
+ * the warp does not move the image (or moves it by whole texels) it smooths nothing, and the kernel
+ * still adds its share there. The blur textures are still made from the unfiltered frame.
+ */
+#pragma once
+
+#include <Renderer/Framebuffer.hpp>
+#include <Renderer/RenderItem.hpp>
+#include <Renderer/Sampler.hpp>
+#include <Renderer/Shader.hpp>
+
+#include <array>
+#include <memory>
+#include <string>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+/** One bilinear tap, in source texels relative to the destination's texel center. */
+struct DiffusionTap { float x{0.0f}; float y{0.0f}; };
+
+/** Equal-weight 3/4-tap stencil with zero mean/covariance and the required per-axis variance. */
+struct DiffusionKernel
+{
+    std::array<DiffusionTap, 4> taps{};
+    int tapCount{0};          //!< Zero: no pass. Otherwise each tap weighs 1/tapCount.
+    float variance{0.0f};     //!< Added variance per axis, including bilinear interpolation.
+};
+
+/**
+ * @brief The variance wanted per axis: (scale² - 1) / 6 render px², 0 for scale <= 1.
+ * @param scale Render size over reference size, linear (LineScale()).
+ */
+auto DiffusionVariance(float scale) -> float;
+
+/**
+ * Construct an exact-moment stencil. For V <= 2/3, three taps at (0,-a), (+/-a,a/2),
+ * a=3V/2, add V on each axis through their bilinear split. Above that, four diagonal
+ * taps use n+(V-n*n)/(2n+1), n=floor(sqrt(V)). Both have zero mean and xy covariance.
+ * Higher moments differ from a Gaussian; fidelity and GPU cost determine this choice.
+ * Cap V at MaxDiffusionVariance for unverified extreme scales.
+ */
+auto DiffusionKernelFor(float scale) -> DiffusionKernel;
+
+/** Keep the reference's minimum vector length only while diffusion is actually usable. */
+auto DiffusionMotionVectorMinimum(float minimumLength, float scale, bool diffusionActive) -> float;
+
+/** Conservative load-time gate for point reads and combined peak/sharpening feedback. */
+auto DiffusionWarpEligible(const std::string& warpShader) -> bool;
+
+constexpr float MaxDiffusionVariance = 1.9f; //!< Largest verified variance (scale approximately 3.52).
+
+/**
+ * @brief Draws the feedback image, optionally y-flipped, into an exact copy and a filtered copy in one pass.
+ *
+ * Replaces the end-of-frame CopyTexture flip; both results are cached for the next warp.
+ */
+class FeedbackDiffusion : public Renderer::RenderItem
+{
+public:
+    FeedbackDiffusion();
+
+    void InitVertexAttrib() override;
+
+    /**
+     * @brief Sets the kernel for this render/reference scale.
+     * @return True when the scale changed; invalidate a cached filtered image before using it.
+     * @param scale LineScale() of the render and reference sizes; 0 or <= 1 turn the pass off.
+     */
+    auto SetScale(float scale) -> bool;
+
+    /**
+     * @brief True if SetScale() got a scale above 1, i.e. the frame needs the diffusion pass.
+     */
+    auto Active() const -> bool;
+
+    /**
+     * @brief Copies source into RawTexture() and draws it through the kernel into Texture(), resizing both.
+     * @param source The feedback image. Must not be Texture() or RawTexture().
+     * @param flipVertical Flip the image on the y axis, as CopyTexture does for the warp's input.
+     */
+    void Draw(const std::shared_ptr<Renderer::Texture>& source, bool flipVertical);
+
+    /**
+     * @brief The last filtered image drawn: the input of bilinear warp reads.
+     */
+    auto Texture() const -> std::shared_ptr<Renderer::Texture>;
+
+    /**
+     * @brief The last image drawn, copied exactly: the input of point-sampled warp reads and the composite.
+     */
+    auto RawTexture() const -> std::shared_ptr<Renderer::Texture>;
+
+private:
+    static constexpr int RawAttachment = 0;      //!< Fragment output location 0.
+    static constexpr int FilteredAttachment = 1; //!< Fragment output location 1.
+
+    Renderer::Shader m_shader;                                //!< Exact copy plus adaptive 3/4-tap stencil.
+    Renderer::Framebuffer m_framebuffer{1};                   //!< Holds the raw and filtered textures.
+    Renderer::Sampler m_sampler{GL_CLAMP_TO_EDGE, GL_LINEAR}; //!< Bilinear taps; edges repeat.
+    DiffusionKernel m_kernel;                                 //!< Current kernel.
+    bool m_usable{false};                                    //!< False after shader compile/link failure.
+    bool m_warnedScaleCap{false};                            //!< Extreme-scale warning emitted once.
+    GLint m_sourceLocation{-1}, m_flipLocation{-1}, m_stepLocation{-1}, m_weightsLocation{-1};
+    float m_scale{0.0f};                                      //!< Scale of m_kernel.
+};
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
