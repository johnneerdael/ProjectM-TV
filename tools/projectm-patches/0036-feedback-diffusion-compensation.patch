+TEST(FeedbackDiffusion, AdaptiveBoundaryKeepsTheSameVarianceAndZeroCovariance)
+{
+    for (float variance : {0.001f, 0.1f, 0.5f, 0.615f, 2.0f/3.0f - 1e-5f, 2.0f/3.0f + 1e-5f, 1.0f, 1.9f})
+    {
+        const auto kernel = DiffusionKernelFor(std::sqrt(1.0f + 6.0f * variance));
+        EXPECT_NEAR(TexelVariance(kernel), variance, 1e-4f);
+        EXPECT_NEAR(TexelVariance(kernel, true), variance, 1e-4f);
+        double meanX = 0.0, meanY = 0.0, covariance = 0.0;
+        for (int i = 0; i < kernel.tapCount; ++i)
+        {
+            const auto& tap = kernel.taps[static_cast<size_t>(i)];
+            meanX += tap.x / kernel.tapCount; meanY += tap.y / kernel.tapCount;
+            covariance += tap.x * tap.y / kernel.tapCount;
+        }
+        EXPECT_NEAR(meanX, 0.0, 1e-6);
+        EXPECT_NEAR(meanY, 0.0, 1e-6);
+        EXPECT_NEAR(covariance, 0.0, 1e-6);
+    }
+}
