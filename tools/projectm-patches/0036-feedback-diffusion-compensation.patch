diff --git a/tests/libprojectM/FeedbackDiffusionRenderTest.cpp b/tests/libprojectM/FeedbackDiffusionRenderTest.cpp
new file mode 100644
index 000000000..1d5dacb9e
--- /dev/null
+++ b/tests/libprojectM/FeedbackDiffusionRenderTest.cpp
@@ -0,0 +1,230 @@
+#include <ProjectM.hpp>
+#include <Renderer/Shader.hpp>
+#include <projectM-opengl.h>
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+// Feedback diffusion filters only the bilinear warp input. Point-sampled warp reads and the
+// composite must see the same texels as with compensation off at the same reference size.
+// (The reference size also changes texsize and the canvas the preset sees, so the comparisons keep
+// it and turn compensation off through the load-time gate instead: an explicitly undisplaced
+// GetPixel(uv_orig) read, multiplied by zero, makes a warp ineligible without changing its result.)
+
+namespace {
+
+constexpr int Width = 128;
+constexpr int Height = 96;
+using Image = std::vector<uint8_t>;
+
+class TestProjectM : public libprojectM::ProjectM
+{
+public:
+    mutable std::string failure;
+    void PresetSwitchFailedEvent(const std::string&, const std::string& reason) const override
+    {
+        failure = reason;
+    }
+};
+
+// Two-texel stripes: added smoothing changes them. Literal sizes, as texsize reports the reference
+// canvas above the reference area. (The composite samples between texels: one-texel stripes would
+// average to a flat grey.)
+constexpr char Seed[] = "float3(frac(floor(uv.x*64.0)*0.5)*2.0, frac(floor(uv.y*48.0)*0.5)*2.0, uv.x)";
+constexpr char Ineligible[] = " + GetPixel(uv_orig).rgb*0.0";
+
+// A shader composite: the old-school one adds time-dependent random hues.
+auto Preset(const std::string& warp, const std::string& comp = "tex2D(sampler_main, uv).rgb") -> std::string
+{
+    return "MILKDROP_PRESET_VERSION=201\nPSVERSION_WARP=3\nPSVERSION_COMP=3\n"
+           "[preset00]\nfDecay=1\nfGammaAdj=1\nfWaveAlpha=0\nbTexWrap=1\nfVideoEchoAlpha=0\n"
+           "fWarpAnimSpeed=1\nfWarpScale=1\nfZoomExponent=1\nzoom=1\nwarp=0\nrot=0\nfShader=0\n"
+           "warp_1=`shader_body { " + warp + " }\n"
+           "comp_1=`shader_body { ret = " + comp + "; }\n";
+}
+
+// Frames 0 and 1 seed the feedback; frame 2 reads it.
+auto FeedbackPreset(const std::string& read) -> std::string
+{
+    return Preset(std::string("if (frame < 2) ret = ") + Seed + "; else ret = " + read + ";");
+}
+
+auto DifferentBytes(const Image& a, const Image& b) -> size_t
+{
+    size_t different{};
+    for (size_t i = 0; i < std::min(a.size(), b.size()); ++i)
+    {
+        different += a[i] != b[i];
+    }
+    return different;
+}
+
+} // namespace
+
+class FeedbackDiffusionRenderTest : public ::testing::Test
+{
+protected:
+    static void SetUpTestSuite()
+    {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attributes[] = {
+            kCGLPFAOpenGLProfile, static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+            static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj format{};
+        GLint count{};
+        if (CGLChoosePixelFormat(attributes, &format, &count) != kCGLNoError || format == nullptr)
+        {
+            return;
+        }
+        CGLCreateContext(format, nullptr, &s_context);
+        CGLDestroyPixelFormat(format);
+#endif
+    }
+
+    static void TearDownTestSuite()
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            CGLSetCurrentContext(nullptr);
+            CGLDestroyContext(s_context);
+            s_context = nullptr;
+        }
+#endif
+    }
+
+    void SetUp() override
+    {
+#ifdef __APPLE__
+        if (s_context == nullptr)
+        {
+            GTEST_SKIP() << "no macOS CGL OpenGL context";
+        }
+        ASSERT_EQ(CGLSetCurrentContext(s_context), kCGLNoError);
+        libprojectM::Renderer::Shader::Unbind();
+        glGenFramebuffers(1, &m_framebuffer);
+        glGenTextures(1, &m_texture);
+        glBindTexture(GL_TEXTURE_2D, m_texture);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, Width, Height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+        ASSERT_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        ASSERT_EQ(glGetError(), GL_NO_ERROR);
+#else
+        GTEST_SKIP() << "render regression needs a macOS CGL OpenGL context";
+#endif
+    }
+
+    void TearDown() override
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            libprojectM::Renderer::Shader::Unbind();
+            glDeleteFramebuffers(1, &m_framebuffer);
+            glDeleteTextures(1, &m_texture);
+        }
+#endif
+    }
+
+    // referenceWidth/Height 0 turn compensation off; 64x48 gives scale 2 (three taps),
+    // 32x24 scale 4 (four taps, capped variance).
+    auto Render(const std::string& preset, int referenceWidth, int referenceHeight) -> Image
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        TestProjectM engine;
+        engine.SetWindowSize(Width, Height);
+        engine.SetMeshSize(48, 32);
+        engine.SetPresetLocked(true);
+        engine.SetHardCutEnabled(false);
+        engine.SetEasterEgg(0);
+        engine.SetLineReferenceSize(referenceWidth, referenceHeight);
+        std::istringstream data(preset);
+        engine.LoadPresetData(data, false);
+        EXPECT_TRUE(engine.failure.empty()) << engine.failure;
+        for (int frame = 0; frame < 3; ++frame)
+        {
+            engine.RenderFrame(m_framebuffer);
+        }
+        Image pixels(Width * Height * 3);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glReadPixels(0, 0, Width, Height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(glGetError(), GL_NO_ERROR);
+        EXPECT_GT(*std::max_element(pixels.begin(), pixels.end()), 200) << "fixture did not render";
+        return pixels;
+    }
+
+#ifdef __APPLE__
+    static CGLContextObj s_context;
+#endif
+    GLuint m_framebuffer{};
+    GLuint m_texture{};
+};
+
+#ifdef __APPLE__
+CGLContextObj FeedbackDiffusionRenderTest::s_context{};
+#endif
+
+constexpr std::pair<int, int> References[] = {{64, 48}, {32, 24}}; // Scale 2 (three taps), 4 (four taps, capped).
+
+TEST_F(FeedbackDiffusionRenderTest, BilinearFeedbackIsStillCompensated)
+{
+    // Guards the fixture: the gated variant really turns the filter off, and these sizes activate it.
+    for (const auto& reference : References)
+    {
+        SCOPED_TRACE(reference.first);
+        const auto active = Render(FeedbackPreset("GetPixel(uv).rgb"), reference.first, reference.second);
+        const auto off = Render(FeedbackPreset(std::string("GetPixel(uv).rgb") + Ineligible), reference.first, reference.second);
+        EXPECT_GT(DifferentBytes(active, off), 0u);
+        EXPECT_EQ(DifferentBytes(off, Render(FeedbackPreset(std::string("GetPixel(uv).rgb") + Ineligible),
+                                             reference.first, reference.second)), 0u) << "fixture must repeat exactly";
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, PointSampledFeedbackReadsUnfilteredTexels)
+{
+    // The GetPixel term keeps the warp eligible for compensation (a mixed warp); it adds nothing.
+    for (const char* name : {"pw_main", "wp_main", "pc_main", "cp_main"})
+    {
+        SCOPED_TRACE(name);
+        const std::string read = std::string("tex2D(sampler_") + name + ", uv).rgb";
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            const auto active = Render(FeedbackPreset(read + " + GetPixel(uv).rgb*0.0"), reference.first, reference.second);
+            const auto off = Render(FeedbackPreset(read + Ineligible), reference.first, reference.second);
+            EXPECT_EQ(DifferentBytes(active, off), 0u);
+        }
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, CompositeReadsTheUnfilteredFrame)
+{
+    // The warp does not read feedback, so only the composite could see the filter.
+    for (const char* comp : {"tex2D(sampler_main, uv).rgb", "tex2D(sampler_pc_main, uv).rgb"})
+    {
+        SCOPED_TRACE(comp);
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            const auto active = Render(Preset(std::string("ret = ") + Seed + ";", comp), reference.first, reference.second);
+            const auto off = Render(Preset(std::string("ret = ") + Seed + Ineligible + ";", comp),
+                                    reference.first, reference.second);
+            EXPECT_EQ(DifferentBytes(active, off), 0u);
+        }
+    }
+}
