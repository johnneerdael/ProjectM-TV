+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+// Above the reference area the warp's bilinear main reads reproduce the reference-size read at their own
+// phase (FeedbackDiffusion.hpp). Reads on reference texel centres (identity, whole reference texels) stay
+// plain, so they must equal point reads; a half-texel read must average the two reference neighbours.
+// Literal offsets in canvas units (1/64 x 1/48 at scale 2) keep the fixtures independent of texsize.
+
+namespace {
+
+constexpr int Width = 128;
+constexpr int Height = 96;
+using Image = std::vector<uint8_t>;
+
+class TestProjectM : public libprojectM::ProjectM
+{
+public:
+    mutable std::string failure;
+    void PresetSwitchFailedEvent(const std::string&, const std::string& reason) const override
+    {
+        failure = reason;
+    }
+};
+
+// Two-texel stripes: added smoothing changes them. Literal sizes, as texsize reports the reference
+// canvas above the reference area. (The composite samples between texels: one-texel stripes would
+// average to a flat grey.)
+constexpr char Seed[] = "float3(frac(floor(uv.x*64.0)*0.5)*2.0, frac(floor(uv.y*48.0)*0.5)*2.0, uv.x)";
+
+// A shader composite: the old-school one adds time-dependent random hues.
+auto Preset(const std::string& warp, const std::string& comp = "tex2D(sampler_main, uv).rgb", const char* zoom = "1") -> std::string
+{
+    return std::string("MILKDROP_PRESET_VERSION=201\nPSVERSION_WARP=3\nPSVERSION_COMP=3\n"
+           "[preset00]\nfDecay=1\nfGammaAdj=1\nfWaveAlpha=0\nbTexWrap=1\nfVideoEchoAlpha=0\n"
+           "fWarpAnimSpeed=1\nfWarpScale=1\nfZoomExponent=1\nzoom=") + zoom + "\nwarp=0\nrot=0\nfShader=0\n" +
+           (warp.empty() ? std::string() : "warp_1=`shader_body { " + warp + " }\n") +
+           "comp_1=`shader_body { ret = " + comp + "; }\n";
+}
+
+// Frames 0 and 1 seed the feedback; frame 2 reads it.
+auto FeedbackPreset(const std::string& read, const char* zoom = "1") -> std::string
+{
+    return Preset(std::string("if (frame < 2) ret = ") + Seed + "; else ret = " + read + ";", "tex2D(sampler_main, uv).rgb", zoom);
+}
+
+auto DifferentBytes(const Image& a, const Image& b) -> size_t
+{
+    size_t different{};
+    for (size_t i = 0; i < std::min(a.size(), b.size()); ++i)
+    {
+        different += a[i] != b[i];
+    }
+    return different;
+}
+
+auto AbsoluteDifference(const Image& a, const Image& b) -> size_t
+{
+    size_t total{};
+    for (size_t i = 0; i < std::min(a.size(), b.size()); ++i)
+    {
+        total += static_cast<size_t>(std::abs(static_cast<int>(a[i]) - static_cast<int>(b[i])));
+    }
+    return total;
+}
+
+} // namespace
+
+class FeedbackDiffusionRenderTest : public ::testing::Test
+{
+protected:
+    static void SetUpTestSuite()
+    {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attributes[] = {
+            kCGLPFAOpenGLProfile, static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+            static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj format{};
+        GLint count{};
+        if (CGLChoosePixelFormat(attributes, &format, &count) != kCGLNoError || format == nullptr)
+        {
+            return;
+        }
+        CGLCreateContext(format, nullptr, &s_context);
+        CGLDestroyPixelFormat(format);
+#endif
+    }
+
+    static void TearDownTestSuite()
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            CGLSetCurrentContext(nullptr);
+            CGLDestroyContext(s_context);
+            s_context = nullptr;
+        }
+#endif
+    }
+
+    void SetUp() override
+    {
+#ifdef __APPLE__
+        if (s_context == nullptr)
+        {
+            GTEST_SKIP() << "no macOS CGL OpenGL context";
+        }
+        ASSERT_EQ(CGLSetCurrentContext(s_context), kCGLNoError);
+        libprojectM::Renderer::Shader::Unbind();
+        glGenFramebuffers(1, &m_framebuffer);
+        glGenTextures(1, &m_texture);
+        glBindTexture(GL_TEXTURE_2D, m_texture);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, Width, Height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+        ASSERT_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        ASSERT_EQ(glGetError(), GL_NO_ERROR);
+#else
+        GTEST_SKIP() << "render regression needs a macOS CGL OpenGL context";
+#endif
+    }
+
+    void TearDown() override
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            libprojectM::Renderer::Shader::Unbind();
+            glDeleteFramebuffers(1, &m_framebuffer);
+            glDeleteTextures(1, &m_texture);
+        }
+#endif
+    }
+
+    // referenceWidth/Height 0 turn the footprint off; 64x48 gives scale 2, 32x24 scale 4.
+    auto Render(const std::string& preset, int referenceWidth, int referenceHeight, int frames = 3) -> Image
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        TestProjectM engine;
+        engine.SetWindowSize(Width, Height);
+        engine.SetMeshSize(48, 32);
+        engine.SetPresetLocked(true);
+        engine.SetHardCutEnabled(false);
+        engine.SetEasterEgg(0);
+        engine.SetLineReferenceSize(referenceWidth, referenceHeight);
+        std::istringstream data(preset);
+        engine.LoadPresetData(data, false);
+        EXPECT_TRUE(engine.failure.empty()) << engine.failure;
+        for (int frame = 0; frame < frames; ++frame)
+        {
+            engine.RenderFrame(m_framebuffer);
+        }
+        Image pixels(Width * Height * 3);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glReadPixels(0, 0, Width, Height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(glGetError(), GL_NO_ERROR);
+        EXPECT_GT(*std::max_element(pixels.begin(), pixels.end()), 200) << "fixture did not render";
+        return pixels;
+    }
+
+#ifdef __APPLE__
+    static CGLContextObj s_context;
+#endif
+    GLuint m_framebuffer{};
+    GLuint m_texture{};
+};
+
+#ifdef __APPLE__
+CGLContextObj FeedbackDiffusionRenderTest::s_context{};
+#endif
+
+constexpr std::pair<int, int> References[] = {{64, 48}, {32, 24}}; // Scale 2 and 4.
+
+TEST_F(FeedbackDiffusionRenderTest, IdentityAndWholeTexelReadsStayPlain)
+{
+    for (const char* offset : {"float2(0, 0)", "float2(1.0/64.0, -2.0/48.0)"})
+    {
+        SCOPED_TRACE(offset);
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            // Whole canvas texels at scale 2 are whole native texels; at scale 4 the canvas is 32x24, so
+            // 1/64 is half a canvas texel: compare only at the reference the offset is whole for.
+            if (reference.first == 32 && std::string(offset) != "float2(0, 0)")
+            {
+                continue;
+            }
+            const std::string at = std::string("uv + ") + offset;
+            EXPECT_EQ(DifferentBytes(Render(FeedbackPreset("GetPixel(" + at + ").rgb"), reference.first, reference.second),
+                                     Render(FeedbackPreset("tex2D(sampler_pw_main, " + at + ").rgb"), reference.first, reference.second)),
+                      0u);
+        }
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, HalfTexelReadApproachesTheReferenceNeighbourAverage)
+{
+    // Scale 2: MilkDrop reads half a canvas texel as the 50/50 blend of two texels one canvas texel (two
+    // native texels) apart. The footprint keeps that read's mean and variance; its taps are pulled in a
+    // quarter native texel to keep native pixels coupled, so it is close to, not identical with, the mean
+    // of two point reads, and far closer to it than the plain read without a reference.
+    const auto read = FeedbackPreset("GetPixel(uv + float2(0.5/64.0, 0)).rgb");
+    const auto expected = Render(FeedbackPreset("(tex2D(sampler_pw_main, uv) + tex2D(sampler_pw_main, uv + float2(1.0/64.0, 0))).rgb*0.5"), 64, 48);
+    const auto footprint = AbsoluteDifference(Render(read, 64, 48), expected);
+    const auto plain = AbsoluteDifference(Render(read, 0, 0), expected);
+    EXPECT_GT(plain, 0u);
+    EXPECT_LT(footprint * 4, plain);
+}
+
+TEST_F(FeedbackDiffusionRenderTest, DisplacedWarpsAreCompensatedIncludingTheDefaultWarp)
+{
+    // A zooming mesh puts reads at fractional reference phases; the preset and the default warp shader
+    // both get the footprint. Identity default warps stay plain.
+    for (const auto& reference : References)
+    {
+        SCOPED_TRACE(reference.first);
+        EXPECT_GT(DifferentBytes(Render(FeedbackPreset("GetPixel(uv).rgb", "0.93"), reference.first, reference.second),
+                                 Render(FeedbackPreset("tex2D(sampler_pw_main, uv).rgb", "0.93"), reference.first, reference.second)),
+                  0u);
+        // Default warp: a borderless filled shape (no lines, which scale with the reference) seeds trails.
+        for (const char* zoom : {"1", "0.93"})
+        {
+            SCOPED_TRACE(zoom);
+            auto preset = Preset("", "tex2D(sampler_main, uv).rgb", zoom);
+            preset += "shapecode_0_enabled=1\nshapecode_0_sides=4\nshapecode_0_rad=0.1\nshapecode_0_x=0.3\n"
+                      "shapecode_0_y=0.55\nshapecode_0_r=1\nshapecode_0_g=0.6\nshapecode_0_b=0.2\nshapecode_0_a=1\n"
+                      "shapecode_0_r2=1\nshapecode_0_g2=0.6\nshapecode_0_b2=0.2\nshapecode_0_a2=1\nshapecode_0_border_a=0\n";
+            const auto different = DifferentBytes(Render(preset, reference.first, reference.second, 8), Render(preset, 0, 0, 8));
+            if (std::string(zoom) == "1")
+            {
+                EXPECT_EQ(different, 0u) << "an identity default warp must stay plain";
+            }
+            else
+            {
+                EXPECT_GT(different, 0u);
+            }
+        }
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, ReadsAtStoredCoordinatesStayPlain)
+{
+    // The coordinate comes from the frame's own colour (Royal Mashup (255) style): no footprint, so the
+    // result does not depend on the reference size. The seed's blue channel holds uv.x, the read is at
+    // (blue, green) shifted by a third of a native texel to make the plain bilinear blend visible.
+    const auto preset = FeedbackPreset("GetPixel(tex2D(sampler_pc_main, uv_orig).bg + float2(1.0/384.0, 0)).rgb");
+    for (const auto& reference : References)
+    {
+        SCOPED_TRACE(reference.first);
+        EXPECT_EQ(DifferentBytes(Render(preset, reference.first, reference.second), Render(preset, 0, 0)), 0u);
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, PointSampledFeedbackReadsUnfilteredTexels)
+{
+    // The GetPixel term keeps a bilinear read in the warp (it is rewritten); it adds nothing.
+    for (const char* name : {"pw_main", "wp_main", "pc_main", "cp_main"})
+    {
+        SCOPED_TRACE(name);
+        const std::string read = std::string("tex2D(sampler_") + name + ", uv + float2(0.5/64.0, 0.25/48.0)).rgb + GetPixel(uv*0.97).rgb*0.0";
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            EXPECT_EQ(DifferentBytes(Render(FeedbackPreset(read), reference.first, reference.second),
+                                     Render(FeedbackPreset(read), 0, 0)), 0u);
+        }
+    }
+}
+
+TEST_F(FeedbackDiffusionRenderTest, CompositeReadsTheUnfilteredFrame)
+{
+    // The warp does not read feedback, so only the composite could see a footprint.
+    for (const char* comp : {"tex2D(sampler_main, uv + float2(0.5/64.0, 0)).rgb", "tex2D(sampler_pc_main, uv).rgb"})
+    {
+        SCOPED_TRACE(comp);
+        for (const auto& reference : References)
+        {
+            SCOPED_TRACE(reference.first);
+            EXPECT_EQ(DifferentBytes(Render(Preset(std::string("ret = ") + Seed + ";", comp), reference.first, reference.second),
+                                     Render(Preset(std::string("ret = ") + Seed + ";", comp), 0, 0)), 0u);
+        }
+    }
+}
