--- /dev/null
+++ b/tests/libprojectM/FeedbackDiffusionTest.cpp
@@ -0,0 +1,303 @@
+#include <MilkdropPreset/FeedbackDiffusion.hpp>
+#include <MilkdropPreset/LineGeometry.hpp>
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+
+using libprojectM::MilkdropPreset::DiffusionKernelFor;
+using libprojectM::MilkdropPreset::DiffusionVariance;
+using libprojectM::MilkdropPreset::LineScale;
+using libprojectM::MilkdropPreset::MaxDiffusionVariance;
+
+namespace {
+
+// Actual second moment of the sampled texels, including each tap's bilinear split.
+auto TexelVariance(const libprojectM::MilkdropPreset::DiffusionKernel& kernel, bool yAxis = false) -> float
+{
+    double variance = 0.0;
+    for (int i = 0; i < kernel.tapCount; ++i)
+    {
+        const auto& tap = kernel.taps[static_cast<size_t>(i)];
+        const double position = yAxis ? tap.y : tap.x;
+        const double near = std::floor(position);
+        const double fraction = position - near;
+        variance += ((1.0 - fraction) * near * near + fraction * (near + 1.0) * (near + 1.0)) / kernel.tapCount;
+    }
+    return static_cast<float>(variance);
+}
+
+} // namespace
+
+TEST(FeedbackDiffusion, OffWithoutReferenceOrAtOrBelowIt)
+{
+    EXPECT_EQ(DiffusionVariance(0.0f), 0.0f);
+    EXPECT_EQ(DiffusionVariance(1.0f), 0.0f);
+    EXPECT_EQ(DiffusionKernelFor(0.0f).variance, 0.0f);
+    EXPECT_EQ(DiffusionKernelFor(1.0f).tapCount, 0);
+    EXPECT_EQ(DiffusionKernelFor(LineScale(1024, 768, 1024, 768)).variance, 0.0f);
+    EXPECT_EQ(DiffusionKernelFor(LineScale(960, 540, 1024, 768)).variance, 0.0f);
+}
+
+TEST(FeedbackDiffusion, AddsTheMissingVariance)
+{
+    for (const auto& size : {std::make_pair(1920, 1080), std::make_pair(2560, 1440), std::make_pair(3840, 2160)})
+    {
+        const float scale = LineScale(size.first, size.second, 1024, 768);
+        const auto kernel = DiffusionKernelFor(scale);
+        // (s² - 1) / 6 render px²: with the warp's own 1/6 px², 1/6 reference px² per frame.
+        const float wanted = (scale * scale - 1.0f) / 6.0f;
+        EXPECT_NEAR(kernel.variance, wanted, 1e-5f);
+        EXPECT_NEAR(TexelVariance(kernel), wanted, 1e-4f);
+        EXPECT_NEAR(TexelVariance(kernel, true), wanted, 1e-4f);
+        EXPECT_GE(kernel.tapCount, 3);
+        EXPECT_LE(kernel.tapCount, 4);
+        double sum = 0.0, meanX = 0.0, meanY = 0.0, covariance = 0.0;
+        for (int i = 0; i < kernel.tapCount; ++i)
+        {
+            const auto& tap = kernel.taps[static_cast<size_t>(i)];
+            const double weight = 1.0 / kernel.tapCount;
+            sum += weight; meanX += weight*tap.x; meanY += weight*tap.y;
+            covariance += weight*tap.x*tap.y;
+        }
+        EXPECT_NEAR(sum, 1.0, 1e-6);
+        EXPECT_NEAR(meanX, 0.0, 1e-6);
+        EXPECT_NEAR(meanY, 0.0, 1e-6);
+        EXPECT_NEAR(covariance, 0.0, 1e-6);
+    }
+    // 3840x2160 at 1024x768: s = 3.25, 1.59 px².
+    EXPECT_NEAR(DiffusionKernelFor(LineScale(3840, 2160, 1024, 768)).variance, 1.591f, 1e-3f);
+}
+
+TEST(FeedbackDiffusion, CappedForVeryLargeScales)
+{
+    const auto kernel = DiffusionKernelFor(6.5f);
+    EXPECT_FLOAT_EQ(kernel.variance, MaxDiffusionVariance);
+    EXPECT_NEAR(TexelVariance(kernel), MaxDiffusionVariance, 1e-4f);
+}
+
+TEST(FeedbackDiffusion, MotionMinimumScalesOnlyWithUsableCompensation)
+{
+    using libprojectM::MilkdropPreset::DiffusionMotionVectorMinimum;
+    constexpr float minimum = 0.002f;
+    for (float scale : {0.0f, 0.5f, 1.0f, 2.0f, 3.25f})
+    {
+        EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, scale, false), minimum);
+    }
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 0.0f, true), minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 1.0f, true), minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 2.0f, true), 2.0f * minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 3.25f, true), 3.25f * minimum);
+}
