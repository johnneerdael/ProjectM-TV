--- /dev/null
+++ b/tests/libprojectM/FeedbackDiffusionTest.cpp
@@ -0,0 +1,274 @@
+#include <MilkdropPreset/FeedbackDiffusion.hpp>
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+
+#include <string>
+
+using libprojectM::MilkdropPreset::DiffusionFootprintShader;
+
+namespace {
+
+// The shape of a translated warp shader: inputs, uniforms, a preset function, then the entry point.
+constexpr char Warp[] = R"(#version 330
+in vec4 frag_COLOR;
+in vec4 frag_TEXCOORD0;
+uniform sampler2D sampler_main;
+uniform sampler2D sampler_pc_main;
+uniform sampler2D sampler_blur1;
+uniform vec4 _c7;
+vec3 Get1(vec2 uvi) { return (texture(sampler_main, uvi)).xyz; }
+void PS(vec4 _uv, out vec4 _return_value) {
+    vec3 ret = (texture(sampler_main, (_uv).xy)).xyz + (texture(sampler_pc_main, (_uv).zw)).xyz;
+    ret += (texture(sampler_blur1, (_uv).xy)).xyz + mytexture(sampler_main, (_uv).xy).xyz + Get1((_uv).xy);
+    _return_value = vec4(ret, 1.0);
+}
+)";
+
+auto Count(const std::string& text, const std::string& what) -> size_t
+{
+    size_t count{};
+    for (auto position = text.find(what); position != std::string::npos; position = text.find(what, position + 1))
+    {
+        ++count;
+    }
+    return count;
+}
+
+} // namespace
+
+TEST(FeedbackDiffusion, CanvasValueIsOffAtOrBelowTheCanvasAndPullsTapsIn)
+{
+    using libprojectM::MilkdropPreset::DiffusionCanvasValue;
+    for (const auto& value : {DiffusionCanvasValue(1182, 665, 1182, 665), DiffusionCanvasValue(960, 540, 1182, 665),
+                              DiffusionCanvasValue(3840, 2160, 0, 0)})
+    {
+        EXPECT_EQ(value[0], 0.0f);
+    }
+    const auto value = DiffusionCanvasValue(2364, 1330, 1182, 665);
+    EXPECT_FLOAT_EQ(value[0], 1182.0f);
+    EXPECT_FLOAT_EQ(value[1], 665.0f);
+    // Twice the canvas: the exact distance would be one canvas texel (two native texels), on native texel
+    // centres; it is pulled in by the coupling minimum.
+    EXPECT_NEAR(value[2] * 2364.0f, 2.0f - libprojectM::MilkdropPreset::DiffusionMinimumPullIn, 1e-4f);
+    EXPECT_NEAR(value[3] * 1330.0f, 2.0f - libprojectM::MilkdropPreset::DiffusionMinimumPullIn, 1e-4f);
+}
+
+TEST(FeedbackDiffusion, TapDistanceKeepsTheMeanReferenceVariance)
+{
+    using libprojectM::MilkdropPreset::DiffusionTapDistance;
+    // Mean over read phase f and the read's native sub-texel offset of the two-tap variance, including
+    // each tap's own native interpolation, relative to f(1-f) scale^2.
+    const auto ratio = [](double scale, double distance) {
+        const auto g = [](double p) { const double t = p - std::floor(p); return t * (1.0 - t); };
+        double total = 0.0, wanted = 0.0;
+        for (int i = 0; i < 200; ++i)
+        {
+            const double f = (i + 0.5) / 200;
+            for (int j = 0; j < 50; ++j)
+            {
+                const double near = (j + 0.5) / 50 + f * (scale - distance);
+                total += f * (1 - f) * distance * distance + (1 - f) * g(near) + f * g(near + distance);
+                wanted += f * (1 - f) * scale * scale;
+            }
+        }
+        return total / wanted;
+    };
+    for (double scale : {1.6241, 2.1653, 3.2487})
+    {
+        SCOPED_TRACE(scale);
+        const double distance = DiffusionTapDistance(static_cast<float>(scale));
+        EXPECT_LT(distance, scale);
+        EXPECT_NEAR(ratio(scale, distance), 1.0, 0.01);
+    }
+    EXPECT_FLOAT_EQ(DiffusionTapDistance(1.0f), 1.0f);
+    EXPECT_FLOAT_EQ(DiffusionTapDistance(3.0f), 3.0f - libprojectM::MilkdropPreset::DiffusionMinimumPullIn);
+}
+
+TEST(FeedbackDiffusion, RewritesOnlyTheNamedBilinearMainReads)
+{
+    const auto rewritten = DiffusionFootprintShader(Warp, {"sampler_main"});
+    // Two sampler_main reads, in PS() and in the preset function; not the point, blur or look-alike reads.
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main,"), 2u);
+    EXPECT_EQ(Count(rewritten, "texture(sampler_pc_main,"), 1u);
+    EXPECT_EQ(Count(rewritten, "texture(sampler_blur1,"), 1u);
+    EXPECT_EQ(Count(rewritten, "mytexture(sampler_main,"), 1u);
+    // The helper is declared once, after the uniforms and ahead of the first function that reads main.
+    EXPECT_EQ(Count(rewritten, "vec4 diffusion_main(sampler2D source"), 1u);
+    EXPECT_LT(rewritten.find("uniform vec4 _c7;"), rewritten.find("uniform highp vec4 diffusion_canvas;"));
+    EXPECT_LT(rewritten.find("vec4 diffusion_main(sampler2D source"), rewritten.find("vec3 Get1("));
+}
+
+TEST(FeedbackDiffusion, RewritesEveryListedSampler)
+{
+    std::string warp = Warp;
+    warp.insert(warp.find("uniform vec4 _c7;"), "uniform sampler2D sampler_fw_main;\n");
+    warp.insert(warp.find("    _return_value"), "    ret += texture(sampler_fw_main, fract((_uv).xy)).xyz;\n");
+    const auto rewritten = DiffusionFootprintShader(warp, {"sampler_main", "sampler_fw_main"});
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main,"), 2u);
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_fw_main,"), 1u);
+    EXPECT_EQ(Count(rewritten, "vec4 diffusion_main(sampler2D source"), 1u);
+}
+
+TEST(FeedbackDiffusion, LeavesShadersWithoutBilinearMainReadsUnchanged)
+{
+    EXPECT_EQ(DiffusionFootprintShader(Warp, {}), Warp);
+    EXPECT_EQ(DiffusionFootprintShader(Warp, {"sampler_fc_main"}), Warp);
+    // Without the warp's uv_orig input there is no reference phase to reproduce.
+    std::string noUvOrig = Warp;
+    noUvOrig.erase(noUvOrig.find("in vec4 frag_TEXCOORD0;"), 23);
+    EXPECT_EQ(DiffusionFootprintShader(noUvOrig, {"sampler_main"}), noUvOrig);
+}
+
+TEST(FeedbackDiffusion, ReadsAtStoredCoordinatesStayPlain)
+{
+    // Royal Mashup (255): seed positions are read back from the frame and the frame is sampled there. Such a
+    // coordinate does not move with the pixel, so it has no reference phase relative to it.
+    const std::string warp = R"(#version 330
+in vec4 frag_TEXCOORD0;
+uniform sampler2D sampler_main;
+uniform sampler2D sampler_pw_main;
+uniform sampler2D sampler_fw_main;
+vec2 Offset(vec2 p) { return p + vec2(0.01); }
+void PS(vec4 _uv, out vec4 _return_value) {
+    vec2 uvm = vec2( (_uv).xy );
+    vec3 ret = (texture(sampler_pw_main, uvm)).xyz;
+    vec3 rsamp = (texture(sampler_pw_main, uvm + vec2(0.01))).xyz;
+    ((ret).xy = (rsamp).xy);
+    ((ret).z = (texture(sampler_fw_main, (ret).xy)).z);
+    vec2 moved = Offset(uvm) + (texture(sampler_main, uvm)).xy * 0.01;
+    ret += (texture(sampler_fw_main, moved)).xyz + (texture(sampler_main, Offset((_uv).zw))).xyz;
+    _return_value = vec4(ret, 1.0);
+}
+)";
+    const auto rewritten = DiffusionFootprintShader(warp, {"sampler_main", "sampler_fw_main"});
+    EXPECT_EQ(Count(rewritten, "texture(sampler_fw_main, (ret).xy)"), 1u) << "stored coordinate must stay plain";
+    // Position-dependent through assignments (uvm, moved), a function result and a data-displaced position.
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_fw_main, moved)"), 1u);
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main, uvm)"), 1u);
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main, Offset((_uv).zw))"), 1u);
+}
+
+TEST(FeedbackDiffusion, FunctionParametersCarryPositionDependence)
+{
+    const std::string warp = R"(#version 330
+in vec4 frag_TEXCOORD0;
+uniform sampler2D sampler_main;
+vec3 Get1(vec2 uvi) { return (texture(sampler_main, uvi)).xyz; }
+vec3 Get2(vec2 pos) { return (texture(sampler_main, pos)).xyz; }
+void PS(vec4 _uv, out vec4 _return_value) {
+    vec2 newuv = vec2( (_uv).xy );
+    vec3 stored = (texture(sampler_main, newuv)).xyz;
+    _return_value = vec4(Get1(newuv + vec2(0.01)) + Get2((stored).xy), 1.0);
+}
+)";
+    const auto rewritten = DiffusionFootprintShader(warp, {"sampler_main"});
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main, uvi)"), 1u) << "Get1's parameter gets a position";
+    // Dependence is tracked by name, so a parameter name shared with a position-dependent one would be
+    // rewritten too (the conservative direction).
+    EXPECT_EQ(Count(rewritten, "texture(sampler_main, pos)"), 1u) << "Get2's parameter only gets stored data";
+    EXPECT_EQ(Count(rewritten, "diffusion_main(sampler_main, newuv)"), 1u);
+}
+
+TEST(FeedbackDiffusion, RewritesTheDefaultWarpShader)
+{
+    const std::string defaultWarp = "precision mediump float;\nin vec4 frag_COLOR;\nin vec4 frag_TEXCOORD0;\n"
+                                    "in vec2 frag_TEXCOORD1;\nuniform sampler2D texture_sampler;\n"
+                                    "void main() { color = frag_COLOR * texture(texture_sampler, frag_TEXCOORD0.xy); }\n";
+    const auto rewritten = DiffusionFootprintShader(defaultWarp, {"texture_sampler"});
+    EXPECT_EQ(Count(rewritten, "diffusion_main(texture_sampler,"), 1u);
+    EXPECT_LT(rewritten.find("uniform sampler2D texture_sampler;"), rewritten.find("vec4 diffusion_main("));
+    EXPECT_LT(rewritten.find("vec4 diffusion_main("), rewritten.find("void main()"));
+}
+
+TEST(FeedbackDiffusion, MotionMinimumScalesOnlyWithUsableCompensation)
+{
+    using libprojectM::MilkdropPreset::DiffusionMotionVectorMinimum;
+    constexpr float minimum = 0.002f;
+    for (float scale : {0.0f, 0.5f, 1.0f, 2.0f, 3.25f})
+    {
+        EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, scale, false), minimum);
+    }
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 0.0f, true), minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 1.0f, true), minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 2.0f, true), 2.0f * minimum);
+    EXPECT_FLOAT_EQ(DiffusionMotionVectorMinimum(minimum, 3.25f, true), 3.25f * minimum);
+}
+
+TEST(FeedbackDiffusion, RejectsPeakSharpeningFeedback)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    EXPECT_FALSE(DiffusionWarpEligible("ret=tex2D(sampler_fc_main,uv);"
+        "ret=max(ret,tex2D(sampler_fc_main,lerp(uv_orig,uv,.5))*.97);"
+        "ret+=(ret-GetBlur1(uv))*.15;ret*=.97;"));
+    EXPECT_FALSE(DiffusionWarpEligible("ret = max (ret, GetPixel(uv+.01));"
+        "ret = ret + (ret - GetBlur2(uv)) * .2;"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret=max(ret,GetPixel(uv));ret*=.97;"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret+=(ret-GetBlur1(uv))*.15;"));
+}
+
+TEST(FeedbackDiffusion, IgnoresCommentsInWarpGating)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    EXPECT_TRUE(DiffusionWarpEligible("// ret=max(ret,GetPixel(uv));\n"
+        "/* ret+=(ret-GetBlur1(uv))*.15; */ ret=GetPixel(uv);"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret=max(ret,GetPixel(uv));"
+        "/* ret+=(ret-GetBlur1(uv))*.15; */"));
+    EXPECT_TRUE(DiffusionWarpEligible("// sampler_pw_main\nret=GetPixel(uv);"));
+}
+
+TEST(FeedbackDiffusion, RejectsPointFeedbackButAllowsOrdinaryWarps)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    EXPECT_FALSE(DiffusionWarpEligible("ret=tex2D(sampler_pw_main,uv);"));
+    EXPECT_FALSE(DiffusionWarpEligible("ret=tex2D(sampler_pc_main,uv);"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret=tex2D(sampler_fc_main,uv);"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret=GetPixel(uv+(d,0))+GetPixel(uv+(0,d))-GetPixel((uv-.5)*.9+.5)-.4;"));
+    EXPECT_TRUE(DiffusionWarpEligible(""));
+}
+
+TEST(FeedbackDiffusion, GateRecognizesEveryMainSamplerAlias)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    // TextureManager accepts both orders of the filter/wrap prefix; the gate must too.
+    for (const char* point : {"pw", "wp", "pc", "cp"})
+    {
+        SCOPED_TRACE(point);
+        EXPECT_FALSE(DiffusionWarpEligible(std::string("ret=tex2D(sampler_") + point + "_main,uv);"));
+        EXPECT_FALSE(DiffusionWarpEligible(std::string("ret=TEX2D(SAMPLER_") + point + "_MAIN,uv);"));
+    }
+    for (const char* bilinear : {"fc", "cf", "fw", "wf"})
+    {
+        SCOPED_TRACE(bilinear);
+        EXPECT_TRUE(DiffusionWarpEligible(std::string("ret=tex2D(sampler_") + bilinear + "_main,uv)+tex2D(sampler_cp_main,uv)*.01;"));
+        EXPECT_FALSE(DiffusionWarpEligible(std::string("ret=tex2D(sampler_") + bilinear + "_main,uv_orig);"));
+    }
+}
+
+TEST(FeedbackDiffusion, AllowsMixedPointReadsWithBilinearFeedback)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    // Acid Mandala: displaced bilinear advection plus point-sampled channel/noise injection.
+    EXPECT_TRUE(DiffusionWarpEligible(
+        "ret=GetPixel(uv_dy)+(GetPixel(uv)-GetBlur1(uv))*.1;"
+        "ret.x=lerp(ret.x,1.1*tex2D(sampler_pc_main,uv_orig).x,bass_att*.1);"
+        "ret+=q3*.013*tex2D(sampler_pw_main,uv);"));
+    EXPECT_TRUE(DiffusionWarpEligible(
+        "ret=tex2D(sampler_fc_main,uv)+tex2D(sampler_pc_main,uv)*.01;"));
+    EXPECT_TRUE(DiffusionWarpEligible(
+        "ret=GetMain(uv)+tex2D(sampler_pc_main,uv)*.01;"));
+    EXPECT_FALSE(DiffusionWarpEligible(
+        "// GetPixel(uv)\nret=tex2D(sampler_pc_main,uv);"));
+}
+
+TEST(FeedbackDiffusion, RejectsExplicitUndisplacedReadsInMixedWarps)
+{
+    using libprojectM::MilkdropPreset::DiffusionWarpEligible;
+    EXPECT_FALSE(DiffusionWarpEligible("ret=GetPixel(uv_orig);"));
+    EXPECT_FALSE(DiffusionWarpEligible("ret=GetMain(uv_orig);"));
+    EXPECT_FALSE(DiffusionWarpEligible("ret.y=tex2D(sampler_main,uv_orig).y;ret.x=GetPixel(uv+.01).x;"));
+    EXPECT_FALSE(DiffusionWarpEligible("ret=tex2D(sampler_fc_main, uv_orig);"));
+    EXPECT_TRUE(DiffusionWarpEligible("// GetPixel(uv_orig)\nret=GetPixel(uv);"));
+    EXPECT_TRUE(DiffusionWarpEligible("ret=GetPixel(uv_orig+float2(.01,0));"));
+}
