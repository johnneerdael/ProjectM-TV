new file mode 100644
index 000000000..e0a5ce43d
--- /dev/null
+++ b/src/libprojectM/MilkdropPreset/FeedbackDiffusion.hpp
@@ -0,0 +1,76 @@
+/**
+ * @file FeedbackDiffusion.hpp
+ * @brief Gives the warp's feedback reads MilkDrop's per-frame smoothing, in picture units, at render sizes above the reference.
+ *
+ * Every frame the warp re-reads the previous frame bilinearly at displaced coordinates. A bilinear read
+ * at fractional texel phase f averages two texels per axis with weights 1 - f and f. Feedback presets
+ * are tuned to that smoothing at the size they were made for (the reference canvas, ShaderCanvasSize()).
+ * At a render size s times larger, a read spreads over s times fewer picture units, and presets that
+ * feed their image back settle into different, often darker or sharper, patterns.
+ *
+ * The smoothing depends on each read's phase, not on an average: identity reads and whole-texel shifts
+ * (f = 0) add nothing, a half-texel shift averages two texels equally. So every bilinear main-texture read
+ * of the warp is rewritten (DiffusionFootprintShader()) to a helper that reproduces the reference-size
+ * read: it takes the read's phase on the reference grid relative to the pixel's own position (uv_orig, as
+ * MilkDrop's pixels sit on texel centres), and blends the four reference-spaced neighbours with MilkDrop's
+ * bilinear weights, at a tap distance (DiffusionTapDistance()) that keeps the read's variance including the
+ * taps' own native interpolation. Per read the GPU computes only the phase and two tap positions.
+ * Reads with phase 0 on both axes stay a single plain read.
+ *
+ * Point-sampled reads (sampler_pw_main, sampler_pc_main and their aliases), the composite and the blur
+ * textures read the frame unchanged, as at the reference size. Off (the plain read) without a line
+ * reference size and at or below the reference area, where the canvas is the render size.
+ *
+ * Limits: a native read whose own interpolation already exceeds the reference read's (a whole reference
+ * texel offset that is fractional on the native grid) cannot be made sharper. Taps between native texels
+ * couple neighbouring native pixels slightly more than reference pixels are coupled.
+ */
+#pragma once
+
+#include <array>
+#include <string>
+#include <vector>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+/** Uniform of rewritten warp shaders: DiffusionCanvasValue(). */
+constexpr char DiffusionCanvasUniform[] = "diffusion_canvas";
+
+/** Least distance the two taps are pulled in from one canvas texel, in native texels (whole-number scales). */
+constexpr float DiffusionMinimumPullIn = 0.125f;
+
+/**
+ * @brief Distance between a read's two taps per axis, in native texels, for scale = render / canvas size.
+ *
+ * MilkDrop's taps are one canvas texel (scale native texels) apart. Each tap here is itself a native
+ * bilinear read, which adds variance; the distance is chosen so that the mean total variance over read
+ * phases is MilkDrop's f(1-f) canvas texel^2. On whole-number scales that would put the taps on native
+ * texel centres, so that native pixels never exchange values (independent copies of the canvas grid that
+ * drift apart in chaotic or sharpening feedback); there the taps are pulled in DiffusionMinimumPullIn.
+ */
+auto DiffusionTapDistance(float scale) -> float;
+
+/**
+ * @brief The diffusion_canvas uniform: canvas size, and the tap distances in uv; all 0 (plain reads)
+ *        unless the render is larger than the canvas.
+ */
+auto DiffusionCanvasValue(int viewportWidth, int viewportHeight, int canvasWidth, int canvasHeight) -> std::array<float, 4>;
+
+/**
+ * @brief Rewrites the bilinear main-texture reads of a translated warp shader to reference-size reads.
+ * @param glsl The warp's GLSL fragment shader (translated preset shader or the default warp shader).
+ * @param samplers The names of its bilinear main-texture samplers, e.g. "sampler_main", "sampler_fw_main".
+ * @return The rewritten shader, or glsl unchanged if no read of these samplers was found or the
+ *         shader lacks the warp's uv_orig input.
+ */
+auto DiffusionFootprintShader(const std::string& glsl, const std::vector<std::string>& samplers) -> std::string;
+
+/** Keep the reference's minimum vector length only while the reference footprint is active. */
+auto DiffusionMotionVectorMinimum(float minimumLength, float scale, bool diffusionActive) -> float;
+
