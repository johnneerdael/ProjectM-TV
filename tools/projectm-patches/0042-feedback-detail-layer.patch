+        };
+        check(); // initial allocation and first native warp
+        engine.SetFeedbackDetail(0);engine.RenderFrame(m_framebuffer);
+        engine.SetFeedbackDetail(alpha);check(); // gain-class replacement
+        engine.SetWindowSize(126,94);check(); // resize and rebuild from scaled feedback
+        engine.SetFeedbackDetail(-1);engine.RenderFrame(m_framebuffer);
+        engine.SetFeedbackDetail(alpha);check(); // re-enable
+    }
