+TEST_F(FeedbackDiffusionRenderTest, StandardMatchesPlainCanvasAcrossAnimatedMeshFrames) {
+    const auto preset = FeedbackPreset("GetPixel(uv).rgb") +
+        "per_pixel_1=dx=0.003*sin(frame*0.31+x*5);dy=0.002*cos(frame*0.47+y*3);\n";
+    std::vector<Image> authoredState,detailState;
+    auto renderSequence = [&](int width, int height, float alpha, int refWidth, int refHeight) {
+        TestProjectM engine;
+        engine.SetWindowSize(width,height); engine.SetMeshSize(48,32);
+        engine.SetPresetLocked(true); engine.SetHardCutEnabled(false); engine.SetEasterEgg(0);
+        engine.SetLineReferenceSize(refWidth,refHeight); engine.SetFeedbackDetail(alpha);
+        // Remove the composite mesh's output-sized half-texel offset to observe the feedback pixels.
+        auto observedPreset = preset;
+        const std::string comp = "tex2D(sampler_main, uv).rgb";
+        observedPreset.replace(observedPreset.find(comp), comp.size(),
+            "tex2D(sampler_main, uv-float2(" + std::to_string(0.5/width) + "," + std::to_string(0.5/height) + ")).rgb");
+        std::istringstream data(observedPreset); engine.LoadPresetData(data,false);
+        EXPECT_TRUE(engine.failure.empty())<<engine.failure;
+        std::vector<Image> frames;
+        for(int frame=0;frame<20;++frame) {
+            engine.RenderFrame(m_framebuffer);
+            Image px(width*height*3);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER,m_framebuffer);
+            glReadPixels(0,0,width,height,GL_RGB,GL_UNSIGNED_BYTE,px.data());
+            frames.push_back(std::move(px));
+            auto feedback=ReadFeedbackTexture(libprojectM::FeedbackDetailTestAccess::Feedback(engine));
+            (alpha<0 ? authoredState : detailState).push_back(std::move(feedback));
+            EXPECT_EQ(engine.FeedbackDetailStatus(),alpha<0 ? -1 : 2);
+        }
+        EXPECT_EQ(glGetError(),GL_NO_ERROR);
+        return frames;
+    };
+    const auto canvas = renderSequence(Width/2,Height/2,-1,0,0);
+    const auto native = renderSequence(Width,Height,0,Width/2,Height/2);
+    double maxStateMean=0;
+    for(size_t f=0;f<authoredState.size();++f) {
+        ASSERT_EQ(authoredState[f].size(),detailState[f].size());
+        double stateError=0;
+        for(size_t i=0;i<authoredState[f].size();++i) stateError+=std::abs(int(authoredState[f][i])-int(detailState[f][i]));
+        stateError/=authoredState[f].size();maxStateMean=std::max(maxStateMean,stateError);
+        EXPECT_LE(stateError,0.5)<<"persistent L frame "<<f;
+    }
+    std::cout<<"Standard persistent L maximum MAE bytes: "<<maxStateMean<<"\n";
+    double maxMean=0;
+    for(size_t f=0;f<native.size();++f) {
+        double error=0;
+        for(int y=0;y<Height;++y) for(int x=0;x<Width;++x) for(int c=0;c<3;++c) {
+            const float qx=(x+0.5f)/2-0.5f,qy=(y+0.5f)/2-0.5f;
+            const int bx=static_cast<int>(std::floor(qx)),by=static_cast<int>(std::floor(qy));
+            const float fx=qx-bx,fy=qy-by;
+            auto sample=[&](int sx,int sy) { sx=std::clamp(sx,0,Width/2-1);sy=std::clamp(sy,0,Height/2-1);return canvas[f][(sy*Width/2+sx)*3+c]; };
+            const float expected=(1-fy)*((1-fx)*sample(bx,by)+fx*sample(bx+1,by))+fy*((1-fx)*sample(bx,by+1)+fx*sample(bx+1,by+1));
+            error+=std::abs(native[f][(y*Width+x)*3+c]-expected);
+        }
+        const double mean=error/(Width*Height*3);maxMean=std::max(maxMean,mean);
+        EXPECT_LT(mean,0.6)<<"frame "<<f;
+    }
+    std::cout << "Standard canvas reconstruction maximum MAE bytes: "<<maxMean<<"\n";
+}
