+TEST_F(FeedbackDiffusionRenderTest, DetailRuntimeModesResizeFallbackAndTransition) {
+    TestProjectM engine;
+    engine.SetWindowSize(Width,Height);engine.SetLineReferenceSize(Width/2,Height/2);
+    engine.SetPresetLocked(true);engine.SetHardCutEnabled(false);
