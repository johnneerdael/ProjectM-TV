+            const int frame=libprojectM::FeedbackDetailTestAccess::Frame(engine);
+            for(size_t i=0;i<reduced.size();++i) maximumError=std::max(maximumError,std::abs(int(reduced[i])-int(std::lround(51*(i%3+1)+frame*5.1))));
+            EXPECT_LE(maximumError,1)<<"alpha "<<alpha;
