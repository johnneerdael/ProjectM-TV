+        native->Bind(0); glTexSubImage2D(GL_TEXTURE_2D,0,0,0,width,height,GL_RGBA,GL_UNSIGNED_BYTE,warp.data());
+        libprojectM::Renderer::Framebuffer output;
+        output.CreateColorAttachment(0,0); output.SetSize(width,height);
+        detail.Combine(native,alpha,output,0);
+        output.BindRead(0);
+        std::vector<uint8_t> result(width*height*4);
+        glReadPixels(0,0,width,height,GL_RGBA,GL_UNSIGNED_BYTE,result.data());
+        for(int y=0;y<height;y+=scale) for(int x=0;x<width;x+=scale) for(int c=0;c<3;++c) {
+            int sum=0; for(int j=0;j<scale;++j) for(int i=0;i<scale;++i) sum+=result[((y+j)*width+x+i)*4+c];
+            EXPECT_NEAR(sum/static_cast<double>(scale*scale),base[c],0.51) << "channel "<<c<<" alpha "<<alpha<<" scale "<<scale;
+        }
+        EXPECT_EQ(glGetError(),GL_NO_ERROR);
+    }
+}
