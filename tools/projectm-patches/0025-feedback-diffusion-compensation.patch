@@ -0,0 +1,124 @@
+/**
+ * @file FeedbackDiffusion.hpp
+ * @brief Restores MilkDrop's per-frame feedback smoothing, in picture units, at render sizes above the reference.
+ *
+ * Every frame the warp re-samples the previous frame bilinearly at displaced coordinates. Bilinear
+ * re-sampling at a sub-texel offset f spreads each texel over its neighbours with a variance of
+ * f * (1 - f) texel² per axis, 1/6 texel² on average over random offsets. Feedback presets are
+ * tuned to that smoothing: it is the diffusion term of the reaction-diffusion-like systems many of
+ * them are (gradient-advection warps with decay near 1 settle into patterns whose size depends on it).
+ *
+ * The smoothing is per *render* texel. At a render size s times the reference's in each direction
+ * (s = sqrt(render area / reference area)), it is s² times smaller in picture units: at 3840x2160
+ * against MilkDrop's 1024x768 that is 10.5x less diffusion, and some presets settle into different
+ * patterns. Adding a blur of variance (s² - 1) / 6 render px² per axis to the feedback image once per
+ * frame makes the total per-frame diffusion s² / 6 render px² = 1/6 reference px², as at the reference.
+ *
+ * Off (no pass, frames unchanged) without a line reference size or at or below the reference area.
+ *
+ * Placement P2: merge the stencil into the required end-of-frame y-flip and reuse that texture
+ * as next frame's warp input. New motion vectors trigger a recomputation from the raw previous
+ * canvas. P2 avoids P1's additional full-screen pass, but also softens fresh composite detail.
+ *
+ * Limits: the variance is uniform. MilkDrop's smoothing is 1/6 texel² only on average; where the warp
+ * does not move the image (or moves it by whole texels) and for point-sampled reads (sampler_pw_main,
+ * sampler_pc_main) it smooths nothing, and the kernel still adds its share there.
+ */
+#pragma once
+
+#include <Renderer/Framebuffer.hpp>
+#include <Renderer/RenderItem.hpp>
+#include <Renderer/Sampler.hpp>
+#include <Renderer/Shader.hpp>
+
+#include <array>
+#include <memory>
+#include <string>
+
+namespace libprojectM {
+namespace MilkdropPreset {
+
+/** One bilinear tap, in source texels relative to the destination's texel center. */
+struct DiffusionTap { float x{0.0f}; float y{0.0f}; };
+
+/** Equal-weight 3/4-tap stencil with zero mean/covariance and the required per-axis variance. */
+struct DiffusionKernel
+{
+    std::array<DiffusionTap, 4> taps{};
+    int tapCount{0};          //!< Zero: no pass. Otherwise each tap weighs 1/tapCount.
+    float variance{0.0f};     //!< Added variance per axis, including bilinear interpolation.
+};
+
+/**
+ * @brief The variance wanted per axis: (scale² - 1) / 6 render px², 0 for scale <= 1.
+ * @param scale Render size over reference size, linear (LineScale()).
+ */
+auto DiffusionVariance(float scale) -> float;
+
+/**
+ * Construct an exact-moment stencil. For V <= 2/3, three taps at (0,-a), (+/-a,a/2),
+ * a=3V/2, add V on each axis through their bilinear split. Above that, four diagonal
+ * taps use n+(V-n*n)/(2n+1), n=floor(sqrt(V)). Both have zero mean and xy covariance.
+ * Higher moments differ from a Gaussian; fidelity and GPU cost determine this choice.
+ * Cap V at MaxDiffusionVariance for unverified extreme scales.
+ */
+auto DiffusionKernelFor(float scale) -> DiffusionKernel;
+
+/** Keep the reference's minimum vector length only while diffusion is actually usable. */
+auto DiffusionMotionVectorMinimum(float minimumLength, float scale, bool diffusionActive) -> float;
+
+/** Conservative load-time gate for point reads and combined peak/sharpening feedback. */
+auto DiffusionWarpEligible(const std::string& warpShader) -> bool;
+
+constexpr float MaxDiffusionVariance = 1.9f; //!< Largest verified variance (scale approximately 3.52).
+
+/**
+ * @brief Draws the feedback image into its own texture through the diffusion kernel, optionally y-flipped.
+ *
+ * Replace the end-of-frame CopyTexture flip and cache its result for the next warp. This uses
+ * the low-cost P2 placement; P1's extra full-screen pass failed the AM6 performance target.
+ */
+class FeedbackDiffusion : public Renderer::RenderItem
+{
+public:
+    FeedbackDiffusion();
+
+    void InitVertexAttrib() override;
+
+    /**
+     * @brief Sets the kernel for this render/reference scale.
+     * @return True when the scale changed; invalidate a cached filtered image before using it.
+     * @param scale LineScale() of the render and reference sizes; 0 or <= 1 turn the pass off.
+     */
+    auto SetScale(float scale) -> bool;
+
+    /**
+     * @brief True if SetScale() got a scale above 1, i.e. the frame needs the diffusion pass.
+     */
+    auto Active() const -> bool;
+
+    /**
+     * @brief Draws source through the kernel into Texture(), resizing it to source's size.
+     * @param source The feedback image. Must not be Texture().
+     * @param flipVertical Flip the image on the y axis, as CopyTexture does for the warp's input.
+     */
+    void Draw(const std::shared_ptr<Renderer::Texture>& source, bool flipVertical);
+
+    /**
+     * @brief The last image drawn.
+     */
+    auto Texture() const -> std::shared_ptr<Renderer::Texture>;
+
+private:
+    Renderer::Shader m_shader;                                //!< Adaptive 3/4-tap stencil shader.
+    Renderer::Framebuffer m_framebuffer{1};                   //!< Holds the output texture.
+    Renderer::Sampler m_sampler{GL_CLAMP_TO_EDGE, GL_LINEAR}; //!< Bilinear taps; edges repeat.
+    DiffusionKernel m_kernel;                                 //!< Current kernel.
+    bool m_usable{false};                                    //!< False after shader compile/link failure.
+    bool m_warnedScaleCap{false};                            //!< Extreme-scale warning emitted once.
+    GLint m_sourceLocation{-1}, m_flipLocation{-1}, m_stepLocation{-1}, m_weightsLocation{-1};
+    float m_scale{0.0f};                                      //!< Scale of m_kernel.
+};
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
