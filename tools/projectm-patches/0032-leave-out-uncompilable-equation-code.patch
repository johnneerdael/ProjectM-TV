+        {"shapecode_1_enabled=1\nshape_1_per_frame1=shpt =\n", "Could not compile custom shape 1 per-frame code: "},
+        // Disabled components are compiled too, as in MilkDrop.
+        {"wavecode_2_enabled=0\nwave_2_per_frame1=r=(;\n", "Could not compile custom wave 2 per-frame code: "},
+        {"shapecode_3_enabled=0\nshape_3_per_frame1=rad=(;\n", "Could not compile custom shape 3 per-frame code: "},
+    };
+    for (const auto& [records, reason] : cases) {
+        FailureEventProjectM engine;
+        engine.SetWindowSize(128,96);
+        std::istringstream data(std::string("[preset00]\nfDecay=1\nper_frame_1=zoom=1.01;\n") + records);
+        engine.LoadPresetData(data, false);
+        EXPECT_EQ(engine.failures, 0) << records << engine.failure;
+        ASSERT_EQ(engine.warnings.size(), 1u) << records;
+        EXPECT_EQ(engine.warnings[0].rfind(reason, 0), 0u) << engine.warnings[0];
+        EXPECT_NE(engine.warnings[0].find(" (line "), std::string::npos) << engine.warnings[0];
+    }
+}
