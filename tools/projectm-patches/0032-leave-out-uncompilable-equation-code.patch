+}
+TEST_F(MilkdropPresetFailureEventTest, EveryCodeBlockIsLeftOutSeparately) {
+    const std::pair<const char*, const char*> cases[] = {
+        {"per_frame_init_1=q1=(;\n", "Could not compile per-frame init code: "},
+        {"per_pixel_1=zoom=zoom*sin*2;\n", "Could not compile per-pixel code: "},
+        {"wavecode_0_enabled=1\nwave_0_init1=t1=;\n", "Could not compile custom wave 0 per-frame init code: "},
+        {"wavecode_0_enabled=1\nwave_0_per_frame1=r=(;\n", "Could not compile custom wave 0 per-frame code: "},
