diff --git a/src/api/include/projectM-4/callbacks.h b/src/api/include/projectM-4/callbacks.h
index 4a55c872a..a0fb1ab2a 100644
--- a/src/api/include/projectM-4/callbacks.h
+++ b/src/api/include/projectM-4/callbacks.h
@@ -54,6 +54,20 @@ typedef void (*projectm_preset_switch_requested_event)(bool is_hard_cut, void* u
 typedef void (*projectm_preset_switch_failed_event)(const char* preset_filename,
                                                     const char* message, void* user_data);
 
+/**
+ * @brief Callback function that is executed once per problem in a preset that loaded anyway.
+ *
+ * Like MilkDrop, projectM leaves out preset equation code that doesn't compile and uses the rest of
+ * the preset. The message names the code block and the compiler error. The message and filename
+ * pointers are only valid inside the callback.
+ *
+ * @param preset_filename The filename of the preset, empty if it was loaded from data.
+ * @param message The problem.
+ * @param user_data A user-defined data pointer that was provided when registering the callback.
+ */
+typedef void (*projectm_preset_initialization_warning_event)(const char* preset_filename,
+                                                             const char* message, void* user_data);
+
 
 /**
  * @brief Sets a callback function that will be called when a preset change is requested.
@@ -83,6 +97,19 @@ PROJECTM_EXPORT void projectm_set_preset_switch_failed_event_callback(projectm_h
                                                                       projectm_preset_switch_failed_event callback,
                                                                       void* user_data);
 
+/**
+ * @brief Sets a callback function that will be called for each problem in a preset that loaded anyway.
+ *
+ * Only one callback can be registered per projectM instance. To remove the callback, use NULL.
+ *
+ * @param instance The projectM instance handle.
+ * @param callback A pointer to the callback function.
+ * @param user_data A pointer to any data that will be sent back in the callback.
+ */
+PROJECTM_EXPORT void projectm_set_preset_initialization_warning_event_callback(projectm_handle instance,
+                                                                               projectm_preset_initialization_warning_event callback,
+                                                                               void* user_data);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
