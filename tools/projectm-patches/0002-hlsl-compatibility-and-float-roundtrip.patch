+{
+    EXPECT_FALSE(Generate("", "r = (float4(1, 2, 3, 4) * 0.5 + float4(0, 1, 0, 1)).w;").empty());
+}
+
+TEST_F(ArrayInitializerTest, ParenthesizedConstructorAcceptsPostfixSwizzle)
+{
