+// A preset shader may assign to a uniform, e.g. "q18 = 1;" with q18 defined as _qe.y. GLSL uniforms
+// are read-only, so the generator moves the shader's reads and writes to a global copy ("new_qe") that
+// main() initializes from the uniform before calling the entry point, as MilkDrop's HLSL compiler
+// starts such a write from the uniform's value.
+class UniformReplacementTest : public testing::Test
+{
+protected:
+    M4::Allocator allocator;
+    M4::HLSLTree tree{&allocator};
+    M4::HLSLParser parser{&allocator, &tree};
+
+    std::string Generate(const char* globals, const char* body)
+    {
+        std::string source = "uniform float4 _qe; uniform float4 _c1, _c2;\n";
+        source += globals;
+        source += "\nvoid PS(out float4 _return_value : COLOR0)\n{\n";
+        source += body;
+        source += "\n}\n";
+        if (!parser.Parse("uniforms.hlsl", source.c_str(), source.size()))
+            return {};
+        M4::GLSLGenerator generator;
+        if (!generator.Generate(&tree, M4::GLSLGenerator::Target_FragmentShader,
+                                M4::GLSLGenerator::Version_300_ES, "PS"))
+            return {};
+        return generator.GetResult();
+    }
+
+    static std::string Between(const std::string& glsl, const std::string& from, const std::string& to)
+    {
+        auto begin = glsl.find(from);
+        if (begin == std::string::npos)
+            return {};
+        auto end = glsl.find(to, begin);
+        return glsl.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
+    }
+
+    static std::string EntryPoint(const std::string& glsl)
+    {
+        return Between(glsl, "void PS(", "\n}\n");
+    }
+
+    static std::string Main(const std::string& glsl)
+    {
+        return Between(glsl, "void main() {", "\n}\n");
+    }
+
+    // References to the uniform itself, as opposed to its copy.
+    static int CountUncopied(const std::string& glsl, const std::string& uniform)
+    {
+        int count = 0;
+        for (auto at = glsl.find(uniform); at != std::string::npos; at = glsl.find(uniform, at + 1))
+        {
+            if (at < 3 || glsl.compare(at - 3, 3, "new") != 0)
+                ++count;
+        }
+        return count;
+    }
+
+    static void ExpectCopyInitializedBeforeEntry(const std::string& glsl, const std::string& uniform)
+    {
+        const std::string copy = "new" + uniform;
+        EXPECT_NE(glsl.find("\nvec4 " + copy + ";"), std::string::npos) << glsl;
+        const std::string main = Main(glsl);
+        const auto init = main.find(copy + " = vec4( " + uniform + " );");
+        ASSERT_NE(init, std::string::npos) << glsl;
+        EXPECT_LT(init, main.find("PS(")) << glsl;
+    }
+};
+
+TEST_F(UniformReplacementTest, WritingOneComponentKeepsTheOthers)
+{
+    // "q18 = 1; ret = q19;"
+    const auto glsl = Generate("", "_qe.y = 1; _return_value = _qe.z;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+    const auto entry = EntryPoint(glsl);
+    EXPECT_NE(entry.find("(new_qe).y = float (1)"), std::string::npos) << glsl;
+    EXPECT_NE(entry.find("(new_qe).z"), std::string::npos) << glsl;
+    EXPECT_EQ(entry.find("vec4 new_qe"), std::string::npos) << "no uninitialized local copy\n" << glsl;
+}
+
+TEST_F(UniformReplacementTest, CompoundAssignmentStartsFromTheUniform)
+{
+    // "time *= 0.4;" with time defined as _c2.x
+    const auto glsl = Generate("", "_c2.x *= 0.4; _return_value = _c2.x;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_c2");
+    EXPECT_NE(EntryPoint(glsl).find("(new_c2).x *= "), std::string::npos) << glsl;
+}
+
+TEST_F(UniformReplacementTest, SelfReferencingFirstAssignmentReadsTheCopy)
+{
+    // "q18 = q18 + 1;"
+    const auto glsl = Generate("", "_qe.y = _qe.y + 1; _return_value = _qe;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+    const auto entry = EntryPoint(glsl);
+    EXPECT_NE(entry.find("(new_qe).y = ((new_qe).y + "), std::string::npos) << glsl;
+    EXPECT_EQ(CountUncopied(entry, "_qe"), 0) << "every reference uses the copy\n" << glsl;
+}
+
+TEST_F(UniformReplacementTest, ConditionalWriteLeavesTheValueDefined)
+{
+    const auto glsl = Generate("", "if (_qe.x > 0) _qe.y = 1; _return_value = _qe.y;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+}
+
+TEST_F(UniformReplacementTest, IncrementAndOutArgumentsAreWrites)
+{
+    const auto glsl = Generate("void Set(out float v) { v = 1; }",
+                               "_qe.w++; Set(_c1.x); _return_value = _qe + _c1;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+    ExpectCopyInitializedBeforeEntry(glsl, "_c1");
+}
+
+TEST_F(UniformReplacementTest, HelpersShareTheCopyWithTheEntryPoint)
+{
+    // HLSL globals are shared by all functions: a helper sees the entry point's writes and vice versa.
+    const auto glsl = Generate("float Read() { return _qe.z; }\n"
+                               "void Write() { _c2.y = 3; }",
+                               "_qe.z = 2; Write(); _return_value = Read() + _c2.y;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+    ExpectCopyInitializedBeforeEntry(glsl, "_c2");
+    EXPECT_NE(Between(glsl, "float Read(", "\n}\n").find("(new_qe).z"), std::string::npos) << glsl;
+    EXPECT_NE(Between(glsl, "void Write(", "\n}\n").find("(new_c2).y = "), std::string::npos) << glsl;
+    EXPECT_NE(EntryPoint(glsl).find("(new_c2).y"), std::string::npos) << glsl;
+}
+
+TEST_F(UniformReplacementTest, GlobalInitializersReadTheUniform)
+{
+    // Static initializers run before the shader body writes anything.
+    const auto glsl = Generate("static float2 start = _qe.xy;", "_qe.x = 5; _return_value = start.xyxy;");
+    ASSERT_FALSE(glsl.empty());
+    ExpectCopyInitializedBeforeEntry(glsl, "_qe");
+    EXPECT_NE(Main(glsl).find("start = vec2( (_qe).xy );"), std::string::npos) << glsl;
+}
+
+TEST_F(UniformReplacementTest, UniformsThatAreOnlyReadAreNotCopied)
+{
+    const auto glsl = Generate("", "_qe.x = 1; _return_value = _c1 + _c2;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_EQ(glsl.find("new_c1"), std::string::npos) << glsl;
+    EXPECT_EQ(glsl.find("new_c2"), std::string::npos) << glsl;
+    EXPECT_NE(EntryPoint(glsl).find("(_c1 + _c2)"), std::string::npos) << glsl;
+}
+
+TEST_F(UniformReplacementTest, ShaderWithoutUniformWritesIsUnchanged)
+{
+    const auto glsl = Generate("", "_return_value = _qe;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_EQ(glsl.find("new_"), std::string::npos) << glsl;
+}
+
+// HLSL fills an array from its initializer list component by component; GLSL takes one constructor
+// argument per array element.
+class ArrayInitializerTest : public testing::Test
+{
+protected:
+    // The GLSL for a shader with these globals and entry point body, or "" if translation fails.
+    std::string Generate(const char* globals, const char* body)
+    {
+        M4::Allocator allocator;
+        M4::HLSLTree tree{&allocator};
+        M4::HLSLParser parser{&allocator, &tree};
+        std::string source = globals;
+        source += "\nvoid PS(out float4 r : COLOR0)\n{\n";
+        source += body;
+        source += "\n}\n";
+        std::string preprocessed;
+        if (!parser.ApplyPreprocessor("arrays.hlsl", source.c_str(), source.size(), preprocessed))
+            return {};
+        if (!parser.Parse("arrays.hlsl", preprocessed.c_str(), preprocessed.size()))
+            return {};
+        M4::GLSLGenerator generator;
+        if (!generator.Generate(&tree, M4::GLSLGenerator::Target_FragmentShader,
+                                M4::GLSLGenerator::Version_300_ES, "PS"))
+            return {};
+        return generator.GetResult();
+    }
+};
+
+TEST_F(ArrayInitializerTest, FlatScalarsAreGroupedIntoVectors)
+{
+    const auto glsl = Generate("", "float2 a[2] = {1, 2, 3, 4}; r = a[1].xyxy;");
+    EXPECT_NE(glsl.find("vec2 a[2] = vec2[]( vec2(1, 2), vec2(3, 4) );"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, GroupedVectorsKeepTheirLayout)
+{
+    const auto glsl = Generate("", "float2 a[2] = {float2(1, 2), float2(3, 4)}; r = a[1].xyxy;");
+    EXPECT_NE(glsl.find("vec2 a[2] = vec2[]( vec2(1, 2), vec2(3, 4) );"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, VectorsAndScalarsFillElementsInOrder)
+{
+    const auto glsl = Generate("", "float4 a[2] = {float2(1, 2), 3, 4, float3(5, 6, 7), 8}; r = a[1];");
+    EXPECT_NE(glsl.find("vec4[]( vec4(vec2(1, 2), 3, 4), vec4(vec3(5, 6, 7), 8) )"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ScalarArrayConvertsIntegerLiterals)
+{
+    // GLSL ES array constructors do not convert int arguments to float.
+    const auto glsl = Generate("", "float a[3] = {1, 2, 3}; r = a[2];");
+    EXPECT_NE(glsl.find("float[]( float (1), float (2), float (3) )"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, GlobalArrayIsAssignedWholeInMain)
+{
+    // The layout of "const float4 samples[5] = {...20 values...}" in 56 bundled presets.
+    const auto glsl = Generate("const float4 samples[2] = {\n"
+                               "    0.0, 0.0, 0, 11.0/3.0,\n"
+                               "    0.0, 1.0, 0, -2.0/3.0\n"
+                               "};",
+                               "r = samples[1];");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("\nvec4 samples[2];"), std::string::npos) << glsl;
+    const auto main = glsl.substr(glsl.find("void main() {"));
+    EXPECT_NE(main.find("    samples = vec4[]( vec4(float(0.0), float(0.0), 0, (float(11.0) / float(3.0))), "
+                        "vec4(float(0.0), float(1.0), 0, ((-float(2.0)) / float(3.0))) );"),
+              std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ListsThatDoNotFillTheArrayAreRejected)
+{
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, 4, 5}; r = a[1];"), "");
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, 4, 5, 6, 7, 8, 9}; r = a[1];"), "");
+    EXPECT_EQ(Generate("", "float2 a[3] = {float2(1, 2), float2(3, 4)}; r = a[1].xyxy;"), "");
+}
+
+TEST_F(ArrayInitializerTest, VectorSpanningTwoElementsIsRejected)
+{
+    EXPECT_EQ(Generate("", "float4 a[2] = {1, 2, 3, float2(4, 5), 6, 7, 8}; r = a[1];"), "");
+}
+
+// These cases distinguish the retained compatibility rules from the upstream constructor fix.
