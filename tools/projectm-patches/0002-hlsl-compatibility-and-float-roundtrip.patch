+    const auto glsl = Generate("", "float sample = 0.5; r = sample;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("float sample0 = "), std::string::npos) << glsl;
+    EXPECT_NE(glsl.find("vec4 (sample0)"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ObjectMacrosPreserveDeclarationTokens)
+{
+    const auto glsl = Generate("#define DECL float value = 0.5;\n", "DECL r = value;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("float value = "), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, FunctionMacrosPreserveStatementTokensAndArgumentBoundaries)
+{
+    const auto glsl = Generate("#define SET(v) float value = v;\n", "SET(0.5) r = value;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("float value = "), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, MacroKeepsAuthoredParenthesesAndPrecedence)
+{
+    const auto glsl = Generate("#define SCALE(v) ((v) + 1)\n", "r = 2 * SCALE(3);");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("(2 * (3 + 1))"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, PlainUninitializedFloatGlobalsBecomeInputs)
+{
+    const auto glsl = Generate("float legacyInput; float4 color;", "r = color * legacyInput;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("uniform float legacyInput;"), std::string::npos) << glsl;
+    EXPECT_NE(glsl.find("uniform vec4 color;"), std::string::npos) << glsl;
+    EXPECT_EQ(glsl.find("newlegacyInput"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, ImplicitInputWritesUseInitializedCopies)
+{
+    const auto glsl = Generate("float4 color;", "color.x += 0.5; r = color;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("uniform vec4 color;"), std::string::npos) << glsl;
+    const auto init = glsl.find("newcolor = vec4( color );");
+    ASSERT_NE(init, std::string::npos) << glsl;
+    EXPECT_LT(init, glsl.find("PS(r);")) << glsl;
+    EXPECT_NE(glsl.find("(newcolor).x += "), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, MixedCommaDeclarationKeepsInitializedStorageSeparate)
+{
+    const auto glsl = Generate("float legacyInput, stored = 0.25;", "r = legacyInput + stored;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_NE(glsl.find("uniform float legacyInput;"), std::string::npos) << glsl;
+    EXPECT_NE(glsl.find("\nfloat stored;"), std::string::npos) << glsl;
+    EXPECT_EQ(glsl.find("uniform float stored"), std::string::npos) << glsl;
+    EXPECT_NE(glsl.find("stored = float( float(0.25) );"), std::string::npos) << glsl;
+}
+
+TEST_F(ArrayInitializerTest, StaticConstAndLocalStorageDoNotBecomeImplicitInputs)
+{
+    const auto glsl = Generate("static float state; const float fixedValue = 0.25;",
+                               "float local; local = fixedValue; state = local; r = state;");
+    ASSERT_FALSE(glsl.empty());
+    EXPECT_EQ(glsl.find("uniform float state"), std::string::npos) << glsl;
+    EXPECT_EQ(glsl.find("uniform float local"), std::string::npos) << glsl;
+    EXPECT_EQ(glsl.find("uniform float fixedValue"), std::string::npos) << glsl;
+}
+
+TEST(ShaderFloatLiteral, RepresentativeFiniteValuesRoundTripExactly)
+{
+    for (float value : {0.0f, -0.0f, 0.1f, 1.23456789f, -123456.789f,
+                        16777216.0f, std::numeric_limits<float>::max(),
+                        std::numeric_limits<float>::lowest(), std::numeric_limits<float>::min(),
+                        std::numeric_limits<float>::denorm_min()})
+    {
+        char formatted[64];
+        ASSERT_GT(M4::String_FormatFloat(formatted, sizeof(formatted), value), 0);
+        const std::string text(formatted);
+        SCOPED_TRACE(text);
+        ASSERT_EQ(text.substr(0, 6), "float(");
+        std::istringstream input(text.substr(6, text.size() - 7));
+        input.imbue(std::locale::classic());
+        double wide{};
+        input >> wide;
+        ASSERT_FALSE(input.fail());
+        const float reparsed = static_cast<float>(wide);
+        uint32_t before{}, after{};
+        std::memcpy(&before, &value, sizeof(before));
+        std::memcpy(&after, &reparsed, sizeof(after));
+        EXPECT_EQ(before, after);
+        EXPECT_NE(text.find_first_of(".eE", 6), std::string::npos);
+    }
+}
+
+TEST_F(ArrayInitializerTest, NonfiniteFloatLiteralIsRejectedDuringGeneration)
+{
+    // 1e39 is finite as the tokenizer's double, but overflows the HLSL float value.
+    EXPECT_TRUE(Generate("", "r = 1e39;").empty());
+}
