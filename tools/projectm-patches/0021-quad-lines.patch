 PROJECTM_EXPORT void projectm_opengl_set_direct_output(projectm_handle instance, bool enabled);
 
+/**
+ * @brief Draws waveforms, custom waves, shape outlines and motion vectors as quads, and waveform dots
+ *        with a matching point size, so they keep their share of the picture at large render sizes.
+ *
+ * Lines are 1 px wide at and below the given render height and in proportion above it (thick ones
+ * are drawn like MilkDrop's: the thin line four times with small offsets); below it they are drawn
+ * as at it, because thinner, faded lines made presets that feed their image back go dark. Edges are
+ * hard, like MilkDrop's GL lines, unless projectm_opengl_set_line_antialiasing() is enabled. Dots
+ * remain GL points whose size scales the same way (on desktop OpenGL, GL_PROGRAM_POINT_SIZE is
+ * enabled while they are drawn). 0, the default, keeps MilkDrop's 1 px GL lines and points. If the
+ * driver rejects the line shaders, lines fall back to GL lines.
+ *
+ * @param instance The projectM instance handle.
+ * @param reference_height Render height in pixels up to which lines are 1 px wide, or 0.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_line_reference_height(projectm_handle instance, uint32_t reference_height);
+
+/**
+ * @brief Gives quad lines (see projectm_opengl_set_line_reference_height()) a one-pixel anti-aliased edge.
+ *
+ * Off by default: quad lines have hard edges like MilkDrop's GL lines, which presets that feed their
+ * image back are tuned for (a soft edge made such a preset 14 % darker in testing). Has no effect
+ * while the line reference height is 0, and none on dots.
+ *
+ * @param instance The projectM instance handle.
+ * @param enabled True for anti-aliased edges.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_line_antialiasing(projectm_handle instance, bool enabled);
+
