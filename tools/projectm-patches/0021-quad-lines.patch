+TEST(LineBatch, FewerThanTwoPointsDrawNothing)
+{
+    LineBatch batch;
+    const auto one = MakePoints({1});
+    EXPECT_EQ(batch.Append(one.data(), one.size(), false).segments, 0);
+    EXPECT_EQ(batch.Append(one.data(), one.size(), true).segments, 0);
