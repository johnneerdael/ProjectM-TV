+
+bool BlurTexture::GetBlurScaleAndBias(const Values& blurMin, const Values& blurMax,
+                                    Values& scale, Values& bias)
+{
+    for (size_t i = 0; i < blurMin.size(); ++i)
+    {
+        const float gap = blurMax[i] - blurMin[i];
+        if (!std::isfinite(blurMin[i]) || !std::isfinite(blurMax[i]) ||
+            !std::isfinite(gap) || gap <= 0.0f)
+        {
+            return false;
+        }
+    }
+
+    // Retain MilkDrop's progressive float32 arithmetic (including rounding).
+    for (size_t i = 0; i < blurMin.size(); ++i)
+    {
+        const float tempMin = i == 0 ? blurMin[i] :
+            (blurMin[i] - blurMin[i - 1]) / (blurMax[i - 1] - blurMin[i - 1]);
+        const float tempMax = i == 0 ? blurMax[i] :
+            (blurMax[i] - blurMin[i - 1]) / (blurMax[i - 1] - blurMin[i - 1]);
+        const float denominator = tempMax - tempMin;
+        if (!std::isfinite(tempMin) || !std::isfinite(tempMax) ||
+            !std::isfinite(denominator) || denominator <= 0.0f)
+        {
+            return false;
+        }
+        scale[i] = 1.0f / denominator;
+        bias[i] = -tempMin * scale[i];
+        if (!std::isfinite(scale[i]) || scale[i] <= 0.0f || !std::isfinite(bias[i]))
+        {
+            return false;
+        }
+    }
+    return true;
+
 }
 
