Subject: [PATCH] Preserve shader diagnostics and clean up failed program compilation

Standard exception handlers lost the driver diagnostic because ShaderException inherited std::exception::what(). Return its owned message without allocation. If fragment compilation throws, delete the already-compiled unattached vertex shader before rethrowing; otherwise repeated failed loads or optional-shader fallback leak shader objects.

Tests exercise the standard exception interface and real CGL shader-object lifetimes for vertex, fragment and link failure, repeated attempts, and successful retry. Valid rendering is unchanged.

--- a/src/libprojectM/Renderer/Shader.hpp
+++ b/src/libprojectM/Renderer/Shader.hpp
@@ -13,6 +13,7 @@
 #include <glm/mat4x4.hpp>
 
 #include <cstdint>
+#include <exception>
 #include <map>
 #include <string>
 #include <unordered_map>
@@ -33,6 +34,11 @@
 
     virtual ~ShaderException() = default;
 
+    const char* what() const noexcept override
+    {
+        return m_message.c_str();
+    }
+
     const std::string& message() const
     {
         return m_message;
--- a/src/libprojectM/Renderer/Shader.cpp
+++ b/src/libprojectM/Renderer/Shader.cpp
@@ -178,7 +178,17 @@
     }
 
     auto vertexShader = CompileShader(vertexShaderSource, GL_VERTEX_SHADER);
-    auto fragmentShader = CompileShader(fragmentShaderSource, GL_FRAGMENT_SHADER);
+    GLuint fragmentShader{};
+    try
+    {
+        fragmentShader = CompileShader(fragmentShaderSource, GL_FRAGMENT_SHADER);
+    }
+    catch (...)
+    {
+        // The vertex shader is still unattached, so deleting the program cannot release it.
+        glDeleteShader(vertexShader);
+        throw;
+    }
 
     glAttachShader(m_shaderProgram, vertexShader);
     glAttachShader(m_shaderProgram, fragmentShader);
