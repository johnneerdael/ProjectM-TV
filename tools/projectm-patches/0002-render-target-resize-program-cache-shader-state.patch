+/**
+ * @brief Renders a single frame into the given framebuffer object instead of the default one.
+ *
+ * The framebuffer must have a color attachment at least as large as the window size set with
+ * projectm_set_window_size(). Passing 0 is the same as projectm_opengl_render_frame().
+ *
+ * @param instance The projectM instance handle.
+ * @param framebuffer_object_id The OpenGL framebuffer object to draw the frame into.
+ */
+PROJECTM_EXPORT void projectm_opengl_render_frame_fbo(projectm_handle instance, uint32_t framebuffer_object_id);
+
+/**
+ * @brief Statistics of the process-wide cache of linked shader programs.
+ *
+ * Programs are cached by their source code and shared by all instances: a program another instance
+ * (e.g. on another thread with its own context) already linked loads in milliseconds.
+ *
+ * @param hits Receives the number of programs loaded from the cache.
+ * @param misses Receives the number of programs that were compiled.
+ */
+PROJECTM_EXPORT void projectm_opengl_program_cache_stats(uint32_t* hits, uint32_t* misses);
+
+/**
+ * @brief During a soft-cut transition, renders the outgoing preset only every n-th frame.
+ *
+ * The outgoing preset fades out and its last frame is blended in between, so a divisor of 2 halves
+ * its cost with little visible difference. 1 (the default) renders it every frame.
+ *
+ * @param instance The projectM instance handle.
+ * @param divisor Render the outgoing preset every divisor-th frame, at least 1.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_outgoing_preset_frame_divisor(projectm_handle instance, uint32_t divisor);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
