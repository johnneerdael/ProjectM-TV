Subject: [PATCH] Reserve warp texture unit zero for the unqualified main sampler

The warp pass intentionally applies bTexWrap and linear filtering to unit zero.
Always bind implicit main there so explicitly named clamp/wrap/point samplers
are not replaced when their names sort before main. Composite sampler semantics
and unqualified main-only/default rendering remain unchanged.

--- a/src/libprojectM/MilkdropPreset/MilkdropShader.cpp
+++ b/src/libprojectM/MilkdropPreset/MilkdropShader.cpp
@@ -82,7 +82,16 @@
                                                     presetState.renderContext.textureManager->GetSampler(name),
                                                     name,
                                                     "main");
-            m_mainTextureDescriptors.push_back(std::move(desc));
+            // Unit zero is overridden by the warp pass with the preset's wrap setting.
+            // Reserve it for the unqualified main sampler; named modes keep their own samplers.
+            if (name == "main")
+            {
+                m_mainTextureDescriptors.insert(m_mainTextureDescriptors.begin(), std::move(desc));
+            }
+            else
+            {
+                m_mainTextureDescriptors.push_back(std::move(desc));
+            }
             continue;
         }
 
--- a/tests/libprojectM/CMakeLists.txt
+++ b/tests/libprojectM/CMakeLists.txt
@@ -4,6 +4,7 @@
         HLSLModuloTest.cpp
         ShaderExceptionTest.cpp
         ShaderFailureTest.cpp
+        WarpSamplerTest.cpp
         LineGeometryTest.cpp
         TexturePoolTest.cpp
         WaveformAlignerTest.cpp
--- /dev/null
+++ b/tests/libprojectM/WarpSamplerTest.cpp
@@ -0,0 +1,260 @@
+#include <ProjectM.hpp>
+#include <Renderer/Shader.hpp>
+#include <projectM-opengl.h>
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#ifdef __APPLE__
+#include <OpenGL/OpenGL.h>
+#endif
+
+namespace {
+
+constexpr int Width = 128;
+constexpr int Height = 96;
+using Image = std::vector<uint8_t>;
+
+class TestProjectM : public libprojectM::ProjectM
+{
+public:
+    mutable std::string failure;
+    void PresetSwitchFailedEvent(const std::string&, const std::string& reason) const override
+    {
+        failure = reason;
+    }
+};
+
+auto Sample(const std::string& name) -> std::string
+{
+    // Fractional texel offset tests filtering; the right edge tests clamp versus wrap.
+    return "tex2D(sampler_" + name + ", uv + float2(0.199, 0.004)).rgb";
+}
+
+auto Preset(const std::string& expression, bool wrap, bool composite) -> std::string
+{
+    const std::string seed = "float3(uv.x, frac(floor(uv.x*32)*0.5)*2, uv.y)";
+    std::string preset = "MILKDROP_PRESET_VERSION=201\nPSVERSION_WARP=3\nPSVERSION_COMP=3\n"
+                         "[preset00]\nfDecay=1\nfGammaAdj=1\nfWaveAlpha=0\n"
+                         "fWarpAnimSpeed=1\nfWarpScale=1\nfZoomExponent=1\n"
+                         "zoom=1\nwarp=0\nrot=0\nfVideoEchoAlpha=0\nfShader=0\nbTexWrap=";
+    preset += wrap ? "1\n" : "0\n";
+    if (composite)
+    {
+        preset += "warp_1=`shader_body { ret = " + seed + "; }\n";
+        preset += "comp_1=`shader_body { ret = " + expression + "; }\n";
+    }
+    else
+    {
+        // ProjectM numbers frames from zero. Frames 0 and 1 seed feedback; frame 2 samples it.
+        // No wall-clock delay, audio, random variables, or private engine state is needed.
+        preset += "warp_1=`shader_body { if (frame < 2) ret = " + seed +
+                  "; else ret = " + expression + "; }\n";
+    }
+    return preset;
+}
+
+void ExpectSame(const Image& a, const Image& b)
+{
+    ASSERT_EQ(a.size(), b.size());
+    size_t different{};
+    for (size_t i = 0; i < a.size(); ++i)
+    {
+        different += a[i] != b[i];
+    }
+    EXPECT_EQ(different, 0u) << "RGB bytes differ";
+}
+
+} // namespace
+
+class WarpSamplerTest : public ::testing::Test
+{
+protected:
+    // Keep one context across the suite: shared static shader owners can outlive individual engines.
+    static void SetUpTestSuite()
+    {
+#ifdef __APPLE__
+        CGLPixelFormatAttribute attributes[] = {
+            kCGLPFAOpenGLProfile, static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_3_2_Core),
+            static_cast<CGLPixelFormatAttribute>(0)};
+        CGLPixelFormatObj format{};
+        GLint count{};
+        if (CGLChoosePixelFormat(attributes, &format, &count) != kCGLNoError || format == nullptr)
+        {
+            return;
+        }
+        CGLCreateContext(format, nullptr, &s_context);
+        CGLDestroyPixelFormat(format);
+#endif
+    }
+
+    static void TearDownTestSuite()
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            CGLSetCurrentContext(nullptr);
+            CGLDestroyContext(s_context);
+            s_context = nullptr;
+        }
+#endif
+    }
+
+    void SetUp() override
+    {
+#ifdef __APPLE__
+        if (s_context == nullptr)
+        {
+            GTEST_SKIP() << "no macOS CGL OpenGL context";
+        }
+        ASSERT_EQ(CGLSetCurrentContext(s_context), kCGLNoError);
+        libprojectM::Renderer::Shader::Unbind();
+        glGenFramebuffers(1, &m_framebuffer);
+        glGenTextures(1, &m_texture);
+        glBindTexture(GL_TEXTURE_2D, m_texture);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, Width, Height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+        ASSERT_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        ASSERT_EQ(glGetError(), GL_NO_ERROR);
+#else
+        GTEST_SKIP() << "render regression needs a macOS CGL OpenGL context";
+#endif
+    }
+
+    void TearDown() override
+    {
+#ifdef __APPLE__
+        if (s_context != nullptr)
+        {
+            libprojectM::Renderer::Shader::Unbind();
+            glDeleteFramebuffers(1, &m_framebuffer);
+            glDeleteTextures(1, &m_texture);
+        }
+#endif
+    }
+
+    auto Render(const std::string& preset) -> Image
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, m_framebuffer);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        TestProjectM engine;
+        engine.SetWindowSize(Width, Height);
+        engine.SetMeshSize(48, 32);
+        engine.SetPresetLocked(true);
+        engine.SetHardCutEnabled(false);
+        engine.SetEasterEgg(0);
+        std::istringstream data(preset);
+        engine.LoadPresetData(data, false);
+        EXPECT_TRUE(engine.failure.empty()) << engine.failure;
+        for (int frame = 0; frame < 3; ++frame)
+        {
+            engine.RenderFrame(m_framebuffer);
+        }
+        Image pixels(Width * Height * 3);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glReadPixels(0, 0, Width, Height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(glGetError(), GL_NO_ERROR);
+        EXPECT_GT(*std::max_element(pixels.begin(), pixels.end()), 200) << "fixture did not render";
+        return pixels;
+    }
+
+#ifdef __APPLE__
+    static CGLContextObj s_context;
+#endif
+    GLuint m_framebuffer{};
+    GLuint m_texture{};
+};
+
+#ifdef __APPLE__
+CGLContextObj WarpSamplerTest::s_context{};
+#endif
+
+TEST_F(WarpSamplerTest, ExplicitModesIgnorePresetWrap)
+{
+    for (const char* name : {"fc_main", "cf_main", "fw_main", "wf_main",
+                             "pc_main", "cp_main", "pw_main", "wp_main"})
+    {
+        SCOPED_TRACE(name);
+        ExpectSame(Render(Preset(Sample(name), false, false)), Render(Preset(Sample(name), true, false)));
+    }
+}
+
+TEST_F(WarpSamplerTest, EquivalentAliasesHaveIdenticalFilteringAndWrapping)
+{
+    for (bool wrap : {false, true})
+    {
+        SCOPED_TRACE(wrap);
+        for (const auto& pair : {std::pair<const char*, const char*>{"fc_main", "cf_main"},
+                                 {"fw_main", "wf_main"}, {"pc_main", "cp_main"}, {"pw_main", "wp_main"}})
+        {
+            SCOPED_TRACE(pair.first);
+            ExpectSame(Render(Preset(Sample(pair.first), wrap, false)),
+                       Render(Preset(Sample(pair.second), wrap, false)));
+        }
+    }
+}
+
+TEST_F(WarpSamplerTest, UnqualifiedMainHonorsPresetWrap)
+{
+    const auto clamped = Render(Preset(Sample("main"), false, false));
+    const auto wrapped = Render(Preset(Sample("main"), true, false));
+    ExpectSame(clamped, Render(Preset(Sample("fc_main"), false, false)));
+    ExpectSame(wrapped, Render(Preset(Sample("wf_main"), true, false)));
+    EXPECT_NE(clamped, wrapped) << "fixture must expose wrap at the edge";
+    EXPECT_NE(Render(Preset(Sample("pc_main"), false, false)), clamped)
+        << "fixture must expose point versus linear filtering";
+}
+
+TEST_F(WarpSamplerTest, MixedMainAndExplicitClampMatchIndependentReferences)
+{
+    for (bool wrap : {false, true})
+    {
+        SCOPED_TRACE(wrap);
+        const auto main = Render(Preset(Sample("main"), wrap, false));
+        // Point/clamp lives after main; use linear/clamp with matching preset wrap as another reference.
+        const auto clamp = Render(Preset(Sample("fc_main"), false, false));
+        const auto mixed = Render(Preset("(" + Sample("main") + "+" + Sample("fc_main") + ")*0.5", wrap, false));
+        int maxDifference{};
+        for (size_t i = 0; i < mixed.size(); ++i)
+        {
+            maxDifference = std::max(maxDifference, std::abs(2 * static_cast<int>(mixed[i]) - main[i] - clamp[i]));
+        }
+        EXPECT_LE(maxDifference, 2) << "mixed image differs from the average by more than one byte";
+    }
+}
+
+TEST_F(WarpSamplerTest, CompositeModesIgnorePresetWrap)
+{
+    for (const char* name : {"fc_main", "cf_main", "fw_main", "wf_main",
+                             "pc_main", "cp_main", "pw_main", "wp_main"})
+    {
+        SCOPED_TRACE(name);
+        ExpectSame(Render(Preset(Sample(name), false, true)), Render(Preset(Sample(name), true, true)));
+    }
+}
+
+TEST_F(WarpSamplerTest, DefaultWarpMatchesUnqualifiedPassThrough)
+{
+    for (bool wrap : {false, true})
+    {
+        SCOPED_TRACE(wrap);
+        auto fixed = Preset(Sample("main"), wrap, false);
+        fixed.erase(fixed.find("warp_1="));
+        fixed.replace(fixed.find("PSVERSION_WARP=3"), 16, "PSVERSION_WARP=0");
+        fixed += "ob_size=0.05\nob_r=1\nob_g=0.25\nob_b=0\nob_a=1\n";
+        auto passThrough = fixed;
+        passThrough.replace(passThrough.find("PSVERSION_WARP=0"), 16, "PSVERSION_WARP=3");
+        passThrough += "warp_1=`shader_body { ret = tex2D(sampler_main, uv).rgb; }\n";
+        ExpectSame(Render(fixed), Render(passThrough));
+    }
+}
