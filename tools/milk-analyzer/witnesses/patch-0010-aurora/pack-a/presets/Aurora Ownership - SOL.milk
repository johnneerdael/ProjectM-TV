shapecode_2_border_a=0.16
shapecode_2_thickOutline=1
shape_2_per_frame1=rad=0.67+.10*q1;border_a=0.16+.10*q5;
shapecode_3_enabled=1
shapecode_3_sides=3
shapecode_3_additive=1
shapecode_3_textured=0
