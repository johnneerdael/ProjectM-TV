shapecode_3_r2=1
shapecode_3_g2=1
shapecode_3_b2=1
shapecode_3_a2=0.02
shapecode_3_border_a=0
shape_3_per_frame1=phase=instance*6.28318530718/12+q6;
shape_3_per_frame2=orb=.36+.04*q1;
shape_3_per_frame3=x=q11+.5625*orb*cos(phase);y=.5+orb*sin(phase);
shape_3_per_frame4=ang=phase+time*.2;rad=.022+.018*q5;a=.14+.22*q1;
wavecode_0_enabled=1
