wavecode_1_r=1.0
wavecode_1_g=0.4
wavecode_1_b=0.055
wavecode_1_a=0.3
wave_0_per_point1=phase=sample*12.56637061436+q6;
wave_0_per_point2=rr=.35+.025*sin(phase*5-time*1.2)+.05*q1+value1*.025;
wave_0_per_point3=x=q11+.5625*rr*cos(phase);y=.5+rr*sin(phase);
wave_0_per_point4=r=.80*q8+.20;g=.80*q9+.20;b=.80*q10+.20;
wave_0_per_point5=a=(.10+.15*q2+.10*q5)*(.4+.6*pow(.5+.5*sin(sample*197+time*1.4),2));
wave_1_per_point1=phase=sample*6.28318530718+time*.18;
wave_1_per_point2=rr=.265+.065*q1+min(.07,abs(value1)*.055);
wave_1_per_point3=x=q11+.5625*rr*cos(phase);y=.5+rr*sin(phase);
wave_1_per_point4=r=.65*q8+.35;g=.65*q9+.35;b=.65*q10+.35;a=.25+.12*q1;
warp_1=`shader_body {
warp_2=` float2 c=float2(q11,.5);
warp_3=` float2 p=(uv-c)/(1.002+.026*q1);
warp_4=` float angle=.003*sin(time*.55)+.018*q1;
warp_5=` float cs=cos(angle),sn=sin(angle);
warp_6=` float2 w=c+float2(p.x*cs-p.y*sn,p.x*sn+p.y*cs);
warp_7=` ret=GetPixel(w)*(.88-.045*min(q1,1.5));
warp_8=` float2 metric=(uv-c)*aspect.xy;
warp_9=` float box=max(abs(metric.x),abs(metric.y));
warp_10=` ret*=smoothstep(.195,.215,box);
warp_11=`}
comp_1=`shader_body {
comp_2=` float2 p=(uv-float2(q11,.5))*aspect.xy;
comp_3=` float radius=length(p);
comp_4=` float angle=atan2(p.y,p.x);
comp_5=` float rays=pow(saturate(.5+.5*sin(12*angle-time*.8+radius*8)),7);
comp_6=` float outside=1-smoothstep(.23,.5,radius);
comp_7=` float protect=smoothstep(.095,.145,radius);
comp_8=` float beam=rays*exp(-radius*7)*protect*(.03+.035*q1);
comp_9=` float ripple=pow(saturate(.5+.5*cos(radius*42-time*1.4)),6)*outside*protect*.025;
comp_10=` ret=GetPixel(uv)+float3(q8,q9,q10)*(beam+ripple);
comp_11=` ret+=GetBlur1(uv)*(.045+.035*q1)*protect;
comp_12=` float drift_a=.5+.13*sin(uv.x*9+time*.28);
comp_13=` float drift_b=.53+.17*cos(uv.x*6-time*.21);
comp_14=` float mist_a=exp(-pow((uv.y-drift_a)*15,2));
comp_15=` float mist_b=exp(-pow((uv.y-drift_b)*20,2));
comp_16=` ret+=float3(q8,q9,q10)*(mist_a*.026+mist_b*.018)*(.6+.25*q2+.15*q1)*smoothstep(.12,.23,radius);
comp_17=` float stars=saturate((cos(uv.x*181+sin(uv.y*67+time*.08))*cos(uv.y*163+sin(uv.x*77-time*.06))-.96)*14);
comp_18=` ret+=(.12+float3(q8,q9,q10)*.45)*pow(stars,3)*(.8+.2*sin(time*.8+uv.x*10))*protect;
comp_19=` ret=pow(saturate(ret),float3(.92,.92,.92));
comp_20=` ret*=.83+.17*(1-smoothstep(.35,.80,length((uv-.5)*aspect.xy)));
comp_21=`}
