shapecode_0_g2=1
shapecode_0_b2=1
shapecode_0_a2=1
shapecode_0_border_a=0
shapecode_0_image=aurora_ownership_core
shape_0_per_frame1=rad=.74+.12*q1;ang=.04*sin(time*.5);
