{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectM TV structured source appearance v1",
  "description": "Documentation shape schema. Hashes, source/context support and reconstruction readiness require producer/consumer checks. Not a calibrated image or mood predictor.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "policy",
        "status",
        "elements",
        "activity",
        "mood_matches",
        "record_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "policy": {
          "const": "source-appearance-and-control-traits-v1"
        },
        "status": {
          "const": "conditional source description"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "stage",
              "family_codes",
              "mechanisms",
              "parameters",
              "colour",
              "audio_routes",
              "conditions",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "stage": {
                "enum": [
                  "warp",
                  "composite",
                  "drawing",
                  "mesh_warp"
                ]
              },
              "family_codes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "parameters": {
                "type": "object"
              },
              "colour": {
                "type": "object",
                "properties": {
                  "mode_code": {
                    "enum": [
                      null,
                      0,
                      1,
                      2,
                      3,
                      4,
                      5
                    ]
                  },
                  "palette_diversity": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "distinct_channel_phases": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "depends_on_time": {
                    "enum": [
                      null,
                      0,
                      1
                    ]
                  },
                  "constant_rgb": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "bias_rgb": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "amplitude_rgb": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "phase_offsets_rad": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "tint_rgb": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "channel_phase_expressions": {
                    "type": "array",
                    "items": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "required": [
                        "root",
                        "nodes",
                        "complete",
                        "resources_resolved"
                      ],
                      "properties": {
                        "root": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nodes": {
                          "type": "array",
                          "maxItems": 256,
                          "items": {
                            "type": "object",
                            "required": [
                              "op",
                              "dtype",
                              "args",
                              "detail"
                            ],
                            "properties": {
                              "op": {
                                "type": "string"
                              },
                              "dtype": {
                                "type": "string"
                              },
                              "args": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              },
                              "detail": {
                                "type": "object"
                              }
                            }
                          }
                        },
                        "complete": {
                          "type": "boolean"
                        },
                        "resources_resolved": {
                          "type": "boolean"
                        }
                      }
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "temporal": {
                    "type": "object",
                    "required": [
                      "policy",
                      "scope",
                      "angular_rate_rad_per_second_rgb",
                      "cycle_frequency_hz_rgb",
                      "period_seconds_rgb",
                      "unmasked_component_slope_rgb_per_second",
                      "channel_status",
                      "shader_time_wrap_seconds",
                      "visible_flash_frequency_hz",
                      "conditions",
                      "unknown_reasons_rgb"
                    ],
                    "properties": {
                      "policy": {
                        "const": "nominal-affine-shader-time-v1"
                      },
                      "scope": {
                        "const": "unmasked source RGB oscillators between shader-clock wraps"
                      },
                      "angular_rate_rad_per_second_rgb": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "cycle_frequency_hz_rgb": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "period_seconds_rgb": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "unmasked_component_slope_rgb_per_second": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "channel_status": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "enum": [
                            "computed",
                            "constant",
                            "unknown"
                          ]
                        }
                      },
                      "shader_time_wrap_seconds": {
                        "const": 10000
                      },
                      "visible_flash_frequency_hz": {
                        "type": "null"
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "unknown_reasons_rgb": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "audio_routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "input_code",
                    "control",
                    "control_unit",
                    "linear_gain",
                    "expression",
                    "visible_response_strength",
                    "q_bridge_expressions"
                  ],
                  "properties": {
                    "input_code": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    },
                    "control": {
                      "type": "string"
                    },
                    "control_unit": {
                      "type": "string"
                    },
                    "linear_gain": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "visible_response_strength": {
                      "type": "null"
                    },
                    "expression": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "required": [
                        "root",
                        "nodes",
                        "complete",
                        "resources_resolved"
                      ],
                      "properties": {
                        "root": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nodes": {
                          "type": "array",
                          "maxItems": 256,
                          "items": {
                            "type": "object",
                            "required": [
                              "op",
                              "dtype",
                              "args",
                              "detail"
                            ],
                            "properties": {
                              "op": {
                                "type": "string"
                              },
                              "dtype": {
                                "type": "string"
                              },
                              "args": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              },
                              "detail": {
                                "type": "object"
                              }
                            }
                          }
                        },
                        "complete": {
                          "type": "boolean"
                        },
                        "resources_resolved": {
                          "type": "boolean"
                        }
                      }
                    },
                    "q_bridge_expressions": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "required": [
                          "root",
                          "nodes",
                          "complete",
                          "resources_resolved"
                        ],
                        "properties": {
                          "root": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "nodes": {
                            "type": "array",
                            "maxItems": 256,
                            "items": {
                              "type": "object",
                              "required": [
                                "op",
                                "dtype",
                                "args",
                                "detail"
                              ],
                              "properties": {
                                "op": {
                                  "type": "string"
                                },
                                "dtype": {
                                  "type": "string"
                                },
                                "args": {
                                  "type": "array",
                                  "items": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "detail": {
                                  "type": "object"
                                }
                              }
                            }
                          },
                          "complete": {
                            "type": "boolean"
                          },
                          "resources_resolved": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "has_threshold_or_clamp": {
                      "type": "boolean"
                    },
                    "switch_triggers": {
                      "type": "array",
                      "description": "Contributing direct-band comparison sites; empty does not prove no flashing.",
                      "items": {
                        "type": "object",
                        "required": [
                          "policy",
                          "input_code",
                          "comparison",
                          "threshold_value",
                          "threshold_expression",
                          "control_true_value",
                          "control_false_value",
                          "absolute_control_jump",
                          "scope",
                          "trigger_frequency_hz",
                          "source_graph_path",
                          "conditions",
                          "limitations"
                        ],
                        "properties": {
                          "policy": {
                            "const": "direct-band-switch-sites-v1"
                          },
                          "input_code": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 8
                          },
                          "comparison": {
                            "enum": [
                              "greater",
                              "less",
                              "greater_equal",
                              "less_equal"
                            ]
                          },
                          "threshold_value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "threshold_expression": {
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "control_true_value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "control_false_value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "absolute_control_jump": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "scope": {
                            "type": "string"
                          },
                          "trigger_frequency_hz": {
                            "type": "null"
                          },
                          "source_graph_path": {
                            "type": "string"
                          },
                          "conditions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "limitations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "geometry": {
                "type": "object",
                "required": [
                  "policy",
                  "status",
                  "radius_ndc",
                  "effective_sides",
                  "configured_instances",
                  "nominal_area_fraction_per_aspect_y",
                  "summed_nominal_area_fraction_per_aspect_y",
                  "circumcircle_width_fraction_per_aspect_y",
                  "circumcircle_height_fraction",
                  "center_source_xy",
                  "aspect_y_formula",
                  "visible_coverage_fraction",
                  "unknown_reasons",
                  "conditions"
                ],
                "properties": {
                  "policy": {
                    "const": "source-custom-shape-footprint-v1"
                  },
                  "status": {
                    "enum": [
                      "conditional nominal geometry",
                      "unknown geometry"
                    ]
                  },
                  "radius_ndc": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "effective_sides": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 3,
                    "maximum": 100
                  },
                  "configured_instances": {
                    "type": "integer"
                  },
                  "nominal_area_fraction_per_aspect_y": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "summed_nominal_area_fraction_per_aspect_y": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "circumcircle_width_fraction_per_aspect_y": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "circumcircle_height_fraction": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "center_source_xy": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "aspect_y_formula": {
                    "const": "min(1, viewport_height / viewport_width)"
                  },
                  "visible_coverage_fraction": {
                    "type": "null"
                  },
                  "conditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unknown_reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "motion_controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "policy",
                    "control",
                    "control_unit",
                    "application",
                    "curve_kind",
                    "maximum_absolute_control_rate_per_second",
                    "visible_motion_speed",
                    "conditions",
                    "unknown_reasons"
                  ],
                  "properties": {
                    "policy": {
                      "const": "source-time-control-curves-v1"
                    },
                    "control": {
                      "type": "string"
                    },
                    "control_unit": {
                      "type": "string"
                    },
                    "application": {
                      "enum": [
                        "shape geometry parameter",
                        "feedback sampling transform each step"
                      ]
                    },
                    "curve_kind": {
                      "enum": [
                        "constant",
                        "linear_time",
                        "sinusoidal_time",
                        "unknown"
                      ]
                    },
                    "constant_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "offset_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "amplitude_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "oscillator_function_code": {
                      "enum": [
                        null,
                        1,
                        2
                      ]
                    },
                    "phase_expression": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "angular_phase_rate_rad_per_second": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "period_seconds": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "frequency_hz": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "nominal_value_range": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "signed_linear_rate_per_second": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "maximum_absolute_control_rate_per_second": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "rate_unit": {
                      "type": "string"
                    },
                    "expression": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "visible_motion_speed": {
                      "type": "null"
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "unknown_reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "appearance_match_accuracy": {
          "type": "null"
        },
        "uses_rendered_images": {
          "const": false
        },
        "uses_shader_execution": {
          "const": false
        },
        "uses_equation_execution": {
          "const": false
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "composition": {
          "type": "object",
          "required": [
            "policy",
            "render_context_resolved",
            "normal_feedback_flow",
            "normal_display_flow",
            "configured_drawing_order",
            "display_elements",
            "shader_sample_reads",
            "stage_read_status",
            "feedback_detail_path",
            "warp_discard_or_incomplete_write",
            "composite_feedback_influence",
            "conditions",
            "unknown_reasons"
          ],
          "properties": {
            "policy": {
              "const": "source-logical-composition-v1"
            },
            "render_context_resolved": {
              "const": false
            },
            "normal_feedback_flow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "normal_display_flow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "configured_drawing_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "display_elements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "shader_sample_reads": {
              "type": "object",
              "properties": {
                "warp": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_age": {
                        "type": "null"
                      },
                      "coordinate_expression": {
                        "type": [
                          "object",
                          "null"
                        ]
                      },
                      "source_role": {
                        "type": "string"
                      }
                    }
                  }
                },
                "composite": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_age": {
                        "type": "null"
                      },
                      "coordinate_expression": {
                        "type": [
                          "object",
                          "null"
                        ]
                      },
                      "source_role": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "stage_read_status": {
              "type": "object"
            },
            "feedback_detail_path": {
              "const": "conditional_on_render_context"
            },
            "warp_discard_or_incomplete_write": {
              "type": "string"
            },
            "composite_feedback_influence": {
              "const": "normally_display_only_but_stale_pixels_may_feed_back"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknown_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "unknown_reasons"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "unknown"
        },
        "unknown_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
