<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.projectm.visualizer.VisualizerView
        android:id="@+id/visualizer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Settings panel: compact card inside the overscan-safe area -->
    <LinearLayout
        android:id="@+id/overlay_menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Now playing -->
        <TextView
            style="@style/Overlay.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Now playing" />

        <TextView
            android:id="@+id/preset_name"
            style="@style/Overlay.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Loading…" />

        <TextView
            android:id="@+id/preset_meta"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="" />

        <!-- Transport -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev_preset_button"
                style="@style/Overlay.IconButton"
                android:contentDescription="Previous preset"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/random_preset_button"
                style="@style/Overlay.IconButton"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="Random preset"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/next_preset_button"
                style="@style/Overlay.IconButton"
                android:contentDescription="Next preset"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/divider" />

        <!-- Settings -->
        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_auto_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_preset_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_transition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_frame_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_skipped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/divider" />

        <!-- Status: fixed width so frequent text updates do not trigger relayouts -->
        <TextView
            android:id="@+id/status_line"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:text="" />

        <TextView
            android:id="@+id/version_info"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp"
            android:text="" />

        <TextView
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:text="↑↓ select   ‹ › change   BACK close" />
    </LinearLayout>

    <!-- Now-playing pill, shown briefly when a preset starts -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:alpha="0"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_music_note"
            android:tint="@color/accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/now_playing_text"
            style="@style/Overlay.Marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
